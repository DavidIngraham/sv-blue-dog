// view: BlueDogViews::requirements
// kind: requirement
// stated: view def GeneralView, filter @RequirementUsage
// not represented: 2 exposed standard library element(s) not drawn; a requirement rendering draws the model's own elements
// layout: dot
digraph "BlueDogViews::requirements" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>roundTrip : RoundTrip</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>multiDayEndurance : MultiDayEndurance</b>>];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>energyAwareness : EnergyAwareness</b>>];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>navigationAndControl : NavigationAndControl</b>>];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>resetRecovery : ResetRecovery</b>>];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>lowEnergyRecovery : LowEnergyRecovery</b>>];
  "n6" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>communications : Communications</b>>];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>ingressResponse : IngressResponse</b>>];
  "n8" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>missionEvidence : MissionEvidence</b>>];
  "n3" -> "n0" [label="derive", arrowhead=vee, style=dashed];
  "n4" -> "n0" [label="derive", arrowhead=vee, style=dashed];
  "n6" -> "n0" [label="derive", arrowhead=vee, style=dashed];
  "n7" -> "n0" [label="derive", arrowhead=vee, style=dashed];
  "n8" -> "n0" [label="derive", arrowhead=vee, style=dashed];
  "n2" -> "n1" [label="derive", arrowhead=vee, style=dashed];
  "n5" -> "n1" [label="derive", arrowhead=vee, style=dashed];
  "n5" -> "n2" [label="derive", arrowhead=vee, style=dashed];
}
