// view: BlueDogArchitectureViews::architecture
// kind: interconnection
// stated: render Views::asInterconnectionDiagram
// layout: dot
digraph "BlueDogArchitectureViews::architecture" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_n0" {
    label=<<font point-size="10"><i>«part def»</i></font><br/><b>Boat</b>>;
    color=black;
    penwidth=0.5;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    "n1" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>hullAndRig : HullAndRig</b>>];
    "n2" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>energy : EnergySubsystem</b>>];
    "n3" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>navigation : NavigationAndSensing</b>>];
    "n4" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>control : GuidanceAndControl</b>>];
    "n5" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>actuation : SailAndSteeringActuation</b>>];
    "n6" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>communications : Communications</b>>];
    "n7" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>recovery : HealthAndRecovery</b>>];
    "n8" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>recording : DataRecording</b>>];
    "n9" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>observationPayload : ObservationPayload</b>>];
  }
}
