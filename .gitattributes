* text=auto
*.md text eol=lf
*.SLDPRT binary
*.SLDASM binary
*.3mf binary
*.STEP -text
*.igs -text

*.sysml text eol=lf
*.py text eol=lf
*.json text eol=lf
*.lock text eol=lf

# Archived evidence is byte-preserved; hashes include original line endings.
evidence/runs/**/*.json -text whitespace=cr-at-eol

# Saved native geometry is evidence; preserve exact bytes.
evidence/vsp-geometry/*.vsp3 -text
