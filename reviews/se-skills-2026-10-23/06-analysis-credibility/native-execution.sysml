    allocation safetyToRecoveryRecoveryInternal : IC01InternalExchange allocate vessel.safetyToRecovery to ic01.recoveryController {
        attribute :>> path = ImplementationPath::recovery;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation reserveToSupervisorPrimaryInternal : IC01InternalExchange allocate vessel.reserveToSupervisor to ic01.primaryController {
        attribute :>> path = ImplementationPath::primary;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation reserveToSupervisorRecoveryInternal : IC01InternalExchange allocate vessel.reserveToSupervisor to ic01.recoveryController {
        attribute :>> path = ImplementationPath::recovery;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation reserveToRecoveryRecoveryInternal : IC01InternalExchange allocate vessel.reserveToRecovery to ic01.recoveryController {
        attribute :>> path = ImplementationPath::recovery;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation trafficToSupervisorPrimaryInternal : IC01InternalExchange allocate vessel.trafficToSupervisor to ic01.primaryController {
        attribute :>> path = ImplementationPath::primary;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation trafficToSupervisorRecoveryInternal : IC01InternalExchange allocate vessel.trafficToSupervisor to ic01.recoveryController {
        attribute :>> path = ImplementationPath::recovery;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation boundaryToSupervisorPrimaryInternal : IC01InternalExchange allocate vessel.boundaryToSupervisor to ic01.primaryController {
        attribute :>> path = ImplementationPath::primary;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation boundaryToSupervisorRecoveryInternal : IC01InternalExchange allocate vessel.boundaryToSupervisor to ic01.recoveryController {
        attribute :>> path = ImplementationPath::recovery;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation boundaryToGuidancePrimaryInternal : IC01InternalExchange allocate vessel.boundaryToGuidance to ic01.primaryController {
        attribute :>> path = ImplementationPath::primary;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation permissionsToGuidancePrimaryInternal : IC01InternalExchange allocate vessel.permissionsToGuidance to ic01.primaryController {
        attribute :>> path = ImplementationPath::primary;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation permissionsToRecoveryRecoveryInternal : IC01InternalExchange allocate vessel.permissionsToRecovery to ic01.recoveryController {
        attribute :>> path = ImplementationPath::recovery;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
    allocation boundaryToRecoveryRecoveryInternal : IC01InternalExchange allocate vessel.boundaryToRecovery to ic01.recoveryController {
        attribute :>> path = ImplementationPath::recovery;
        attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
    }
}

package BlueDog {
    doc /* Working architecture model, 2026-10-09.
     * Confirmed threshold: Bingen-Stevenson-Bingen round trip.
     * Repeated operation is a future endurance objective, outside current acceptance.
     * Qualifying round trips require no operator intervention; live monitoring is required.
     * Current design driver: one finite GorgeChallenge::transGorgeChallenge round trip.
     * Goals::hawaiiVoyage is a separate future mission with its own constraints.
     * Multi-day endurance with energy harvesting remains an earlier intent. SysML v2 learning is a project goal.
     * Decomposition identifies responsibilities; physical design remains open.
     * Tool checks are recorded in the modeling guide; design satisfaction links
     * are maintained separately and do not establish verification.
     */

    private import GorgeChallenge::*;
    private import OOSEM::*;

    package DesignIntent {
        doc /* Owner-imposed project constraints: one-person transport, construction on a
         * 250 mm cubic desktop printer, and serviceability between deployments. These
         * remain binding alongside the finite Gorge mission, not consequences of sailing success.
         */
    }

    package Goals {
        requirement def <'H-001'> HawaiiVoyage {
            metadata applicability : BlueDogMissionScope::Applicability { mission = BlueDogMissionScope::MissionKind::futureOcean; }
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall complete an autonomous sailing voyage to Hawaii. */
            comment notes /* Gorge-specific challenge rules do not automatically apply to the ocean mission. */
            metadata rationale : ModelingMetadata::Rationale { text = "The Gorge is a proving ground for the ocean objective, not evidence of ocean readiness."; }
            metadata issue : ModelingMetadata::Issue { text = "Departure point, destination gate, route, duration, route/season suitability of the candidate ocean envelope, assistance/propulsion rules and acceptance evidence remain to be agreed."; }
        }
        requirement hawaiiVoyage : HawaiiVoyage;
    }

    package Mission {
        action def HawaiiMission {
            doc /* Mission decomposition supporting Goals::hawaiiVoyage.
             * This is not an executable sequence or a verified mission plan.
             * Route, landfall, endurance, and recovery criteria remain open.
             */
            action prepareAndLaunch;
            action sailOceanPassage;
            action approachDestination;
            action recoverBoatAndData;
            action manageEnergy;
            action monitorHealthAndRecover;
            action communicateWithOperator;
            action recordMissionData;
        }
        action def TransGorgeMission {
            doc /* Activity decomposition, not execution order.
             * TransGorgeCourse defines marker-referenced gates, subject to course release review.
             * The finite challenge has no completion deadline. GorgeChallenge defines
             * monitoring and recovery obligations; environmental allocations and
             * real recovery sites remain subject to review.
             * No operator intervention is permitted during a qualifying round trip.
             */
            action prepareAndLaunch;
            action sailOutbound;
            action turnAround;
            action sailHome;
            action recoverBoatAndData;
            action manageEnergy;
            action monitorHealthAndRecover;
            action communicateWithOperator;
            action recordMissionData;
        }
        action def SwellMonitoringMission {
            doc /* Stretch mission, not required for the initial round trip.
             * Station-keeping area, measurement products, and accuracy TBD.
             */
            action reachObservationArea;
            action maintainObservationArea;
            action measureAndRecordConditions;
            action returnForRecovery;
        }
    }

    package Architecture {
        doc /* System responsibility and external-context description. Boat is
         * not an installed assembly. BlueDogArchitectureCorrespondence maps its
         * responsibilities to LogicalVessel; IC01Candidate owns the provisional
         * equipment composition. HullAndRig remains a shared hardware concept. */
        #user part def Operator;
        part def MonitoringStation;
        #externalSystem part def ShoreSupport {
            part monitoringStation : MonitoringStation;
        }
        #environment part def Environment;
        #externalSystem part def OtherVessel {
            doc /* External traffic, including commercial ships, barges, fishing and recreational craft, with or without AIS. Behavior and cooperation are outside Blue Dog control. */
        }
        #hardware part def PrintedHull;
        #hardware part def SealedEnclosure;
        #hardware part def KeelAndBallast;
        #hardware part def HandlingInterfaces;
        part def RigConcept {
            doc /* Soft sail, tail-controlled rigid wing and directly rotated
             * fixed-camber wing retain equal development standing. No selected
             * rig or physical demonstration is implied by this responsibility. */
        }
        part def HullAndRig {
            part rig : RigConcept;
            part printedHull : PrintedHull;
            part enclosure : SealedEnclosure;
            part keelAndBallast : KeelAndBallast;
            part handling : HandlingInterfaces;
        }
        part def EnergyStorage;
        part def HarvestingInterface;
        part def PowerManagement;
        part def EnergySubsystem {
            part storage : EnergyStorage;
            part harvesting : HarvestingInterface;
            part powerManagement : PowerManagement;
        }
        part def PositionAndAttitude;
        part def WindSensing;
        part def TrafficSensing;
        part def NavigationAndSensing {
            part positionAndAttitude : PositionAndAttitude;
            part wind : WindSensing;
            part traffic : TrafficSensing;
        }
        part def MissionManager;
        part def CollisionAvoidance;
        part def BoundarySupervisor;
        part def GuidanceAndControl {
            part missionManager : MissionManager;
            part collisionAvoidance : CollisionAvoidance;
            part boundarySupervisor : BoundarySupervisor;
        }
        part def SailAndSteeringActuation;
        part def TelemetryRadio;
        part def AntennaSystem;
        part def CommandGateway;
        part def Communications {
            part telemetryRadio : TelemetryRadio;
            part antenna : AntennaSystem;
            part commandGateway : CommandGateway;
        }
        part def RecoveryPropulsion;
        part def RecoveryController;
        part def IngressMonitor;
        part def HealthAndRecovery {
            part motorSystem : RecoveryPropulsion;
            part recoveryController : RecoveryController;
            part ingressMonitor : IngressMonitor;
        }
        part def NavigationSignaling;
        part def DataRecording;
        part def ObservationPayload;

        #system part def Boat {
            doc /* System responsibility breakdown with identified hardware concepts.
             * Candidate architecture for the finite Gorge challenge. Future missions require separate allocation.
             * BlueDogLogicalArchitecture defines implementation-independent exchanges.
             * BlueDogPhysicalArchitecture describes a provisional IC-01 realization;
             * neither this responsibility tree nor that candidate establishes hardware qualification.
             */
            part hullAndRig : HullAndRig;
            part energy : EnergySubsystem;
            part navigation : NavigationAndSensing;
            part control : GuidanceAndControl;
            part actuation : SailAndSteeringActuation;
            part communications : Communications;
            part recovery : HealthAndRecovery;
            part recording : DataRecording;
            part signaling : NavigationSignaling;
            part observationPayload : ObservationPayload [0..1];
        }
        #systemContext part def MissionContext {
            part boat : Boat :>> systemOfInterest;
            part operator : Operator :>> users;
            part shoreSupport : ShoreSupport :> externalSystems;
            part :>> environment : Environment;
            part traffic : OtherVessel [0..*] :> externalSystems;
        }
        part missionContext : MissionContext;
    }

}

package BlueDogLogicalArchitecture {
    private import OOSEM::*;
    private import ScalarValues::*;
    doc /* Implementation-independent responsibilities and information exchanges.
     * Ports describe information contracts, not buses, processors or installed
     * equipment. Native scenario allocations identify who performs each action.
     * Candidate realization is separate in BlueDogPhysicalArchitecture. */

    #ioEntity item def NavigationEstimate {
        attribute coordinateReference : String;
        attribute headingReference : String;
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute valid : Boolean;
        attribute observedAt : ISQ::TimeValue;
        attribute latitude : ISQ::AngularMeasureValue;
        attribute longitude : ISQ::AngularMeasureValue;
        attribute heading : ISQ::AngularMeasureValue;
    }
    #ioEntity item def SafetyObservation {
        attribute valid : ScalarValues::Boolean;
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute capsized : Boolean;
        attribute uprightControlRestored : Boolean;
        attribute requiredSafetyConfirmed : Boolean;
        attribute observedAt : ISQ::TimeValue;
        doc /* Confirmation covers currently required navigation, collision
         * assessment, boundary awareness, energy and recovery capabilities.
         * A primary failure is distinct from loss of the required capability.
         * Confirmation while inverted or using backup equipment requires explicit
         * evidence; absence of that observation cannot establish safe continuation. */
    }
    #ioEntity item def ReserveAssessment {
        attribute observedAt : ISQ::TimeValue;
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute usableEnergy : ISQ::EnergyValue;
        attribute protectedReserve : ISQ::EnergyValue;
        attribute threatened : Boolean;
        attribute valid : Boolean;
    }
    #ioEntity item def TrafficAssessment {
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute conflict : Boolean;
        attribute valid : Boolean;
        attribute observedAt : ISQ::TimeValue;
    }
    #ioEntity item def BoundaryAssessment {
        attribute observedAt : ISQ::TimeValue;
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute insidePermittedArea : Boolean;
        attribute avoidanceRequired : Boolean;
        attribute valid : Boolean;
        doc /* Evaluated against the configured water domain, exclusions and
         * current navigation observation; this is not a surveyed-site approval. */
    }
    #ioEntity item def TrafficTrack {
        attribute bearingReference : String;
        attribute rangeReference : String;
        attribute headingReference : String;
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute identity : String;
        attribute observedAt : ISQ::TimeValue;
        attribute bearing : ISQ::AngularMeasureValue;
        attribute range : ISQ::LengthValue;
        attribute speed : ISQ::SpeedValue;
        attribute heading : ISQ::AngularMeasureValue;
        attribute valid : Boolean;
        doc /* A tracked contact may come from AIS or non-cooperative sensing.
         * Declared observation validity does not establish detection coverage. */
    }
    #ioEntity item def TrafficObservation {
        attribute valid : ScalarValues::Boolean;
        attribute observedAt : ISQ::TimeValue;
        item context : BlueDogInterfaceContracts::ObservationContext;
        item tracks : TrafficTrack [0..*];
        attribute coverageConfirmed : Boolean;
    }
    #ioEntity item def OperationPermission {
        item context : BlueDogInterfaceContracts::CommandContext;
        attribute sailingPermitted : Boolean;
        attribute gateScoringPermitted : Boolean;
        attribute harvestPermitted : Boolean;
        attribute abortLatched : Boolean;
        attribute qualificationLost : Boolean;
    }
    #ioEntity item def RecoveryCommand {
        item context : BlueDogInterfaceContracts::CommandContext;
        attribute recoveryRequested : Boolean;
        attribute propulsionPermitted : Boolean;
        doc /* Powered recovery follows qualification loss. This command does
         * not assert shore reachability or available independent hardware. */
    }
    #ioEntity item def MissionRecord {
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute eventKind : String;
        attribute observedAt : ISQ::TimeValue;
        attribute qualificationLost : Boolean;
        attribute abortLatched : Boolean;
    }
    port def NavigationOutput { out item estimate : NavigationEstimate; }
    port def NavigationInput { in item estimate : NavigationEstimate; }
    port def WindOutput { out item estimate : BlueDogMethod::WindEstimate; }
    port def WindInput { in item estimate : BlueDogMethod::WindEstimate; }
    port def LinkOutput { out item observation : BlueDogMethod::LinkObservation; }
    port def LinkInput { in item observation : BlueDogMethod::LinkObservation; }
    port def SafetyOutput { out item observation : SafetyObservation; }
    port def SafetyInput { in item observation : SafetyObservation; }
    port def ReserveOutput { out item assessment : ReserveAssessment; }
    port def ReserveInput { in item assessment : ReserveAssessment; }
    port def TrafficOutput { out item assessment : TrafficAssessment; }
    port def TrafficInput { in item assessment : TrafficAssessment; }
    port def BoundaryOutput { out item assessment : BoundaryAssessment; }
    port def BoundaryInput { in item assessment : BoundaryAssessment; }
    port def TracksOutput { out item observation : TrafficObservation; }
    port def TracksInput { in item observation : TrafficObservation; }
    port def PermissionOutput { out item permission : OperationPermission; }
    port def PermissionInput { in item permission : OperationPermission; }
    port def CommandOutput { out item command : BlueDogMethod::SailingCommand; }
    port def CommandInput { in item command : BlueDogMethod::SailingCommand; }
    port def RecordOutput { out item record : MissionRecord; }
    port def RecordInput { in item record : MissionRecord; }
    port def RecoveryOutput { out item command : RecoveryCommand; }
    port def RecoveryInput { in item command : RecoveryCommand; }

    #logical part def NavigationEstimation { port navigation : NavigationOutput; }
    #logical part def WindEstimation { port wind : WindOutput; }
    #logical part def SafetyAssessment { port safety : SafetyOutput; }
    #logical part def EnergyManagement { port reserve : ReserveOutput; }
    #logical part def TrafficObservationService { port tracks : TracksOutput; }
    #logical part def CollisionAssessment {
        port tracks : TracksInput;
        port navigation : NavigationInput;
        port traffic : TrafficOutput;
    }
    #logical part def BoundaryManagement {
        port navigation : NavigationInput;
        port boundary : BoundaryOutput;
    }
    #logical part def MissionSupervision {
        port navigation : NavigationInput;
        port wind : WindInput;
        port link : LinkInput;
        port safety : SafetyInput;
        port reserve : ReserveInput;
        port traffic : TrafficInput;
        port boundary : BoundaryInput;
        port permissions : PermissionOutput;
        port events : RecordOutput;
    }
    #logical part def Guidance {
        port navigation : NavigationInput;
        port wind : WindInput;
        port boundary : BoundaryInput;
        port permissions : PermissionInput;
        port commands : CommandOutput;
    }
    #logical part def SailingActuation {
        port commands : CommandInput;
        port permissions : PermissionInput;
    }
    #logical part def RecoveryManagement {
        doc /* Select and reassess a reachable shore plan and command recovery.
         * Navigation, traffic, boundary and reserve assessments are explicit
         * inputs. Thrust execution belongs to RecoveryActuation; shore capture
         * and operator pickup remain separate physical/procedural obligations. */
        port navigation : NavigationInput;
        port tracks : TracksInput;
        port boundary : BoundaryInput;
        port events : RecordOutput;
        port safety : SafetyInput;
        port reserve : ReserveInput;
        port permissions : PermissionInput;
        port commands : RecoveryOutput;
    }
    #logical part def RecoveryActuation {
        port commands : RecoveryInput;
        doc /* Execute permitted recovery propulsion. A command is not evidence
         * of achieved thrust, inverted operation, shore arrival or retention. */
    }
    #logical part def Recording {
        port events : RecordInput;
        port retained : RecordOutput;
    }
    #logical part def Communications {
        port events : RecordInput;
        port retained : RecordInput;
        port status : LinkOutput;
    }
    part def LogicalVessel {
        part navigation : NavigationEstimation;
        part wind : WindEstimation;
        part safety : SafetyAssessment;
        part energy : EnergyManagement;
        part collision : CollisionAssessment;
        part boundary : BoundaryManagement;
        part trafficObservation : TrafficObservationService;
        part supervision : MissionSupervision;
        part guidance : Guidance;
        part actuation : SailingActuation;
        part recovery : RecoveryManagement;
        part recoveryActuation : RecoveryActuation;
        part recording : Recording;
        part communications : Communications;
        flow navigationToSupervisor from navigation.navigation.estimate to supervision.navigation.estimate;
        flow navigationToGuidance from navigation.navigation.estimate to guidance.navigation.estimate;
        flow windToGuidance from wind.wind.estimate to guidance.wind.estimate;
        flow windToSupervisor from wind.wind.estimate to supervision.wind.estimate;
        flow linkToSupervisor from communications.status.observation to supervision.link.observation;
        flow safetyToSupervisor from safety.safety.observation to supervision.safety.observation;
        flow safetyToRecovery from safety.safety.observation to recovery.safety.observation;
        flow reserveToSupervisor from energy.reserve.assessment to supervision.reserve.assessment;
        flow reserveToRecovery from energy.reserve.assessment to recovery.reserve.assessment;
        flow trafficToSupervisor from collision.traffic.assessment to supervision.traffic.assessment;
        flow tracksToCollision from trafficObservation.tracks.observation to collision.tracks.observation;
        flow navigationToCollision from navigation.navigation.estimate to collision.navigation.estimate;
        flow navigationToBoundary from navigation.navigation.estimate to boundary.navigation.estimate;
        flow boundaryToSupervisor from boundary.boundary.assessment to supervision.boundary.assessment;
        flow boundaryToGuidance from boundary.boundary.assessment to guidance.boundary.assessment;
        flow permissionsToGuidance from supervision.permissions.permission to guidance.permissions.permission;
        flow permissionsToActuation from supervision.permissions.permission to actuation.permissions.permission;
        flow permissionsToRecovery from supervision.permissions.permission to recovery.permissions.permission;
        flow sailingCommands from guidance.commands.command to actuation.commands.command;
        flow supervisorRecords from supervision.events.record to recording.events.record;
        flow supervisorTelemetry from supervision.events.record to communications.events.record;
        flow navigationToRecovery from navigation.navigation.estimate to recovery.navigation.estimate;
        flow tracksToRecovery from trafficObservation.tracks.observation to recovery.tracks.observation;
        flow boundaryToRecovery from boundary.boundary.assessment to recovery.boundary.assessment;
        flow recoveryCommands from recovery.commands.command to recoveryActuation.commands.command;
        flow recoveryRecords from recovery.events.record to recording.events.record;
        flow recoveryTelemetry from recovery.events.record to communications.events.record;
        flow retainedRecordsToCommunications from recording.retained.record to communications.retained.record;
    }
    part vessel : LogicalVessel;
}

package BlueDogPhysicalArchitecture {
    private import OOSEM::*;
    private import ScalarValues::*;
    private import BlueDogLogicalArchitecture::*;
    doc /* Provisional physical realization of IC-01's mass/energy and recovery
     * hypothesis. Separate parts make intended fault containment inspectable;
     * they do not demonstrate electrical, software or environmental independence.
     * Catalog equipment, processor partition and installed sensing remain open.
     * Ports and flows identify candidate interfaces without specifying connector,
     * bus, voltage, current, throughput or proven inverted performance. */
    #ioEntity item def ElectricalSupply {
        attribute availablePower : ISQ::PowerValue;
        attribute available : Boolean;
    }
    #ioEntity item def MonitoredBankState {
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute usableEnergy : ISQ::EnergyValue;
        attribute valid : Boolean;
        attribute observedAt : ISQ::TimeValue;
        doc /* Battery observation used with a route-dependent recovery demand;
         * nameplate capacity alone does not establish usable energy or reserve. */
    }
    port def SupplyOutput { out item electrical : ElectricalSupply; }
    port def SupplyInput { in item electrical : ElectricalSupply; }
    port def BankStateOutput { out item observation : MonitoredBankState; }
    port def BankStateInput { in item observation : MonitoredBankState; }
    #hardware part def Battery {
        attribute nameplateWh : Real;
        port output : SupplyOutput;
        port monitor : BankStateOutput;
        doc /* The monitor is a candidate required interface; its sensing,
         * estimation and installation have not been selected or calibrated. */
    }
    #hardware part def NavigationSensors {
        port power : SupplyInput;
        port navigation : NavigationOutput;
    }
    #hardware part def WindSensor {
        ref part installation : BlueDogWindEquipment::Installation = BlueDogWindEquipment::challenge;
        port power : SupplyInput;
        port wind : WindOutput;
    }
    #hardware part def ObservationEquipment {
        port power : SupplyInput;
        port tracks : TracksOutput;
    }
    #hardware part def Controller {
        port power : SupplyInput;
        port link : LinkInput;
        port navigation : NavigationInput;
        port wind : WindInput;
        port tracks : TracksInput;
        port safety : SafetyInput;
        port assessedSafety : SafetyOutput;
        port mainBank : BankStateInput;
        port recoveryBank : BankStateInput;
        port commands : CommandOutput;
        port recovery : RecoveryOutput;
        port permissions : PermissionOutput;
        port peerPermissions : PermissionInput;
        port retained : RecordInput;
        port events : RecordOutput;
        doc /* SafetyAssessment is allocated here; its output aggregates current
         * sensing, actuation, energy and health evidence, not navigation alone.
         * The implementation, peer-timeout policy and independent failure detection
         * are unresolved. Receiving a peer report does not prove its truth. */
    }
    #hardware part def SailingActuators {
        port power : SupplyInput;
        port commands : CommandInput;
        port permissions : PermissionInput;
    }
    #hardware part def RecoveryPropulsor {
        port power : SupplyInput;
        port recovery : RecoveryInput;
    }
    #hardware part def RecordStorage {
        port power : SupplyInput;
        port events : RecordInput;
        port retained : RecordOutput;
        doc /* Readback supports queued telemetry. Retention, arbitration and
         * availability after a primary fault require an installed interface and
         * supply decision; this interface does not establish survivability. */
    }
    #hardware part def TelemetryEquipment {
        port power : SupplyInput;
        port events : RecordInput;
        port status : LinkOutput;
    }
    #hardware part def IC01Candidate {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata issue : ModelingMetadata::Issue {
            text = "Independent recovery power, navigation, observation, control and thrust are unverified hypotheses. Establish common-cause isolation, inverted sensing/propulsion, sealing, load and interface evidence before hardware acceptance. Telemetry and record-storage bus assignment remains unresolved; the 8 W recovery essential-load allowance is not an installed load measurement or proof that those functions survive on the 60 Wh bank.";
        }
        part mainBattery : Battery { attribute :>> nameplateWh = BlueDogIC01::design.battery_Wh; }
        part recoveryBattery : Battery { attribute :>> nameplateWh = BlueDogIC01::integration.recoveryBatteryWh; }
        part primaryNavigation : NavigationSensors;
        part windSensor : WindSensor;
        part primaryObservation : ObservationEquipment;
        part primaryController : Controller;
        part sailingActuators : SailingActuators;
        part recoveryNavigation : NavigationSensors;
        part recoveryObservation : ObservationEquipment;
        part recoveryController : Controller;
        part recoveryPropulsor : RecoveryPropulsor;
        part recordStorage : RecordStorage;
        part telemetry : TelemetryEquipment;
        part hullAndRig : BlueDog::Architecture::HullAndRig;
        flow mainNavigationPower from mainBattery.output.electrical to primaryNavigation.power.electrical;
        flow windPower from mainBattery.output.electrical to windSensor.power.electrical;
        flow mainObservationPower from mainBattery.output.electrical to primaryObservation.power.electrical;
        flow mainControllerPower from mainBattery.output.electrical to primaryController.power.electrical;
        flow sailingPower from mainBattery.output.electrical to sailingActuators.power.electrical;
        flow recoveryNavigationPower from recoveryBattery.output.electrical to recoveryNavigation.power.electrical;
        flow recoveryObservationPower from recoveryBattery.output.electrical to recoveryObservation.power.electrical;
        flow recoveryControllerPower from recoveryBattery.output.electrical to recoveryController.power.electrical;
        flow recoveryPropulsionPower from recoveryBattery.output.electrical to recoveryPropulsor.power.electrical;
        flow mainBankToPrimary from mainBattery.monitor.observation to primaryController.mainBank.observation;
        flow recoveryBankToPrimary from recoveryBattery.monitor.observation to primaryController.recoveryBank.observation;
        flow recoveryBankToRecovery from recoveryBattery.monitor.observation to recoveryController.recoveryBank.observation;
        flow mainBankToRecovery from mainBattery.monitor.observation to recoveryController.mainBank.observation;
        flow primaryNavigationData from primaryNavigation.navigation.estimate to primaryController.navigation.estimate;
        flow windData from windSensor.wind.estimate to primaryController.wind.estimate;
        flow primaryTrafficData from primaryObservation.tracks.observation to primaryController.tracks.observation;
        flow primarySafetyToRecovery from primaryController.assessedSafety.observation to recoveryController.safety.observation;
        flow recoverySafetyToPrimary from recoveryController.assessedSafety.observation to primaryController.safety.observation;
        flow sailingPermissions from primaryController.permissions.permission to sailingActuators.permissions.permission;
        flow primaryPermissionsToRecovery from primaryController.permissions.permission to recoveryController.peerPermissions.permission;
        flow recoveryPermissionsToPrimary from recoveryController.permissions.permission to primaryController.peerPermissions.permission;
        flow sailingCommandData from primaryController.commands.command to sailingActuators.commands.command;
        flow recoveryNavigationData from recoveryNavigation.navigation.estimate to recoveryController.navigation.estimate;
        flow recoveryTrafficData from recoveryObservation.tracks.observation to recoveryController.tracks.observation;
        flow recoveryCommandData from recoveryController.recovery.command to recoveryPropulsor.recovery.command;
        flow primaryRecords from primaryController.events.record to recordStorage.events.record;
        flow recoveryRecords from recoveryController.events.record to recordStorage.events.record;
        flow primaryTelemetry from primaryController.events.record to telemetry.events.record;
        flow recoveryTelemetry from recoveryController.events.record to telemetry.events.record;
        flow primaryLinkStatus from telemetry.status.observation to primaryController.link.observation;
        flow recoveryLinkStatus from telemetry.status.observation to recoveryController.link.observation;
        flow primaryRecordReadback from recordStorage.retained.record to primaryController.retained.record;
        flow recoveryRecordReadback from recordStorage.retained.record to recoveryController.retained.record;
    }
    part ic01 : IC01Candidate {
        ref part configuration : MarineDesign::Design = BlueDogIC01::design;
        ref part integration = BlueDogIC01::integration;
        doc /* Candidate assembly for this named geometry and capability hypothesis.
         * Configuration references do not qualify installed hardware. */
    }
}

package BlueDogBehaviorContracts {
    private import ScalarValues::*;
    private import ISQ::*;
    private import ModelingMetadata::refinement;
    doc /* Partial executable consumer contracts for the current Gorge mission.
     * NASA SE Handbook 4.3.1.2.2 and defense SE Guidebook 2026 section 6.2.3
     * inform end-to-end functions/allocation; SysML 2.0 sections 7.17-7.18
     * govern action semantics. Actual outcomes follow the named requirements.
     * No hardware scheduler, synchronized clock or durable storage is inferred. */

    action def AssessObservationUsability {
        in producerValid : Boolean [1];
        in contextApplicable : Boolean [1];
        in clockEstablished : Boolean [1];
        in observedAt : TimeValue [1];
        in now : TimeValue [1];
        in maximumAge : TimeValue [1];
        out usable : Boolean [1];
        first start;
        then action assess {
            assign usable := BlueDogInterfaceContracts::ObservationUsable(
                producerValid,contextApplicable,clockEstablished,observedAt,now,maximumAge);
        }
        then done;
    }
    action def SailingActuationGate {
        doc /* Evaluate immediately before dispatch against current observations
         * and permission, not only at command creation. Boolean applicability
         * inputs are assessed using the interface contracts; they are not defaults. */
        in commandApplicable : Boolean [1];
        in permissionApplicable : Boolean [1];
        in sailingPermitted : Boolean [1];
        in abortLatched : Boolean [1];
        in qualificationLost : Boolean [1];
        in capsized : Boolean [1];
        in windUsable : Boolean [1];
        in navigationUsable : Boolean [1];
        in requiredSafetyConfirmed : Boolean [1];
        out actuate : Boolean [1];
        first start;
        then action gate {
            assign actuate := commandApplicable and permissionApplicable and sailingPermitted
            and not abortLatched and not qualificationLost and not capsized
            and windUsable and navigationUsable and requiredSafetyConfirmed;
        }
        then done;
    }
    action def RecoveryActuationGate {
        doc /* R-101 inhibits motor thrust while qualifying or status unknown.
         * E-138 requires durable disqualification before commanded motor enable.
         * R-102 requires established recovery authorization after restart.
         * Abort is intentionally not a motor inhibit: recovery follows abort. */
        in recoveryRequested : Boolean [1];
        in commandApplicable : Boolean [1];
        in recoveryAuthorized : Boolean [1];
        in qualificationStateKnown : Boolean [1];
        in qualifying : Boolean [1];
        in disqualificationStored : Boolean [1];
        in recoveryPathAvailable : Boolean [1];
        in inhibitActive : Boolean [1];
        out motorEnable : Boolean [1];
        first start;
        then action gate {
            assign motorEnable := recoveryRequested and commandApplicable and recoveryAuthorized
            and qualificationStateKnown and not qualifying and disqualificationStored
            and recoveryPathAvailable and not inhibitActive;
        }
        then done;
    }
    action def RestoreQualification {
        doc /* Explicit restart assessment, distinct from constructing a new
         * attempt. E-139/E-145 require nonqualifying fallback for missing or
         * inconsistent persisted state. A live disqualification cannot be erased
         * by restoring an older record. Persistence and the 30 s restoration
         * deadline still need an actual storage/restart implementation. */
        in recordValid : Boolean [1];
        in persistedQualificationLost : Boolean [1];
        in currentQualificationLost : Boolean [1];
        out qualificationLostNext : Boolean [1];
        first start;
        then action restore {
            assign qualificationLostNext := currentQualificationLost or not recordValid or persistedQualificationLost;
        }
        then done;
    }
    action navigationValidation : AssessObservationUsability;
    action sailingGate : SailingActuationGate;
    action recoveryGate : RecoveryActuationGate;
    action restartQualification : RestoreQualification;
    allocate navigationValidation to BlueDogLogicalArchitecture::vessel.navigation;
    allocate sailingGate to BlueDogLogicalArchitecture::vessel.actuation;
    allocate recoveryGate to BlueDogLogicalArchitecture::vessel.recoveryActuation;
    allocate restartQualification to BlueDogLogicalArchitecture::vessel.supervision;
    #refinement dependency navigationAssessment from AssessObservationUsability to BlueDogMethod::Scenarios::ValidateNavigation;
    #refinement dependency sailingAssessment from SailingActuationGate to BlueDogMethod::Scenarios::ApplySailingCommand;
    #refinement dependency recoveryAssessment from RecoveryActuationGate to BlueDogMethod::Scenarios::ApplyRecoveryCommand;
    dependency motorInvariant from RecoveryActuationGate to BlueDogRequirements::motorQualificationInvariant;
    dependency durableAuthorization from RecoveryActuationGate to BlueDogRequirements::qualificationPersistence;
    dependency freshAuthorization from RecoveryActuationGate to BlueDogRequirements::freshRecoveryCommand;
    dependency restorationPolicy from RestoreQualification to BlueDogRequirements::qualificationRestoration;
    dependency unknownFallback from RestoreQualification to BlueDogRequirements::unknownQualificationFallback;
    metadata issue : ModelingMetadata::Issue {
        text = "B-01: Bind installed message contexts to usability, current permissions and consumer gates; scalar conceptual simulations do not implement serialization. B-02: Demonstrate atomic durable state, acknowledgment ordering, all restriction restoration and restart deadlines on selected hardware. B-03: Resolve controller concurrency, command arbitration, resource ownership and timeout budgets, including abort during capsize/recovery. B-04: Implement and measure estimators, achieved actuation and repeated dynamic recovery; descriptive scenarios do not prove these functions.";
    }
}

package BlueDogDesignDecisions {
    private import ScalarValues::*;
    part def Decision {
        attribute disposition : String;
        attribute evidenceNeeded : String;
    }
    part sizingBaseline : Decision {
        attribute :>> disposition = "Use the fixed-camber rotating-mast wing as the first numerical sizing baseline; no final sail downselect.";
        attribute :>> evidenceNeeded = "Comparable both-tack polars, wet-cycle durability, actuator energy, mass/CG and dynamic recovery evidence for the alternatives.";
        metadata rationale : ModelingMetadata::Rationale {
            text = "The existing manufacturing CAD supplies a measured section and a practical starting geometry. This enables coupled sizing while preserving the tail-controlled wing and soft sail as equal development contenders for the finite Gorge mission. Availability of CAD is not proof of superior sailing performance.";
        }
        metadata issue : ModelingMetadata::Issue { text = "The source CAD is a manufacturing prototype, not the challenge vessel; the rectangular VSP wing uses its complete midspan section rather than reproducing its swept planform."; }
    }
    dependency baselineCandidate from sizingBaseline to BlueDogSailTrade::camberedWing;
    dependency retainedAlternative from sizingBaseline to BlueDogSailTrade::tailWing;
    dependency softSailAlternative from sizingBaseline to BlueDogSailTrade::softSail;
    dependency baselinePurpose from sizingBaseline to BlueDogRequirements::cruiseEvidence;

    part holdingDrive : Decision {
        attribute :>> disposition = "Evaluate non-backdrivable gearing as an option, not a selected or qualified component.";
        attribute :>> evidenceNeeded = "Motor-off holding under shock, wear, temperature and lubrication changes; moving efficiency, controller demand, jam and power-loss recovery tests.";
        metadata rationale : ModelingMetadata::Rationale { text = "Zero motor holding current can reduce finite mission energy consumption, but gear friction and trim movement still consume energy. A locked gearbox retains the last mast angle and requires explicit storm and capsize assessment."; }
    }
    dependency holdingEnergy from holdingDrive to BlueDogRequirements::multiDayEndurance;
    dependency holdingRecovery from holdingDrive to BlueDogRequirements::capsizeControlRecovery;
    dependency holdingCalculation from holdingDrive to MarineActuation::DrivePower;

    part aerodynamicScope : Decision {
        attribute :>> disposition = "Use restricted attached-flow VSPAERO sensitivity evidence with conservative sizing assumptions and separate actuator-moment uncertainty; no measured polar is available for this CAD.";
        attribute :>> evidenceNeeded = "Low-Reynolds-number viscous drag, stall, broadside response, thickness sensitivity and both-tack moment measurements; converged heel/wind/trim response across the sizing grid.";
        metadata rationale : ModelingMetadata::Rationale { text = "Potential-flow interpolation is suitable for a provisional force-balance model. Mesh convergence and direct candidate checks establish numerical consistency only. Rounded section ends and assumed wake attachment require physical validation; square-sail/downwind performance is not established by VLM."; }
    }
    dependency heelSensitivityEvidence from aerodynamicScope to BlueDogWingHeel::sweepInputs;
    dependency sizingAerodynamicPolicy from aerodynamicScope to BlueDogAerodynamicPolicy::sizing;
    dependency polarPurpose from aerodynamicScope to BlueDogRequirements::cruiseEvidence;
    dependency polarCalculation from aerodynamicScope to MarineSailing::Evaluate;

    part structuralScope : Decision {
        attribute :>> disposition = "Credit finite glass/epoxy laminate sections for bending; give printed substrate no bending-strength credit.";
        attribute :>> evidenceNeeded = "Wet/jointed coupon strength and stiffness, glass-to-print bonds, ribs, attachments, fatigue, buckling and impact tests.";
        metadata rationale : ModelingMetadata::Rationale { text = "Thin-wall inertia exceeded the solid-section bound in an earlier sizing trial. Polygon offsets now define finite-thickness section properties. Printed walls/ribs, seams and finish still contribute mass; preliminary material targets are not measured properties."; }
    }
    dependency structureChoice from structuralScope to BlueDogStructure::hybridConstruction;
    dependency structureCriteria from structuralScope to BlueDogStructure::structuralIntegrity;
    dependency structureCalculation from structuralScope to MarineStructures::DesignMargins;

    part recoveryScope : Decision {
        attribute :>> disposition = "Treat static full-roll restoring curves as screening evidence, separate from dynamic self-righting.";
        attribute :>> evidenceNeeded = "Dynamic releases, pitch stability, ingress/drainage, control restoration and credible failure-state geometry.";
        metadata rationale : ModelingMetadata::Rationale { text = "Positive sampled roll moments on a pitch-unstable equilibrium branch do not establish a recovery trajectory. Freely flooded material and fully retained water are distinct static sensitivities, not leakage or slosh predictions."; }
    }
    dependency recoveryCriteria from recoveryScope to BlueDogRequirements::selfRighting;
    dependency recoveryCalculation from recoveryScope to MarineHydrostatics::Balance;

    part energyEvidenceAcceptance : Decision {
        attribute :>> disposition = "Set evidenceAccepted only after review of evidence for the same installed configuration.";
        attribute :>> evidenceNeeded = "Non-overlapping installed-load coverage; measured power and duty bounds that preserve required functions; installed harvester route/season bounds including outages; temperature/end-of-service battery limits; conservative initial energy; consistent stored-energy and bus boundaries; interval resolution, uncertainty, repeat-cycle phase, source identifiers, configuration revision and review disposition.";
        metadata rationale : ModelingMetadata::Rationale { text = "A review Boolean does not automatically audit the records. Recovery demand is a battery withdrawal rate and its reserve stays inside usable capacity. Saving power by violating navigation, collision assessment, signaling, logging or communications does not establish sustained operation. A finite synthetic campaign cannot establish indefinite service."; }
    }
    dependency energyAcceptance from energyEvidenceAcceptance to BlueDogRequirements::energyEvidenceReadiness;
    dependency energyVerification from energyEvidenceAcceptance to BlueDogEnergy::SustainedEnergyVerification;

    part uncertaintyPolicy : Decision {
        attribute :>> disposition = "Separate nominal feasibility, adverse engineering sensitivities and physical qualification.";
        attribute :>> evidenceNeeded = "Measured uncertainty bounds and environmental exposure; hardware packaging/CG; robust feasibility with sufficient mission margins.";
        metadata rationale : ModelingMetadata::Rationale { text = "The size search is local and its variable brackets are numerical or model-domain limits. Mesh reserves are numerical allowances, not engineering safety factors. Sensitivity cases are not probabilities. Failed local operating solves do not prove physical impossibility or global infeasibility."; }
    }
    dependency uncertaintyCases from uncertaintyPolicy to BlueDogCoupledUncertainty::Inputs;
    dependency missionEvidence from uncertaintyPolicy to BlueDogRequirements::missionEvidence;
    part trafficCourtesy : Decision {
        attribute disposition :>> disposition = "Prefer safe, rule-consistent routes, operating windows and trajectories that reduce the likelihood of crewed vessels needing to maneuver. Accept delay or reduced mission progress to avoid developing encounters. Once encounter duties apply, preserve required predictable behavior and act when permitted or necessary; this is not an always-yield policy.";
        attribute evidenceNeeded :>> evidenceNeeded = "Compare alternatives against the same traffic scenarios using close-encounter exposure, predicted need for other-vessel action and mission delay, with explicit behavior and sensing assumptions. These are comparative design measures, not evidence of why another skipper acted or challenge pass/fail criteria. The preference is not yet implemented as a planner objective or validated by the existing replay.";
    }
    dependency courtesyWithinNavigationDuties from trafficCourtesy to GorgeChallenge::navigationRules;
    dependency courtesyCollisionSafety from trafficCourtesy to GorgeChallenge::trafficCoexistence;
}

package BlueDogInterfaceContracts {
    private import ScalarValues::*;
    private import ISQ::*;
    private import SI::*;
    doc /* Candidate logical data contracts. Source basis: NASA SE Handbook
     * 6.3.1.2.2-3; historical NASA SWE-112 section 3 (DI-IPSC-81436A-based
     * guidance); OMG SysML 2.0 sections 7.12-7.16. These definitions do not
     * select transport, serialize messages or implement runtime acceptance. */

    item def ObservationContext {
        attribute sourceIdentity : String;
        attribute configurationIdentity : String;
        attribute clockIdentity : String;
        attribute sourceEpoch : String;
        attribute sequence : Integer;
        doc /* Identity and sequence are semantic provenance, not authentication.
         * Epoch changes on producer restart; ordering is meaningful only within
         * the identified source/epoch. Clock identity requires an established
         * epoch, synchronization and uncertainty contract before comparing times. */
    }
    item def CommandContext {
        attribute authorityIdentity : String;
        attribute configurationIdentity : String;
        attribute clockIdentity : String;
        attribute authorityEpoch : String;
        attribute sequence : Integer;
        attribute issuedAt : TimeValue;
        attribute validUntil : TimeValue;
        doc /* Times use one identified monotonic reference. Consumers must use
         * an agreed authority epoch and ordering rule. Expiry cannot grant
         * permission or clear an abort. Arbitration, restart and inhibit design
         * remain unresolved; these fields do not establish an independent path. */
    }
    calc def ObservationUsable {
        doc /* Parameterized consumer precondition, not a selected freshness
         * policy. All comparisons require one established clock and applicable
         * configuration/frame. Producer validity alone is insufficient. A
         * negative observation may be valid. Bounds here are inclusive; a
         * consumer's allocated criterion must justify its maximumAge. */
        in producerValid : Boolean;
        in contextApplicable : Boolean;
        in clockEstablished : Boolean;
        in observedAt : TimeValue;
        in now : TimeValue;
        in maximumAge : TimeValue;
        return usable : Boolean = producerValid and contextApplicable and clockEstablished
        and maximumAge >= 0 [s] and observedAt <= now and now - observedAt <= maximumAge;
    }
    calc def CommandApplicable {
        doc /* Parameterized applicability only. Does not grant authority or
         * defeat the consumer's current permission/inhibit. Replay protection,
         * arbitration and clock establishment require separate implementation. */
        in authorityAccepted : Boolean;
        in contextApplicable : Boolean;
        in clockEstablished : Boolean;
        in orderingAccepted : Boolean;
        in issuedAt : TimeValue;
        in validUntil : TimeValue;
        in now : TimeValue;
        return applicable : Boolean = authorityAccepted and contextApplicable and clockEstablished
        and orderingAccepted and issuedAt <= now and now <= validUntil and issuedAt <= validUntil;
    }
    metadata issue : ModelingMetadata::Issue {
        text = "IF-01: Select per-consumer freshness/latency limits from safety and control analysis; cadence does not establish age. IF-02: Establish clock epoch, synchronization uncertainty, producer/authority restart and replay rules. IF-03: Resolve navigation datum, heading/bearing/trim references and required transformations. IF-04: Resolve primary/recovery arbitration, safe inhibits and command expiry. IF-05: Specify physical voltage/current/protection, connector and sealing contracts, storage/telemetry supply and encoding/protocol details. Schema and predicate checks do not close these implementation and physical-evidence gaps.";
    }
}

package BlueDogMethod {
    private import OOSEM::*;
    private import BlueDog::Architecture::*;
    private import ModelingMetadata::refinement;

    doc /* OOSEM organizes engineering artifacts and their engineering questions.
     * Method classification is not verification or evidence acceptance.
     * Existing requirement derivations, refinements and owner constraints keep their
     * meanings. Package roles do not assert a one-level derivation for every member.
     */
    metadata mission : OOSEMPackage about GorgeChallenge {
        kind = OOSEMPackageKind::missionRequirements;
    }
    metadata requirements : OOSEMPackage about BlueDogRequirements {
        kind = OOSEMPackageKind::systemRequirements;
    }
    metadata verificationScope : OOSEMPackage about BlueDogRequirementVerification {
        kind = OOSEMPackageKind::verificationModel;
    }
    metadata simulation : OOSEMPackage about BlueDogMissionSimulation {
        kind = OOSEMPackageKind::analysisModel;
    }
    metadata equipment : OOSEMPackage about BlueDogWindEquipment {
        kind = OOSEMPackageKind::physicalArchitecture;
    }

    metadata logicalArchitecture : OOSEMPackage about BlueDogLogicalArchitecture {
        kind = OOSEMPackageKind::logicalArchitecture;
    }
    metadata physicalArchitecture : OOSEMPackage about BlueDogPhysicalArchitecture {
        kind = OOSEMPackageKind::physicalArchitecture;
    }

    #ioEntity item def WindEstimate {
        attribute frameIdentity : ScalarValues::String;
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute speed : ISQ::SpeedValue;
        attribute direction : ISQ::AngularMeasureValue;
        attribute observedAt : ISQ::TimeValue;
        attribute valid : ScalarValues::Boolean;
        doc /* Apparent wind in the vessel frame. Timestamp and validity travel with
         * the estimate; accuracy and cadence remain in the wind requirements.
         */
    }
    #ioEntity item def SailingCommand {
        item context : BlueDogInterfaceContracts::CommandContext;
        attribute headingReference : ScalarValues::String;
        attribute sailTrimReference : ScalarValues::String;
        attribute heading : ISQ::AngularMeasureValue;
        attribute sailTrim : ISQ::AngularMeasureValue;
    }
    #ioEntity item def LinkObservation {
        attribute valid : ScalarValues::Boolean;
        item context : BlueDogInterfaceContracts::ObservationContext;
        attribute available : ScalarValues::Boolean;
        attribute observedAt : ISQ::TimeValue;
    }
    #ioEntity item def TelemetryDisposition {
        item record : BlueDogLogicalArchitecture::MissionRecord;
        attribute transmitCurrentRecord : ScalarValues::Boolean;
        attribute retainCriticalRecord : ScalarValues::Boolean;
        doc /* Current records take priority on reconnect; older evidence is
         * retained and transmitted according to the communications requirements. */
    }
    #ioEntity item def DeploymentAssessment {
        attribute configurationIdentity : ScalarValues::String;
        attribute configurationKnown : ScalarValues::Boolean;
        attribute siteAccepted : ScalarValues::Boolean;
        attribute forecastApplicable : ScalarValues::Boolean;
        attribute recoveryPathKnown : ScalarValues::Boolean;
        attribute energyAdmitted : ScalarValues::Boolean;
        attribute requiredSafetyConfirmed : ScalarValues::Boolean;
        doc /* Inputs require configuration-specific inspection and accepted
         * operating/site evidence. The model does not infer these from IC-01 sizing. */
    }
    #ioEntity item def DeploymentPermission {
        attribute configurationIdentity : ScalarValues::String;
        attribute admitted : ScalarValues::Boolean;
    }
    #ioEntity item def ServiceAssessment {
        attribute configurationIdentity : ScalarValues::String;
        attribute sealingEvidenceAccepted : ScalarValues::Boolean;
        attribute actuationEvidenceAccepted : ScalarValues::Boolean;
        attribute configurationRecorded : ScalarValues::Boolean;
    }
    #ioEntity item def RecoveryPlan {
        attribute destinationIdentity : ScalarValues::String;
        attribute routeFeasible : ScalarValues::Boolean;
        attribute requiredEnergy : ISQ::EnergyValue;
        doc /* Reachability and energy are re-evaluated against current conditions.
         * A candidate plan does not establish safe shore access or arrival. */
    }

    @OOSEMPackage { kind = OOSEMPackageKind::logicalArchitecture; }
    package Scenarios {
        doc /* Logical decision-cycle descriptions, not executable controllers.
         * The mission simulation evaluates conceptual implementations. Physical
         * verification must establish the allocated behavior and interfaces.
         */
        action def ObserveWind { out wind : WindEstimate; }
        action def SelectSailingCommand {
            in wind : WindEstimate;
            in navigation : BlueDogLogicalArchitecture::NavigationEstimate;
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            out command : SailingCommand;
        }
        action def ApplySailingCommand {
            in command : SailingCommand [1];
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            doc /* Apply only with current supervisor permission at the actuation
             * interface. This sequence does not bypass the independent inhibit. */
        }
        #logicalScenario action def NormalSailing {
            in navigation : BlueDogLogicalArchitecture::NavigationEstimate;
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            doc /* One cycle with valid navigation, wind and safety capabilities.
             * Invalid observations transfer responsibility to degraded-operation logic.
             */
            action observe : ObserveWind;
            then action select : SelectSailingCommand;
            then action actuate : ApplySailingCommand;
            flow observe.wind to select.wind;
            bind select.navigation = navigation;
            bind select.permission = permission;
            bind actuate.permission = permission;
            flow select.command to actuate.command;
        }
        action def ObserveTraffic { out observation : BlueDogLogicalArchitecture::TrafficObservation; }
        action def ObserveNavigation { out navigation : BlueDogLogicalArchitecture::NavigationEstimate; }
        action def AssessEncounter {
            in observation : BlueDogLogicalArchitecture::TrafficObservation;
            in navigation : BlueDogLogicalArchitecture::NavigationEstimate;
            out assessment : BlueDogLogicalArchitecture::TrafficAssessment;
        }
        action def SelectAvoidanceManeuver {
            in assessment : BlueDogLogicalArchitecture::TrafficAssessment;
            in navigation : BlueDogLogicalArchitecture::NavigationEstimate;
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            out command : SailingCommand;
        }
        action def ExecuteAndReassess {
            in command : SailingCommand [1];
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            out assessment : BlueDogLogicalArchitecture::TrafficAssessment;
        }
        #logicalScenario action def TrafficEncounter {
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            doc /* Repeated encounter assessment includes AIS and non-AIS traffic.
             * Detection failure invokes abort/recovery; this sequence alone does not
             * establish collision avoidance or navigation-rule compliance.
             */
            action observe : ObserveTraffic;
            then action navigate : ObserveNavigation;
            then action assess : AssessEncounter;
            then action select : SelectAvoidanceManeuver;
            then action execute : ExecuteAndReassess;
            flow observe.observation to assess.observation;
            flow navigate.navigation to assess.navigation;
            flow assess.assessment to select.assessment;
            flow navigate.navigation to select.navigation;
            bind select.permission = permission;
            bind execute.permission = permission;
            flow select.command to execute.command;
        }
        action def LatchAbort {
            out permission : BlueDogLogicalArchitecture::OperationPermission;
            out record : BlueDogLogicalArchitecture::MissionRecord;
        }
        action def RecordAndSignalAbort {
            in record : BlueDogLogicalArchitecture::MissionRecord;
            doc /* Queue an alert and retain local evidence without waiting for a
             * communications link or acknowledgment before proceeding to recovery.
             */
        }
        action def AssessRecoveryBoundary {
            in navigation : BlueDogLogicalArchitecture::NavigationEstimate;
            out boundary : BlueDogLogicalArchitecture::BoundaryAssessment;
        }
        action def SelectReachableShore {
            in navigation : BlueDogLogicalArchitecture::NavigationEstimate;
            in observation : BlueDogLogicalArchitecture::TrafficObservation;
            in boundary : BlueDogLogicalArchitecture::BoundaryAssessment;
            in reserve : BlueDogLogicalArchitecture::ReserveAssessment;
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            out plan : RecoveryPlan;
        }
        action def RecoverAndReassess {
            in plan : RecoveryPlan;
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            out command : BlueDogLogicalArchitecture::RecoveryCommand;
            out record : BlueDogLogicalArchitecture::MissionRecord;
        }
        action def PersistRecoveryAuthorization {
            in record : BlueDogLogicalArchitecture::MissionRecord;
            out authorizationStored : ScalarValues::Boolean [1];
            doc /* Confirm durable disqualification storage before motor enable.
             * Failure or unknown acknowledgment cannot authorize propulsion.
             * This descriptive step does not implement storage hardware. */
        }
        action def ApplyRecoveryCommand {
            in command : BlueDogLogicalArchitecture::RecoveryCommand [1];
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            in authorizationStored : ScalarValues::Boolean [1];
            out record : BlueDogLogicalArchitecture::MissionRecord;
            doc /* Check current authority, command applicability, qualification,
             * durable state and interlocks before enable. Record the observed
             * execution disposition; acceptance does not establish shore arrival. */
        }
        action def RecordRecoveryOutcome {
            in record : BlueDogLogicalArchitecture::MissionRecord;
        }
        #logicalScenario action def AbortAndRecover {
            doc /* A safety-capability loss, reserve trigger or other declared abort
             * condition ends the attempt. Recovery may use the motor and must remain
             * autonomous through communications loss. Reassess shore reachability
             * and safety throughout recovery; completion never resumes the attempt.
             */
            action abort : LatchAbort;
            then action signal : RecordAndSignalAbort;
            then action navigate : ObserveNavigation;
            then action observe : ObserveTraffic;
            then action boundary : AssessRecoveryBoundary;
            then action reserve : ObserveReserve;
            then action plan : SelectReachableShore;
            then action recover : RecoverAndReassess;
            then action persist : PersistRecoveryAuthorization;
            then action actuate : ApplyRecoveryCommand;
            then action record : RecordRecoveryOutcome;
            flow navigate.navigation to boundary.navigation;
            flow navigate.navigation to plan.navigation;
            flow observe.observation to plan.observation;
            flow boundary.boundary to plan.boundary;
            flow reserve.assessment to plan.reserve;
            flow recover.command to actuate.command;
            flow recover.record to persist.record;
            flow persist.authorizationStored to actuate.authorizationStored;
            flow abort.permission to actuate.permission;
            flow actuate.record to record.record;
            flow abort.record to signal.record;
            flow abort.permission to plan.permission;
            flow abort.permission to recover.permission;
            flow plan.plan to recover.plan;
        }
        action def ObserveCapsizeSafety {
            out observation : BlueDogLogicalArchitecture::SafetyObservation;
        }
        action def AssessCapsizeContinuation {
            in observation : BlueDogLogicalArchitecture::SafetyObservation;
            out permission : BlueDogLogicalArchitecture::OperationPermission;
            out record : BlueDogLogicalArchitecture::MissionRecord;
            doc /* Preserve the qualification and abort latches. Inversion alone
             * does not disqualify. Missing safety confirmation, intervention or
             * motor use prohibits resumption. An explicit unassisted upright
             * control observation is required before sailing can resume. */
        }
        action def ApplyCapsizePermission {
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
        }
        action def RetainCapsizeRecord {
            in record : BlueDogLogicalArchitecture::MissionRecord;
        }
        #logicalScenario action def CapsizeAndResume {
            doc /* One repeated capsize-management decision cycle, not a promise
             * that the hull will self-right. Suspend sailing and gate scoring,
             * observe required safety while inverted, then either retain the
             * attempt until unassisted righting or transfer to AbortAndRecover.
             * The native supervisor executes permissions; physical righting,
             * inverted safety and restoration times still require measurement. */
            action observe : ObserveCapsizeSafety;
            then action assess : AssessCapsizeContinuation;
            then action apply : ApplyCapsizePermission;
            then action record : RetainCapsizeRecord;
            flow observe.observation to assess.observation;
            flow assess.permission to apply.permission;
            flow assess.record to record.record;
        }
        action def ValidateNavigation {
            in observation : BlueDogLogicalArchitecture::NavigationEstimate;
            out current : BlueDogLogicalArchitecture::NavigationEstimate;
            out usable : ScalarValues::Boolean [1];
            doc /* Preserve the producer assertion and report consumer usability
             * separately using the allocated age/context criteria. Backup safety
             * confirmation is a separate observation, not inferred from this flag. */
        }
        action def SelectNavigationGuidance {
            in navigation : BlueDogLogicalArchitecture::NavigationEstimate;
            in navigationUsable : ScalarValues::Boolean [1];
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            out command : SailingCommand;
            doc /* Invalid navigation cannot authorize a sailing command; the
             * separate supervisor permission interface inhibits actuation. */
        }
        #logicalScenario action def NavigationUpdate {
            in permission : BlueDogLogicalArchitecture::OperationPermission [1];
            doc /* Observe, validate, guide and actuate. Invalid primary navigation
             * enters degraded operation; continuation requires separately confirmed
             * safety and cannot credit gate progress from invalid observations. */
            action observe : ObserveNavigation;
            then action validate : ValidateNavigation;
            then action guide : SelectNavigationGuidance;
            then action actuate : ApplySailingCommand;
            flow observe.navigation to validate.observation;
            flow validate.current to guide.navigation;
            flow validate.usable to guide.navigationUsable;
            bind guide.permission = permission;
            bind actuate.permission = permission;
            flow guide.command to actuate.command;
        }
        action def ObserveLink { out link : LinkObservation; }
        action def ReadCurrentRecord { out record : BlueDogLogicalArchitecture::MissionRecord; }
        action def SelectTelemetryDisposition {
            in link : LinkObservation;
            in record : BlueDogLogicalArchitecture::MissionRecord;
            out disposition : TelemetryDisposition;
        }
        action def SendOrRetainRecord { in disposition : TelemetryDisposition; }
        #logicalScenario action def CommunicationsOutage {
            doc /* One repeated link-state decision cycle through outage and
             * reconnection. Autonomous safety continues without waiting for a link;
             * retain critical records and deliver current status before backlog
             * when service returns. No operator control is inferred from monitoring. */
            action observe : ObserveLink;
            then action read : ReadCurrentRecord;
            then action select : SelectTelemetryDisposition;
            then action deliver : SendOrRetainRecord;
            flow observe.link to select.link;
            flow read.record to select.record;
            flow select.disposition to deliver.disposition;
        }
        action def ObserveReserve { out assessment : BlueDogLogicalArchitecture::ReserveAssessment; }
        action def SelectReserveResponse {
            in assessment : BlueDogLogicalArchitecture::ReserveAssessment;
            out permission : BlueDogLogicalArchitecture::OperationPermission;
            out recovery : BlueDogLogicalArchitecture::RecoveryCommand;
        }
        action def PreserveSafetyLoads { in permission : BlueDogLogicalArchitecture::OperationPermission [1]; }
        action def RequestRecovery { in command : BlueDogLogicalArchitecture::RecoveryCommand [1]; }
        #logicalScenario action def LowEnergyResponse {
            doc /* Compare conservative usable energy with current recovery demand,
             * protect required safety loads, and abort when the protected reserve
             * is threatened. Recovery action is conditional on the resulting
             * command and available authority; energy restoration cannot clear abort. */
            action observe : ObserveReserve;
            then action select : SelectReserveResponse;
            then action preserve : PreserveSafetyLoads;
            then action request : RequestRecovery;
            flow observe.assessment to select.assessment;
            flow select.permission to preserve.permission;
            flow select.recovery to request.command;
        }
        action def InspectLaunchReadiness { out assessment : DeploymentAssessment; }
        action def AdmitLaunch {
            in assessment : DeploymentAssessment;
            out permission : DeploymentPermission;
        }
        action def LaunchAndInitialize { in permission : DeploymentPermission; }
        #logicalScenario action def PrepareAndLaunch {
            doc /* The operator supplies inspected configuration and accepted site,
             * forecast, safety and energy assessments. Admission precedes physical
             * launch and initialization of a new attempt. Transport and launch are
             * operator actions; onboard autonomy starts at the declared mission boundary. */
            action inspect : InspectLaunchReadiness;
            then action admit : AdmitLaunch;
            then action launch : LaunchAndInitialize;
            flow inspect.assessment to admit.assessment;
            flow admit.permission to launch.permission;
        }
        action def ServiceAndInspect { out assessment : ServiceAssessment; }
        action def AssessServiceRelease {
            in assessment : ServiceAssessment;
            out permission : DeploymentPermission;
        }
        action def RecordServiceConfiguration {
            in assessment : ServiceAssessment;
            in permission : DeploymentPermission;
        }
        #logicalScenario action def MaintainAndRelease {
            doc /* After component replacement, the operator inspects sealing and
             * actuation and records the actual configuration before release.
             * A denied release is recorded too; this descriptive scenario does
             * not execute or accept physical service tests. */
            action service : ServiceAndInspect;
            then action assess : AssessServiceRelease;
            then action record : RecordServiceConfiguration;
            flow service.assessment to assess.assessment;
            flow service.assessment to record.assessment;
            flow assess.permission to record.permission;
        }
        #logicalScenario action normalSailing : NormalSailing;
        #logicalScenario action trafficEncounter : TrafficEncounter;
        #logicalScenario action abortAndRecover : AbortAndRecover;
        #logicalScenario action capsizeAndResume : CapsizeAndResume;
        #logicalScenario action navigationUpdate : NavigationUpdate;
        #logicalScenario action communicationsOutage : CommunicationsOutage;
        #logicalScenario action lowEnergyResponse : LowEnergyResponse;
        #logicalScenario action prepareAndLaunch : PrepareAndLaunch;
        #logicalScenario action maintainAndRelease : MaintainAndRelease;

        allocate normalSailing.observe to BlueDogLogicalArchitecture::vessel.wind;
        allocate normalSailing.select to BlueDogLogicalArchitecture::vessel.guidance;
        allocate normalSailing.actuate to BlueDogLogicalArchitecture::vessel.actuation;
        allocate trafficEncounter.observe to BlueDogLogicalArchitecture::vessel.trafficObservation;
        allocate trafficEncounter.navigate to BlueDogLogicalArchitecture::vessel.navigation;
        allocate trafficEncounter.assess to BlueDogLogicalArchitecture::vessel.collision;
        allocate trafficEncounter.select to BlueDogLogicalArchitecture::vessel.guidance;
        allocate trafficEncounter.execute to BlueDogLogicalArchitecture::vessel.actuation;
        allocate abortAndRecover.abort to BlueDogLogicalArchitecture::vessel.supervision;
        allocate abortAndRecover.signal to BlueDogLogicalArchitecture::vessel.communications;
        allocate abortAndRecover.signal to BlueDogLogicalArchitecture::vessel.recording;
        allocate abortAndRecover.plan to BlueDogLogicalArchitecture::vessel.recovery;
        allocate abortAndRecover.recover to BlueDogLogicalArchitecture::vessel.recovery;
        allocate abortAndRecover.navigate to BlueDogLogicalArchitecture::vessel.navigation;
        allocate abortAndRecover.observe to BlueDogLogicalArchitecture::vessel.trafficObservation;
        allocate abortAndRecover.boundary to BlueDogLogicalArchitecture::vessel.boundary;
        allocate abortAndRecover.reserve to BlueDogLogicalArchitecture::vessel.energy;
        allocate abortAndRecover.persist to BlueDogLogicalArchitecture::vessel.recording;
        allocate abortAndRecover.actuate to BlueDogLogicalArchitecture::vessel.recoveryActuation;
        allocate abortAndRecover.record to BlueDogLogicalArchitecture::vessel.recording;
        allocate capsizeAndResume.observe to BlueDogLogicalArchitecture::vessel.safety;
        allocate capsizeAndResume.assess to BlueDogLogicalArchitecture::vessel.supervision;
        allocate capsizeAndResume.apply to BlueDogLogicalArchitecture::vessel.actuation;
        allocate capsizeAndResume.record to BlueDogLogicalArchitecture::vessel.recording;
        allocate navigationUpdate.observe to BlueDogLogicalArchitecture::vessel.navigation;
        allocate navigationUpdate.validate to BlueDogLogicalArchitecture::vessel.navigation;
        allocate navigationUpdate.guide to BlueDogLogicalArchitecture::vessel.guidance;
        allocate navigationUpdate.actuate to BlueDogLogicalArchitecture::vessel.actuation;
        allocate communicationsOutage.observe to BlueDogLogicalArchitecture::vessel.communications;
        allocate communicationsOutage.read to BlueDogLogicalArchitecture::vessel.recording;
        allocate communicationsOutage.select to BlueDogLogicalArchitecture::vessel.communications;
        allocate communicationsOutage.deliver to BlueDogLogicalArchitecture::vessel.communications;
        allocate lowEnergyResponse.observe to BlueDogLogicalArchitecture::vessel.energy;
        allocate lowEnergyResponse.select to BlueDogLogicalArchitecture::vessel.supervision;
        allocate lowEnergyResponse.preserve to BlueDogLogicalArchitecture::vessel.energy;
        allocate lowEnergyResponse.request to BlueDogLogicalArchitecture::vessel.recovery;
        allocate prepareAndLaunch.inspect to missionContext.operator;
        allocate prepareAndLaunch.admit to BlueDogLogicalArchitecture::vessel.supervision;
        allocate prepareAndLaunch.launch to missionContext.operator;
        allocate maintainAndRelease.service to missionContext.operator;
        allocate maintainAndRelease.assess to missionContext.operator;
        allocate maintainAndRelease.record to BlueDogLogicalArchitecture::vessel.recording;

        #refinement dependency normalScenario from NormalSailing to BlueDogUseCases::sailGorge;
        #refinement dependency trafficScenario from TrafficEncounter to BlueDogUseCases::avoidTraffic;
        #refinement dependency recoveryScenario from AbortAndRecover to BlueDogUseCases::recover;
        #refinement dependency capsizeScenario from CapsizeAndResume to BlueDogUseCases::recoverUpright;
        #refinement dependency navigationScenario from NavigationUpdate to BlueDogUseCases::navigateCourse;
        #refinement dependency outageScenario from CommunicationsOutage to BlueDogUseCases::monitor;
        #refinement dependency energyScenario from LowEnergyResponse to BlueDogUseCases::preserveRecoveryReserve;
        #refinement dependency launchScenario from PrepareAndLaunch to BlueDogUseCases::prepare;
        #refinement dependency serviceScenario from MaintainAndRelease to BlueDogUseCases::maintain;
        dependency normalEvidence from BlueDogRequirementVerification::NavigationAndControlVerification to NormalSailing;
        dependency trafficEvidence from BlueDogRequirementVerification::TrafficSafetyVerification to TrafficEncounter;
        dependency recoveryEvidence from BlueDogRequirementVerification::EmergencyControlVerification to AbortAndRecover;
        dependency recoveryPropulsionEvidence from BlueDogRequirementVerification::RecoveryPropulsionVerification to AbortAndRecover;
        dependency recoveryReserveEvidence from BlueDogRequirementVerification::RecoveryEnergyVerification to AbortAndRecover;
        dependency capsizeEvidence from BlueDogRequirementVerification::CapsizeControlRecoveryVerification to CapsizeAndResume;
        dependency navigationEvidence from BlueDogRequirementVerification::NavigationAvailabilityVerification to NavigationUpdate;
        dependency outageEvidence from BlueDogRequirementVerification::CommunicationsVerification to CommunicationsOutage;
        dependency reserveEvidence from BlueDogRequirementVerification::LowEnergyRecoveryVerification to LowEnergyResponse;
        dependency serviceEvidence from BlueDogRequirementVerification::ServiceabilityVerification to MaintainAndRelease;
        dependency simulationScope from BlueDogMissionSimulation::Inputs to NormalSailing;
        dependency encounterSimulationScope from BlueDogMissionSimulation::Inputs to TrafficEncounter;
        dependency recoverySimulationScope from BlueDogMissionSimulation::Inputs to AbortAndRecover;
    }
}

package BlueDogMissionLogic {
    private import ScalarValues::*;
    private import ModelingMetadata::refinement;

    doc /* Executable supervisory policy for the conceptual mission simulator.
     * Geometry, sensing observations, heading search and vessel dynamics are supplied
     * by the simulator. These actions do not implement a physical autopilot.
     */
    action def HandleEvent {
        in eventKind : String;
        in qualificationLost : Boolean = false;
        out directive : String;
        out capsized : Boolean;
        out recoveryPermitted : Boolean;
        out qualificationLostNext : Boolean;
        first start;
        then action classify {
            assign directive :=
                if eventKind == "operator_intervention" or eventKind == "manual_weather_update" or eventKind == "motor_use" ? "disqualify"
            else if eventKind == "communications_loss" ? "communications_outage"
            else if eventKind == "weather_service_loss" ? "retain_forecast"
            else if eventKind == "wind_sensor_loss" ? "wind_outage"
            else if eventKind == "navigation_loss" ? "navigation_outage"
            else if eventKind == "capsize" or eventKind == "unassisted_righting" ? "assess_capsize"
            else if eventKind == "forecast_invalidated" or eventKind == "sensing_loss" or eventKind == "steering_loss" or eventKind == "power_loss" or eventKind == "safety_capability_loss" or eventKind == "refuge_entry" or eventKind == "grounding" or eventKind == "anchoring" or eventKind == "shore_attachment" ? "abort"
            else if eventKind == "terminal_failure" ? "stop"
            else "unsupported";
            assign capsized := eventKind == "capsize";
            assign recoveryPermitted := eventKind == "sensing_loss" or eventKind == "forecast_invalidated" or eventKind == "safety_capability_loss" or eventKind == "capsize";
            assign qualificationLostNext := qualificationLost or directive == "disqualify" or directive == "abort";
        }
        then done;
    }

    action def CapsizeDisposition {
        doc /* Explicit observation contract, not a righting dynamics prediction.
         * Safety must remain available while inverted. Resumption additionally
         * requires observed unassisted upright recovery and restored control.
         * Missing safety evidence fails closed; a prior abort cannot be cleared. */
        in currentlyCapsized : Boolean;
        in uprightRecoveryObserved : Boolean;
        in requiredSafetyConfirmed : Boolean;
        in abortLatched : Boolean;
        in qualificationLost : Boolean = false;
        out directive : String;
        out qualificationLostNext : Boolean;
        first start;
        then action assess {
            assign directive := if abortLatched or qualificationLost or not requiredSafetyConfirmed ? "abort"
            else if uprightRecoveryObserved and not currentlyCapsized ? "invalid_observation"
            else if uprightRecoveryObserved ? "resume"
            else "await_righting";
            assign qualificationLostNext := qualificationLost or abortLatched or not requiredSafetyConfirmed;
        }
        then done;
    }
    dependency capsizeQualification from CapsizeDisposition to BlueDogRequirements::capsizeQualificationRetention;
    #refinement dependency capsizeScenarioPolicy from CapsizeDisposition to BlueDogMethod::Scenarios::AssessCapsizeContinuation;

    action def SupervisoryCycle {
        doc /* A nominal upright cycle assumes valid observations supplied by its caller.
         * Inversion or invalid primary navigation requires explicit confirmation of
         * retained safety capability. Qualification and safety abort are distinct
         * persistent states: intervention ends qualification even without a casualty.
         * The caller supplies geometry and energy assessments; this action owns the
         * response permissions. It does not predict righting or verify hardware. */
        in windValid : Boolean;
        in navigationValid : Boolean = true;
        in capsized : Boolean = false;
        in requiredSafetyConfirmed : Boolean;
        in reserveThreatened : Boolean = false;
        in trafficConflict : Boolean;
        in abortRequested : Boolean;
        in abortLatched : Boolean;
        in qualificationLost : Boolean = false;
        in communicationsAvailable : Boolean;
        out abortLatchedNext : Boolean;
        out qualificationLostNext : Boolean;
        out sailingPermitted : Boolean;
        out gateScoringPermitted : Boolean;
        out harvestPermitted : Boolean;
        out mode : String;
        out alert : String;
        first start;
        then action chooseMode {
            assign abortLatchedNext := abortLatched or abortRequested or reserveThreatened or not requiredSafetyConfirmed;
            assign qualificationLostNext := qualificationLost or abortLatchedNext;
            assign sailingPermitted := windValid and navigationValid and not capsized and not qualificationLostNext;
            assign gateScoringPermitted := navigationValid and not capsized and not qualificationLostNext;
            assign harvestPermitted := not capsized;
            assign mode := if abortLatchedNext ? "abort_recovery"
            else if qualificationLostNext ? "disqualified"
            else if capsized ? "capsized_drift"
            else if not navigationValid ? "navigation_degraded"
            else if not windValid ? "degraded_drift"
            else if trafficConflict ? "traffic_avoidance"
            else "sailing";
            assign alert := if not abortLatchedNext or abortLatched ? "none"
            else if communicationsAvailable ? "attempt" else "queue";
        }
        then done;
    }

    action def RecoveryAuthority {
        in eventKind : String;
        in ordinaryPermission : Boolean;
        in independentPath : Boolean;
        out permitted : Boolean;
        first start;
        then action chooseAuthority {
            assign permitted := ordinaryPermission or (independentPath and (eventKind == "steering_loss" or eventKind == "power_loss"));
        }
        then done;
    }
    action def FallbackPolicy {
        in recoveryAvailable : Boolean;
        in recoveryPermitted : Boolean;
        out attemptRecovery : Boolean;
        out continueDrift : Boolean;
        first start;
        then action chooseFallback {
            assign attemptRecovery := recoveryAvailable and recoveryPermitted;
            assign continueDrift := not (recoveryAvailable and recoveryPermitted);
        }
        then done;
    }
    dependency fallbackBasis from FallbackPolicy to GorgeChallenge::autonomousShoreRecovery;

    dependency unassisted from HandleEvent to GorgeChallenge::unassistedAttempt;
    dependency propulsion from HandleEvent to GorgeChallenge::sailingPropulsion;
    dependency safeRecovery from SupervisoryCycle to GorgeChallenge::autonomousShoreRecovery;
    dependency normalScenario from SupervisoryCycle to BlueDogMethod::Scenarios::NormalSailing;
    dependency trafficScenario from SupervisoryCycle to BlueDogMethod::Scenarios::TrafficEncounter;
    dependency recoveryScenario from SupervisoryCycle to BlueDogMethod::Scenarios::AbortAndRecover;
    action supervisor : SupervisoryCycle;
    action capsizeDisposition : CapsizeDisposition;
    action recoveryAuthority : RecoveryAuthority;
    action fallback : FallbackPolicy;
    allocate recoveryAuthority to BlueDogLogicalArchitecture::vessel.recovery;
    allocate fallback to BlueDogLogicalArchitecture::vessel.recovery;
    dependency recoveryAuthorityScenario from RecoveryAuthority to BlueDogMethod::Scenarios::AbortAndRecover;
    dependency fallbackScenario from FallbackPolicy to BlueDogMethod::Scenarios::AbortAndRecover;
    allocate supervisor to BlueDogLogicalArchitecture::vessel.supervision;
    allocate capsizeDisposition to BlueDogLogicalArchitecture::vessel.supervision;
}

package BlueDogRequirementBasis {
    private import ScalarValues::*;
    enum def Kind { ownerConstraint; functionalAcceptance; performanceAllocation; selectedStrategy; studyObjective; assuranceObligation; }
    metadata def Basis {
        attribute kind : Kind;
        attribute rationale : String;
    }
    metadata def StudyObjective :> Basis {
        attribute :>> kind = Kind::studyObjective;
    }
    metadata basis0 : Basis about BlueDogRequirements::DesktopManufacture { kind = Kind::ownerConstraint; rationale = "Explicit owner choices; retain independently of challenge-derived performance."; }
    metadata basis1 : Basis about BlueDogRequirements::Transportability { kind = Kind::ownerConstraint; rationale = "Explicit owner choices; retain independently of challenge-derived performance."; }
    metadata basis2 : Basis about BlueDogStructure::HybridConstruction { kind = Kind::ownerConstraint; rationale = "Explicit owner choices; retain independently of challenge-derived performance."; }
    metadata basis3 : Basis about BlueDogStructure::BendingStrength { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis4 : Basis about BlueDogStructure::PanelStrength { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis5 : Basis about BlueDogStructure::WetCouponStrength { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis6 : Basis about BlueDogStructure::WetCouponStiffness { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis7 : Basis about BlueDogStructure::AppendageDeflection { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis8 : Basis about BlueDogStructure::HullDeflection { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis9 : Basis about BlueDogStructure::PanelDeflection { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis10 : Basis about BlueDogStructure::LoadedFreeboard { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis11 : Basis about BlueDogStructure::ReserveBuoyancy { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis12 : Basis about BlueDogStructure::LaunchClearance { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis13 : Basis about BlueDogStructure::PrintTileEnvelope { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis14 : Basis about BlueDogRequirements::PrintedMaterialAging { kind = Kind::functionalAcceptance; rationale = "Verify the actual design against qualified evidence and applicable functional/load/site limits; provisional screening constants are not acceptance thresholds."; }
    metadata basis15 : Basis about BlueDogRequirements::SelfRighting { kind = Kind::selectedStrategy; rationale = "Selected passive-righting concept; the challenge permits qualified limp recovery instead."; }
    metadata basis16 : Basis about BlueDogRequirements::LiftMass { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    metadata basis17 : Basis about BlueDogRequirements::SetupDuration { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    metadata basis18 : Basis about BlueDogRequirements::PackDuration { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    metadata basis19 : Basis about BlueDogRequirements::WindSampleCadence { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    metadata basis20 : Basis about BlueDogRequirements::WindSpeedAccuracy { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    metadata basis21 : Basis about BlueDogRequirements::WindDirectionAccuracy { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    metadata basis22 : Basis about BlueDogRequirements::PositionAccuracy { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    metadata basis23 : Basis about BlueDogRequirements::HeadingAccuracy { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    metadata basis24 : Basis about BlueDogRequirements::RightingDeadline { kind = Kind::performanceAllocation; rationale = "Retained measurable performance allocation. The mission motivates the function, not this exact number; confirm the allocation through handling/control/mission evidence before design release."; }
    part materials : BlueDogDesignDecisions::Decision {
        attribute :>> disposition = "10 GPa and 50 MPa remain unverified numerical inputs. Qualification may credit only supported wet/jointed material bounds; resize for measured properties.";
        attribute :>> evidenceNeeded = "Directional production coupons, exposure, joint/process variability and conservative allowable/stiffness bounds.";
    }
    part structuralScreens : BlueDogDesignDecisions::Decision {
        attribute :>> disposition = "Keep the numerical screening policy explicit: 2/0.5/1 percent deflection, 10 kPa pressure, 100 N proof probe, 50 mm freeboard and 100 percent intact reserve are provisional study controls.";
        attribute :>> evidenceNeeded = "Mission load cases, deformed-foil/control and sealing/clearance sensitivity, attachment loads and casualty flotation. Screen passes do not close these requirements.";
    }
    part manufactureAndSites : BlueDogDesignDecisions::Decision {
        attribute :>> disposition = "250 mm print jobs and one-person handling remain owner constraints. A 230 mm tile and a 1.5 m launch depth with 0.3 m clearance are changeable analysis assumptions.";
        attribute :>> evidenceNeeded = "Sliced job envelopes including supports and actual site/depth/appendage clearance evidence.";
    }
    part aging : BlueDogDesignDecisions::Decision {
        attribute :>> disposition = "Accept aged material against the capacity credited to the design, not 80 percent of an unaged coupon. Establish mission-representative exposure; 300 MJ/m2 was an unvalidated accelerated-test dose.";
        attribute :>> evidenceNeeded = "Exposure equivalence and aged production-component load bounds; no relative-retention target substitutes for structural adequacy.";
    }
    part retainedAllocations : BlueDogDesignDecisions::Decision {
        attribute :>> disposition = "Retain safety behavior, environmental qualification profiles, sensing/control timing and accuracy, handling targets and the provisional mission-reliability objective. These are performance allocations, not material or architecture mandates.";
        attribute :>> evidenceNeeded = "Validation of the allocated numbers against handling, control sensitivity and mission/encounter analysis; they are not uniquely derived by arithmetic from the challenge.";
    }
    part recoveryStrategy : BlueDogDesignDecisions::Decision {
        attribute :>> disposition = "Treat passive self-righting as a selected vehicle strategy. The Gorge challenge also admits demonstrated autonomous limp recovery after abort.";
        attribute :>> evidenceNeeded = "Concept-specific capsize and shore-recovery demonstrations, including impaired equipment; retain current numerical recovery screens without claiming universal necessity.";
    }
    dependency materialStudy from materials to BlueDogStructuralBasis::Inputs;
    dependency materialAcceptance from materials to BlueDogStructure::wetCouponStiffness;
    dependency strengthAcceptance from materials to BlueDogStructure::wetCouponStrength;
    dependency screenPurpose from structuralScreens to BlueDogStructure::structuralIntegrity;
    dependency printerChoice from manufactureAndSites to BlueDogRequirements::desktopManufacture;
    dependency agedCapacity from aging to BlueDogRequirements::printedMaterialAging;
    dependency rightingChoice from recoveryStrategy to BlueDogRequirements::selfRighting;

    metadata basisServiceability : Basis about BlueDogRequirements::Serviceability { kind = Kind::ownerConstraint; rationale = "Between-deployment access and replacement are owner lifecycle constraints; successful unassisted passage does not imply serviceability."; }
    metadata basisMissionSuccessProbability : StudyObjective about BlueDogRequirements::MissionSuccessProbability { rationale = "Provisional reliability-study objective. Its numerical target and distribution assumptions do not govern finite Gorge qualification and require an accepted mission-specific evidence basis before adoption."; }
    metadata basisFailureRateBudget : StudyObjective about BlueDogRequirements::FailureRateBudget { rationale = "Provisional reliability-study objective. Its numerical target and distribution assumptions do not govern finite Gorge qualification and require an accepted mission-specific evidence basis before adoption."; }
    metadata basisCapsizeControlRecovery : Basis about BlueDogRequirements::CapsizeControlRecovery { kind = Kind::selectedStrategy; rationale = "Acceptance belongs to the selected N-051 passive-righting campaign. The independent challenge admits qualified post-abort limp recovery; this does not impose passive righting on every candidate architecture."; }
    metadata basisCapsizeRigRetention : Basis about BlueDogRequirements::CapsizeRigRetention { kind = Kind::selectedStrategy; rationale = "Acceptance belongs to the selected N-051 passive-righting campaign. The independent challenge admits qualified post-abort limp recovery; this does not impose passive righting on every candidate architecture."; }
    metadata basisCapsizeBallastRetention : Basis about BlueDogRequirements::CapsizeBallastRetention { kind = Kind::selectedStrategy; rationale = "Acceptance belongs to the selected N-051 passive-righting campaign. The independent challenge admits qualified post-abort limp recovery; this does not impose passive righting on every candidate architecture."; }
    metadata basisCapsizeElectronicsSealing : Basis about BlueDogRequirements::CapsizeElectronicsSealing { kind = Kind::selectedStrategy; rationale = "Acceptance belongs to the selected N-051 passive-righting campaign. The independent challenge admits qualified post-abort limp recovery; this does not impose passive righting on every candidate architecture."; }
    metadata basisControlRecoveryDeadline : Basis about BlueDogRequirements::ControlRecoveryDeadline { kind = Kind::selectedStrategy; rationale = "Acceptance belongs to the selected N-051 passive-righting campaign. The independent challenge admits qualified post-abort limp recovery; this does not impose passive righting on every candidate architecture."; }
    metadata basisCapsizeGateProgressRetention : Basis about BlueDogRequirements::CapsizeGateProgressRetention { kind = Kind::selectedStrategy; rationale = "Acceptance belongs to the selected N-051 passive-righting campaign. The independent challenge admits qualified post-abort limp recovery; this does not impose passive righting on every candidate architecture."; }
    metadata basisCapsizeQualificationRetention : Basis about BlueDogRequirements::CapsizeQualificationRetention { kind = Kind::selectedStrategy; rationale = "Acceptance belongs to the selected N-051 passive-righting campaign. The independent challenge admits qualified post-abort limp recovery; this does not impose passive righting on every candidate architecture."; }
    metadata basisCapsizeRestrictionRetention : Basis about BlueDogRequirements::CapsizeRestrictionRetention { kind = Kind::selectedStrategy; rationale = "Acceptance belongs to the selected N-051 passive-righting campaign. The independent challenge admits qualified post-abort limp recovery; this does not impose passive righting on every candidate architecture."; }
    metadata basisEnergyEvidenceReadiness : Basis about BlueDogRequirements::EnergyEvidenceReadiness { kind = Kind::assuranceObligation; rationale = "This constrains the evidence or assessment process. A completed analysis or reviewed statement is distinct from installed-vessel physical qualification."; }
    metadata basisRegulatoryClassification : Basis about BlueDogRequirements::RegulatoryClassification { kind = Kind::assuranceObligation; rationale = "This constrains the evidence or assessment process. A completed analysis or reviewed statement is distinct from installed-vessel physical qualification."; }
    metadata basisReliabilityEvidence : Basis about BlueDogRequirements::ReliabilityEvidence { kind = Kind::assuranceObligation; rationale = "This constrains the evidence or assessment process. A completed analysis or reviewed statement is distinct from installed-vessel physical qualification."; }
