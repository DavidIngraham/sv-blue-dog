package MarineActuation {
    private import ScalarValues::*;

    calc def MastTorque {
        in densityKgM3 : Real;
        in apparentWindMS : Real;
        in sailAreaM2 : Real;
        in chordM : Real;
        in momentCoefficientAtMast : Real;
        in bearingFrictionNm : Real;
        return torqueNm : Real;
        0.5*densityKgM3*apparentWindMS*apparentWindMS*sailAreaM2*chordM*RealFunctions::abs(momentCoefficientAtMast)+bearingFrictionNm
    }
    calc def DrivePower {
        doc /* Preconditions: efficiencies in (0,1], nonnegative powers and duty
         * fractions; moving plus holding fraction at most one. The external
         * sizing adapter must reject inputs outside these domains. */
        in shaftTorqueNm : Real;
        in shaftSpeedRadS : Real;
        in motorEfficiency : Real;
        in gearboxEfficiency : Real;
        in motorNoLoadW : Real;
        in controllerW : Real;
        in motorHoldingW : Real;
        in moveFraction : Real;
        in holdingFraction : Real;
        attribute movingW : Real = controllerW+motorNoLoadW+RealFunctions::abs(shaftTorqueNm*shaftSpeedRadS)/(motorEfficiency*gearboxEfficiency);
        attribute holdingW : Real = controllerW+motorHoldingW;
        return powersW : Real [3] ordered nonunique;
        (moveFraction*movingW+holdingFraction*holdingW+(1-moveFraction-holdingFraction)*controllerW,
            NumericalFunctions::max(movingW,holdingW),movingW)
    }
    calc def DailyEnergy {
        in averagePowerW : Real;
        in durationHours : Real;
        return energyWh : Real;
        averagePowerW*durationHours
    }
}

package MarineEnergy {
    private import ScalarValues::*;
    private import ISQ::*;
    private import SI::*;
    part def ElectricalLoad {
        attribute label : String;
        attribute activePower : PowerValue;
        attribute idlePower : PowerValue;
        attribute activeFraction : Real;
        attribute conversionEfficiency : Real;
        attribute uncertaintyFactor : Real;
        attribute averagePower : PowerValue =
            (idlePower + (activePower - idlePower) * activeFraction) * uncertaintyFactor / conversionEfficiency;
        attribute peakPower : PowerValue = activePower * uncertaintyFactor / conversionEfficiency;
        attribute valid : Boolean = activePower >= idlePower and idlePower >= 0 [W] and
        activeFraction >= 0 and activeFraction <= 1 and
        conversionEfficiency > 0 and conversionEfficiency <= 1 and uncertaintyFactor >= 1;
    }
    part def LoadBudget {
        part loads : ElectricalLoad [1..*] ordered;
        attribute averagePower : PowerValue = NumericalFunctions::sum(loads.averagePower);
        attribute peakPower : PowerValue = NumericalFunctions::sum(loads.peakPower);
        attribute valid : Boolean = SequenceFunctions::size(loads) > 0 and
        loads->ControlFunctions::forAll { in load : ElectricalLoad; load.valid };
    }
    part def Battery {
        attribute nominalEnergy : EnergyValue;
        attribute usableFraction : Real;
        attribute capacity : EnergyValue = nominalEnergy * usableFraction;
        attribute chargeEfficiency : Real;
        attribute dischargeEfficiency : Real;
        attribute maxChargePower : PowerValue;
        attribute selfDischargePower : PowerValue;
        attribute maxDischargePower : PowerValue;
        attribute valid : Boolean = nominalEnergy > 0 [J] and usableFraction > 0 and usableFraction <= 1 and
        chargeEfficiency > 0 and chargeEfficiency <= 1 and
        dischargeEfficiency > 0 and dischargeEfficiency <= 1 and
        maxChargePower >= 0 [W] and maxDischargePower > 0 [W] and selfDischargePower >= 0 [W];
    }
    part def Interval {
        ref part budget : LoadBudget;
        attribute duration : TimeValue;
        attribute harvestEnabled : Boolean;
        attribute rawHarvestPower : PowerValue;
        attribute harvestEfficiency : Real;
        attribute busHarvestPower : PowerValue = if harvestEnabled ? rawHarvestPower * harvestEfficiency else 0 [W];
        attribute netBusPower : PowerValue = busHarvestPower - budget.averagePower;
        attribute valid : Boolean = duration > 0 [s] and rawHarvestPower >= 0 [W] and
        harvestEfficiency > 0 and harvestEfficiency <= 1 and budget.valid;
    }
    calc def StorageRate {
        in interval : Interval;
        in battery : Battery;
        return rate : PowerValue;
        if interval.netBusPower >= 0 [W] ?
            NumericalFunctions::min(interval.netBusPower * battery.chargeEfficiency / (1 [W]), battery.maxChargePower / (1 [W])) * 1 [W] - battery.selfDischargePower
        else interval.netBusPower / battery.dischargeEfficiency - battery.selfDischargePower
    }
    analysis def BudgetRollup {
        subject budget : LoadBudget;
        assert constraint validInputs { budget.valid }
        out attribute labels : String [*] ordered nonunique = budget.loads.label;
        out attribute averageContributions : PowerValue [*] ordered nonunique = budget.loads.averagePower;
        out attribute peakContributions : PowerValue [*] ordered nonunique = budget.loads.peakPower;
        out attribute coincidentPeak : PowerValue = budget.peakPower;
        return averageDemand : PowerValue = budget.averagePower;
    }
}

package MarineAppendages {
    private import ScalarValues::*;
    calc def GeometryMargins {
        in d : Real [29] ordered nonunique;
        in minimumAspectRatio : Real;
        in clearanceM : Real;
        doc /* Rectangular underwater foils centered at x=0 (keel) and
         * x=-arm*length (rudder), with a center-chord rudder stock. The swept
         * disk bounds all steering angles, including thickness for the current
         * elliptical 12-percent section. This is a planform screen, not a
         * bearing, bracket, hull-intersection or bulb-clearance assessment. */
        attribute keelChord : Real = d#(11)/d#(12);
        attribute rudderChord : Real = d#(13)/d#(14);
        attribute keelAspectMargin : Real = d#(12)*d#(12)/d#(11)/minimumAspectRatio-1;
        attribute rudderAspectMargin : Real = d#(14)*d#(14)/d#(13)/minimumAspectRatio-1;
        attribute keelRootMargin : Real = 1-keelChord/d#(1);
        attribute rudderStockMargin : Real = 1-2*d#(15);
        attribute sweptSeparationMargin : Real = (d#(15)*d#(1)-(keelChord+rudderChord)/2-clearanceM)/d#(1);
        return result : Real [5] ordered nonunique;
        (keelAspectMargin,rudderAspectMargin,keelRootMargin,rudderStockMargin,sweptSeparationMargin)
    }
}

package MarineConcept {
    private import ScalarValues::*;
    calc def Evaluate {
        in d : Real [29] ordered nonunique;
        in m : Real [21] ordered nonunique;
        in g : Real [60] ordered nonunique;
        in q : Real [24] ordered nonunique;
        in policy : Real [5] ordered nonunique;
        in voyage : Real [2] ordered nonunique;
        doc /* SI numerical boundary: voyage = conditional hours, maximum bus W.
         * Policy = duration multiplier, delay hours, installed battery Wh/m3,
         * equipment installed kg/m3, usable hull-volume fraction.
         * No harvest credit: a finite-passage screening scenario, not perpetual
         * energy balance or a completion deadline. Volume is necessary but not
         * sufficient for local fit, access, watertightness or manufacturing. */
        attribute passageHours : Real = voyage#(1)*policy#(1)+policy#(2);
        attribute departureWh : Real = d#(17)*q#(16)*q#(17);
        attribute demandWh : Real = passageHours*(voyage#(2)/q#(15)+q#(20));
        attribute requiredWh : Real = demandWh+q#(23);
        attribute voyageEnergyMargin : Real = (departureWh-requiredWh)/100;
        attribute batteryVolumeM3 : Real = d#(17)/policy#(3);
        attribute equipmentVolumeM3 : Real = (m#(8)+m#(9)+m#(10))/policy#(4);
        attribute availableVolumeM3 : Real = (g#(5)-m#(14))*policy#(5);
        attribute installationVolumeMargin : Real = (availableVolumeM3-batteryVolumeM3-equipmentVolumeM3)/0.01;
        return result : Real [8] ordered nonunique;
        (voyageEnergyMargin,installationVolumeMargin,passageHours,departureWh,requiredWh,batteryVolumeM3,equipmentVolumeM3,availableVolumeM3)
    }
}

package MarineCourse {
    private import ScalarValues::*;
    calc def TackAverage {
        in a : Real; in b : Real; in lateralA : Real; in lateralB : Real;
        return vmg : Real;
        (a*RealFunctions::abs(lateralB)+b*RealFunctions::abs(lateralA))/(RealFunctions::abs(lateralA)+RealFunctions::abs(lateralB))
    }
    calc def Route {
        doc /* Policy element 6 scales positive-progress residuals; it is not a minimum ground-speed requirement. */
        in water : Real [8] ordered nonunique;
        in states : Real [48] ordered nonunique;
        in policy : Real [7] ordered nonunique;
        doc /* Cases ordered by wind 5 then 8 m/s, windward then leeward, tack + then -.
         * Each state contains speed, heading, incidence, leeway, rudder and heel.
         * Tack times cancel crosswind displacement. Equal time fractions per wind
         * and 0.5/1.0 m/s downstream current are illustrative, not weather evidence.
         * This is conditional on one persistent direction, not a probability
         * distribution. Neither station hourly fractions nor scenario counts
         * justify treating these equal speed weights as climatology.
         * policy#5 is an optional duration budget in hours; zero disables that screen.
         * policy#7 is 1 for easterly (upstream windward), 0 for westerly. */
        attribute cross0 : Real = states#(1)*TrigFunctions::sin(TrigFunctions::rad(states#(2)+states#(4)));
        attribute cross1 : Real = states#(7)*TrigFunctions::sin(TrigFunctions::rad(states#(8)+states#(10)));
        attribute cross2 : Real = states#(13)*TrigFunctions::sin(TrigFunctions::rad(states#(14)+states#(16)));
        attribute cross3 : Real = states#(19)*TrigFunctions::sin(TrigFunctions::rad(states#(20)+states#(22)));
        attribute cross4 : Real = states#(25)*TrigFunctions::sin(TrigFunctions::rad(states#(26)+states#(28)));
        attribute cross5 : Real = states#(31)*TrigFunctions::sin(TrigFunctions::rad(states#(32)+states#(34)));
        attribute cross6 : Real = states#(37)*TrigFunctions::sin(TrigFunctions::rad(states#(38)+states#(40)));
        attribute cross7 : Real = states#(43)*TrigFunctions::sin(TrigFunctions::rad(states#(44)+states#(46)));
        attribute vmg0 : Real = TackAverage(water#(1),water#(2),cross0,cross1);
        attribute vmg1 : Real = TackAverage(water#(3),water#(4),cross2,cross3);
        attribute vmg2 : Real = TackAverage(water#(5),water#(6),cross4,cross5);
        attribute vmg3 : Real = TackAverage(water#(7),water#(8),cross6,cross7);
        attribute windwardMean : Real = (vmg0+vmg2)/2;
        attribute leewardMean : Real = (vmg1+vmg3)/2;
        attribute downstream : Real = policy#(1)*(if policy#(7)>0.5 ? leewardMean else windwardMean)+(policy#(2)+policy#(3))/2;
        attribute upstream : Real = policy#(1)*(if policy#(7)>0.5 ? windwardMean else leewardMean)-(policy#(2)+policy#(3))/2;
        attribute duration : Real = if downstream>0 and upstream>0 ? policy#(4)/3600*(1/downstream+1/upstream) else 1000000.0;
        attribute downstreamProgress : Real = downstream/policy#(6);
        attribute upstreamProgress : Real = upstream/policy#(6);
        attribute durationMargin : Real = if policy#(5)>0 ? 1-duration/policy#(5) else 1.0;
        return result : Real [6] ordered nonunique;
        (downstreamProgress,upstreamProgress,durationMargin,downstream,upstream,duration)
    }
}

package MarineDesign {
    private import ScalarValues::*;
    doc /* Named SI numerical contract for a hull, rotating wing, keel and rudder.
     * Names carry units: metres, square metres, kg, Wh, Nm, kg/m2 and rad/s.
     * Fractions and scales are dimensionless. Arrays exist only at the compiled
     * numerical boundary; application configurations own values and evidence. */
    part def Design {
        attribute length_m : Real;
        attribute beam_m : Real;
        attribute bottom_depth_m : Real;
        attribute deck_height_m : Real;
        attribute sail_m2 : Real;
        attribute sail_AR : Real;
        attribute camber_scale : Real;
        attribute wing_thickness_scale : Real;
        attribute mast_fraction : Real;
        attribute mast_x_fraction : Real;
        attribute keel_m2 : Real;
        attribute keel_span_m : Real;
        attribute rudder_m2 : Real;
        attribute rudder_span_m : Real;
        attribute rudder_arm_fraction : Real;
        attribute ballast_kg : Real;
        attribute battery_Wh : Real;
        attribute panel_m2 : Real;
        attribute wing_torque_Nm : Real;
        attribute rudder_torque_Nm : Real;
        attribute hull_glass_kg_m2 : Real;
        attribute wing_glass_kg_m2 : Real;
        attribute keel_glass_kg_m2 : Real;
        attribute rudder_glass_kg_m2 : Real;
        attribute hull_rib_pitch_m : Real;
        attribute foil_rib_pitch_m : Real;
        attribute battery_x_fraction : Real;
        attribute battery_z_fraction : Real;
        attribute hull_fullness_exponent : Real;
    }
    calc def DesignVector {
        in value : Design;
        return vector : Real [29] ordered nonunique;
        (value.length_m, value.beam_m, value.bottom_depth_m, value.deck_height_m, value.sail_m2, value.sail_AR, value.camber_scale, value.wing_thickness_scale, value.mast_fraction, value.mast_x_fraction, value.keel_m2, value.keel_span_m, value.rudder_m2, value.rudder_span_m, value.rudder_arm_fraction, value.ballast_kg, value.battery_Wh, value.panel_m2, value.wing_torque_Nm, value.rudder_torque_Nm, value.hull_glass_kg_m2, value.wing_glass_kg_m2, value.keel_glass_kg_m2, value.rudder_glass_kg_m2, value.hull_rib_pitch_m, value.foil_rib_pitch_m, value.battery_x_fraction, value.battery_z_fraction, value.hull_fullness_exponent)
    }
    part def Parameters {
        attribute resinGlassRatio : Real;
        attribute gearboxEfficiency : Real;
        attribute motorEfficiency : Real;
        attribute wingNoLoadW : Real;
        attribute wingControllerW : Real;
        attribute wingMotorHoldingW : Real;
        attribute wingMoveFraction : Real;
        attribute wingHoldingFraction : Real;
        attribute rudderHoldingWPerNm : Real;
        attribute rudderMoveFraction : Real;
        attribute electronicsW : Real;
        attribute solarResourceFactor : Real;
        attribute batteryWhKg : Real;
        attribute laminateKnockdown : Real;
        attribute profileCd : Real;
        attribute wingClLimit : Real;
        attribute wingLiftScale : Real;
        attribute wingDragScale : Real;
        attribute wingRateRadS : Real;
        attribute rudderRateRadS : Real;
        attribute driveKgPerNm : Real;
        attribute wingDriveBaseKg : Real;
        attribute fixedEquipmentKg : Real;
        attribute attachmentKg : Real;
        attribute residuaryResistanceFactor : Real;
        attribute viscousFormFactor : Real;
        attribute foilClLimit : Real;
        attribute foilEfficiency : Real;
        attribute foilCd : Real;
        attribute airNu : Real;
        attribute waterNu : Real;
        attribute waterDensity : Real;
        attribute airDensity : Real;
        attribute ballastDensity : Real;
        attribute gravity : Real;
        attribute loadFactor : Real;
        attribute assemblyLimitKg : Real;
        attribute panelCoverage : Real;
        attribute elevatedEquipmentKg : Real default = 0;
        attribute elevatedEquipmentXFraction : Real default = 0;
        attribute elevatedEquipmentAboveDeckM : Real default = 0;
    }
    calc def ParametersVector {
        in value : Parameters;
        return vector : Real [41] ordered nonunique;
        (value.resinGlassRatio, value.gearboxEfficiency, value.motorEfficiency, value.wingNoLoadW, value.wingControllerW, value.wingMotorHoldingW, value.wingMoveFraction, value.wingHoldingFraction, value.rudderHoldingWPerNm, value.rudderMoveFraction, value.electronicsW, value.solarResourceFactor, value.batteryWhKg, value.laminateKnockdown, value.profileCd, value.wingClLimit, value.wingLiftScale, value.wingDragScale, value.wingRateRadS, value.rudderRateRadS, value.driveKgPerNm, value.wingDriveBaseKg, value.fixedEquipmentKg, value.attachmentKg, value.residuaryResistanceFactor, value.viscousFormFactor, value.foilClLimit, value.foilEfficiency, value.foilCd, value.airNu, value.waterNu, value.waterDensity, value.airDensity, value.ballastDensity, value.gravity, value.loadFactor, value.assemblyLimitKg, value.panelCoverage, value.elevatedEquipmentKg, value.elevatedEquipmentXFraction, value.elevatedEquipmentAboveDeckM)
    }
    part def OperatingState {
        doc /* Named numerical boundary. Declaration order defines the native vector ABI. */
        attribute windSpeed_m_s : Real;
        attribute windward : Real;
        attribute foulingMultiplier : Real;
        attribute speed_m_s : Real;
        attribute windFrom_deg : Real;
        attribute incidence_deg : Real;
        attribute leeway_deg : Real;
        attribute rudder_deg : Real;
        attribute heel_deg : Real;
    }
    part def AeroCoefficients {
        doc /* Named numerical boundary. Declaration order defines the native vector ABI. */
        attribute liftCoefficient : Real;
        attribute dragCoefficient : Real;
        attribute midchordMomentCoefficient : Real;
    }
    part def HydroState {
        doc /* Named numerical boundary. Declaration order defines the native vector ABI. */
        attribute waterline_m : Real;
        attribute righting_Nm : Real;
        attribute wettedHullArea_m2 : Real;
        attribute waterlineLength_m : Real;
        attribute waterlineBeam_m : Real;
        attribute canoeDraft_m : Real;
        attribute displacementVolume_m3 : Real;
        attribute waterplaneArea_m2 : Real;
        attribute lcbAftFP_m : Real;
        attribute lcfAftFP_m : Real;
        attribute prismaticCoefficient : Real;
        attribute midshipCoefficient : Real;
    }
    part def AppendageLoads {
        doc /* Named numerical boundary. Declaration order defines the native vector ABI. */
        attribute wingResultant : Real;
        attribute keelResultant : Real;
        attribute rudderResultant : Real;
    }
    part def Passage {
        doc /* Named numerical boundary. Declaration order defines the native vector ABI. */
        attribute duration_h : Real;
        attribute averagePower_W : Real;
    }
    part def MassProperties {
        doc /* Named numerical boundary. Declaration order defines the native vector ABI. */
        attribute totalMass : Real;
        attribute hullMass : Real;
        attribute wingMass : Real;
        attribute keelMass : Real;
        attribute rudderMass : Real;
        attribute batteryMass : Real;
        attribute panelMass : Real;
        attribute wingDriveMass : Real;
        attribute rudderDriveMass : Real;
        attribute equipmentMass : Real;
        attribute cgX : Real;
        attribute cgY : Real;
        attribute cgZ : Real;
        attribute hullMaterialVolume : Real;
        attribute wingMaterialVolume : Real;
        attribute keelMaterialVolume : Real;
        attribute rudderMaterialVolume : Real;
        attribute hullLaminateThickness : Real;
        attribute wingLaminateThickness : Real;
        attribute keelLaminateThickness : Real;
        attribute rudderLaminateThickness : Real;
    }
}

package MarineResistance {
    private import ScalarValues::*;
    doc /* Keuning and Katgert (2008), A Bare Hull Resistance Prediction Method
     * Derived from the Results of the Delft Systematic Yacht Hull Series Extended
     * to Higher Speeds, equation 1.7 and tables 1-2.
     * Source: https://www.scribd.com/document/346520042/Keuning-2008-pdf
     * Untrimmed, upright, bare-hull residuary resistance only. Not a total-drag,
     * heeled-hull, sail-induced trim, roughness or wave-added-resistance model.
     * Table-1 coordinate bounds are necessary screening limits, not evidence that
     * every combination inside their rectangular envelope is supported.
     * Beyond Fn 0.60 fewer hulls were tested; this implementation's admissible
     * domain stops at 0.60 pending speed-dependent coverage evidence. */
    calc def Coefficients {
        in fn : Real;
        attribute a0 : Real = if fn <= 0.20 ? -0.0005 + (fn - 0.15) / 0.05 * (-0.0003 - (-0.0005)) else if fn <= 0.25 ? -0.0003 + (fn - 0.20) / 0.05 * (-0.0002 - (-0.0003)) else if fn <= 0.30 ? -0.0002 + (fn - 0.25) / 0.05 * (-0.0009 - (-0.0002)) else if fn <= 0.35 ? -0.0009 + (fn - 0.30) / 0.05 * (-0.0026 - (-0.0009)) else if fn <= 0.40 ? -0.0026 + (fn - 0.35) / 0.05 * (-0.0064 - (-0.0026)) else if fn <= 0.45 ? -0.0064 + (fn - 0.40) / 0.05 * (-0.0218 - (-0.0064)) else if fn <= 0.50 ? -0.0218 + (fn - 0.45) / 0.05 * (-0.0388 - (-0.0218)) else if fn <= 0.55 ? -0.0388 + (fn - 0.50) / 0.05 * (-0.0347 - (-0.0388)) else if fn <= 0.60 ? -0.0347 + (fn - 0.55) / 0.05 * (-0.0361 - (-0.0347)) else if fn <= 0.65 ? -0.0361 + (fn - 0.60) / 0.05 * (0.0008 - (-0.0361)) else if fn <= 0.70 ? 0.0008 + (fn - 0.65) / 0.05 * (0.0108 - (0.0008)) else if fn <= 0.75 ? 0.0108 + (fn - 0.70) / 0.05 * (0.1023 - (0.0108)) else 0.1023;
        attribute a1 : Real = if fn <= 0.20 ? 0.0023 + (fn - 0.15) / 0.05 * (0.0059 - (0.0023)) else if fn <= 0.25 ? 0.0059 + (fn - 0.20) / 0.05 * (-0.0156 - (0.0059)) else if fn <= 0.30 ? -0.0156 + (fn - 0.25) / 0.05 * (0.0016 - (-0.0156)) else if fn <= 0.35 ? 0.0016 + (fn - 0.30) / 0.05 * (-0.0567 - (0.0016)) else if fn <= 0.40 ? -0.0567 + (fn - 0.35) / 0.05 * (-0.4034 - (-0.0567)) else if fn <= 0.45 ? -0.4034 + (fn - 0.40) / 0.05 * (-0.5261 - (-0.4034)) else if fn <= 0.50 ? -0.5261 + (fn - 0.45) / 0.05 * (-0.5986 - (-0.5261)) else if fn <= 0.55 ? -0.5986 + (fn - 0.50) / 0.05 * (-0.4764 - (-0.5986)) else if fn <= 0.60 ? -0.4764 + (fn - 0.55) / 0.05 * (0.0037 - (-0.4764)) else if fn <= 0.65 ? 0.0037 + (fn - 0.60) / 0.05 * (0.3728 - (0.0037)) else if fn <= 0.70 ? 0.3728 + (fn - 0.65) / 0.05 * (-0.1238 - (0.3728)) else if fn <= 0.75 ? -0.1238 + (fn - 0.70) / 0.05 * (0.7726 - (-0.1238)) else 0.7726;
        attribute a2 : Real = if fn <= 0.20 ? -0.0086 + (fn - 0.15) / 0.05 * (-0.0064 - (-0.0086)) else if fn <= 0.25 ? -0.0064 + (fn - 0.20) / 0.05 * (0.0031 - (-0.0064)) else if fn <= 0.30 ? 0.0031 + (fn - 0.25) / 0.05 * (0.0337 - (0.0031)) else if fn <= 0.35 ? 0.0337 + (fn - 0.30) / 0.05 * (0.0446 - (0.0337)) else if fn <= 0.40 ? 0.0446 + (fn - 0.35) / 0.05 * (-0.125 - (0.0446)) else if fn <= 0.45 ? -0.125 + (fn - 0.40) / 0.05 * (-0.2945 - (-0.125)) else if fn <= 0.50 ? -0.2945 + (fn - 0.45) / 0.05 * (-0.3038 - (-0.2945)) else if fn <= 0.55 ? -0.3038 + (fn - 0.50) / 0.05 * (-0.2361 - (-0.3038)) else if fn <= 0.60 ? -0.2361 + (fn - 0.55) / 0.05 * (-0.296 - (-0.2361)) else if fn <= 0.65 ? -0.296 + (fn - 0.60) / 0.05 * (-0.3667 - (-0.296)) else if fn <= 0.70 ? -0.3667 + (fn - 0.65) / 0.05 * (-0.2026 - (-0.3667)) else if fn <= 0.75 ? -0.2026 + (fn - 0.70) / 0.05 * (0.504 - (-0.2026)) else 0.504;
        attribute a3 : Real = if fn <= 0.20 ? -0.0015 + (fn - 0.15) / 0.05 * (0.007 - (-0.0015)) else if fn <= 0.25 ? 0.007 + (fn - 0.20) / 0.05 * (-0.0021 - (0.007)) else if fn <= 0.30 ? -0.0021 + (fn - 0.25) / 0.05 * (-0.0285 - (-0.0021)) else if fn <= 0.35 ? -0.0285 + (fn - 0.30) / 0.05 * (-0.1091 - (-0.0285)) else if fn <= 0.40 ? -0.1091 + (fn - 0.35) / 0.05 * (0.0273 - (-0.1091)) else if fn <= 0.45 ? 0.0273 + (fn - 0.40) / 0.05 * (0.2485 - (0.0273)) else if fn <= 0.50 ? 0.2485 + (fn - 0.45) / 0.05 * (0.6033 - (0.2485)) else if fn <= 0.55 ? 0.6033 + (fn - 0.50) / 0.05 * (0.8726 - (0.6033)) else if fn <= 0.60 ? 0.8726 + (fn - 0.55) / 0.05 * (0.9661 - (0.8726)) else if fn <= 0.65 ? 0.9661 + (fn - 0.60) / 0.05 * (1.3957 - (0.9661)) else if fn <= 0.70 ? 1.3957 + (fn - 0.65) / 0.05 * (1.1282 - (1.3957)) else if fn <= 0.75 ? 1.1282 + (fn - 0.70) / 0.05 * (1.7867 - (1.1282)) else 1.7867;
        attribute a4 : Real = if fn <= 0.20 ? 0.0061 + (fn - 0.15) / 0.05 * (0.0014 - (0.0061)) else if fn <= 0.25 ? 0.0014 + (fn - 0.20) / 0.05 * (-0.007 - (0.0014)) else if fn <= 0.30 ? -0.007 + (fn - 0.25) / 0.05 * (-0.0367 - (-0.007)) else if fn <= 0.35 ? -0.0367 + (fn - 0.30) / 0.05 * (-0.0707 - (-0.0367)) else if fn <= 0.40 ? -0.0707 + (fn - 0.35) / 0.05 * (-0.1341 - (-0.0707)) else if fn <= 0.45 ? -0.1341 + (fn - 0.40) / 0.05 * (-0.2428 - (-0.1341)) else if fn <= 0.50 ? -0.2428 + (fn - 0.45) / 0.05 * (-0.043 - (-0.2428)) else if fn <= 0.55 ? -0.043 + (fn - 0.50) / 0.05 * (0.4219 - (-0.043)) else if fn <= 0.60 ? 0.4219 + (fn - 0.55) / 0.05 * (0.6123 - (0.4219)) else if fn <= 0.65 ? 0.6123 + (fn - 0.60) / 0.05 * (1.0343 - (0.6123)) else if fn <= 0.70 ? 1.0343 + (fn - 0.65) / 0.05 * (1.1836 - (1.0343)) else if fn <= 0.75 ? 1.1836 + (fn - 0.70) / 0.05 * (2.1934 - (1.1836)) else 2.1934;
        attribute a5 : Real = if fn <= 0.20 ? 0.001 + (fn - 0.15) / 0.05 * (0.0013 - (0.001)) else if fn <= 0.25 ? 0.0013 + (fn - 0.20) / 0.05 * (0.0148 - (0.0013)) else if fn <= 0.30 ? 0.0148 + (fn - 0.25) / 0.05 * (0.0218 - (0.0148)) else if fn <= 0.35 ? 0.0218 + (fn - 0.30) / 0.05 * (0.0914 - (0.0218)) else if fn <= 0.40 ? 0.0914 + (fn - 0.35) / 0.05 * (0.3578 - (0.0914)) else if fn <= 0.45 ? 0.3578 + (fn - 0.40) / 0.05 * (0.6293 - (0.3578)) else if fn <= 0.50 ? 0.6293 + (fn - 0.45) / 0.05 * (0.8332 - (0.6293)) else if fn <= 0.55 ? 0.8332 + (fn - 0.50) / 0.05 * (0.899 - (0.8332)) else if fn <= 0.60 ? 0.899 + (fn - 0.55) / 0.05 * (0.7534 - (0.899)) else if fn <= 0.65 ? 0.7534 + (fn - 0.60) / 0.05 * (0.323 - (0.7534)) else if fn <= 0.70 ? 0.323 + (fn - 0.65) / 0.05 * (0.4973 - (0.323)) else if fn <= 0.75 ? 0.4973 + (fn - 0.70) / 0.05 * (-1.5479 - (0.4973)) else -1.5479;
        attribute a6 : Real = if fn <= 0.20 ? 0.0001 + (fn - 0.15) / 0.05 * (0.0005 - (0.0001)) else if fn <= 0.25 ? 0.0005 + (fn - 0.20) / 0.05 * (0.001 - (0.0005)) else if fn <= 0.30 ? 0.001 + (fn - 0.25) / 0.05 * (0.0015 - (0.001)) else if fn <= 0.35 ? 0.0015 + (fn - 0.30) / 0.05 * (0.0021 - (0.0015)) else if fn <= 0.40 ? 0.0021 + (fn - 0.35) / 0.05 * (0.0045 - (0.0021)) else if fn <= 0.45 ? 0.0045 + (fn - 0.40) / 0.05 * (0.0081 - (0.0045)) else if fn <= 0.50 ? 0.0081 + (fn - 0.45) / 0.05 * (0.0106 - (0.0081)) else if fn <= 0.55 ? 0.0106 + (fn - 0.50) / 0.05 * (0.0096 - (0.0106)) else if fn <= 0.60 ? 0.0096 + (fn - 0.55) / 0.05 * (0.01 - (0.0096)) else if fn <= 0.65 ? 0.01 + (fn - 0.60) / 0.05 * (0.0072 - (0.01)) else if fn <= 0.70 ? 0.0072 + (fn - 0.65) / 0.05 * (0.0038 - (0.0072)) else if fn <= 0.75 ? 0.0038 + (fn - 0.70) / 0.05 * (-0.0115 - (0.0038)) else -0.0115;
        attribute a7 : Real = if fn <= 0.20 ? 0.0052 + (fn - 0.15) / 0.05 * (-0.002 - (0.0052)) else if fn <= 0.25 ? -0.002 + (fn - 0.20) / 0.05 * (-0.0043 - (-0.002)) else if fn <= 0.30 ? -0.0043 + (fn - 0.25) / 0.05 * (-0.0172 - (-0.0043)) else if fn <= 0.35 ? -0.0172 + (fn - 0.30) / 0.05 * (-0.0078 - (-0.0172)) else if fn <= 0.40 ? -0.0078 + (fn - 0.35) / 0.05 * (0.1115 - (-0.0078)) else if fn <= 0.45 ? 0.1115 + (fn - 0.40) / 0.05 * (0.2086 - (0.1115)) else if fn <= 0.50 ? 0.2086 + (fn - 0.45) / 0.05 * (0.1336 - (0.2086)) else if fn <= 0.55 ? 0.1336 + (fn - 0.50) / 0.05 * (-0.2272 - (0.1336)) else if fn <= 0.60 ? -0.2272 + (fn - 0.55) / 0.05 * (-0.3352 - (-0.2272)) else if fn <= 0.65 ? -0.3352 + (fn - 0.60) / 0.05 * (-0.4632 - (-0.3352)) else if fn <= 0.70 ? -0.4632 + (fn - 0.65) / 0.05 * (-0.4477 - (-0.4632)) else if fn <= 0.75 ? -0.4477 + (fn - 0.70) / 0.05 * (-0.0977 - (-0.4477)) else -0.0977;
        return result : Real [8] ordered nonunique;
        (a0,a1,a2,a3,a4,a5,a6,a7)
    }
    calc def InputChecks {
        in h : Real [9] ordered nonunique;
        in speed : Real;
        in density : Real;
        in gravity : Real;
        attribute positiveInputs : Real = if h#(1) > 0 and h#(2) > 0 and h#(3) > 0 and h#(4) > 0 and h#(5) > 0 and h#(6) > 0 and h#(7) > 0 and h#(8) > 0 and h#(9) > 0 and speed > 0 and density > 0 and gravity > 0 ? 1.0 else 0.0;
        return result : Real;
        positiveInputs
    }
    calc def Evaluate {
        in h : Real [9] ordered nonunique;
        in speed : Real;
        in density : Real;
        in gravity : Real;
        doc /* h: upright static Lwl, Bwl, canoe-body draft, canoe-body displacement,
         * waterplane area, LCB distance aft of forward perpendicular, LCF distance
         * aft of forward perpendicular, prismatic coefficient, midship coefficient.
         * Lengths metres, area m2, displacement m3; speed m/s, density kg/m3.
         * Caller rejects nonpositive dimensions and any negative domain margin.
         * Negative regression resistance is exposed, never silently clamped. */
        attribute fn : Real = speed / (gravity*h#(1))**0.5;
        attribute a : Real [8] ordered nonunique = Coefficients(fn);
        attribute lcb : Real = h#(6)/h#(1);
        attribute cp : Real = h#(8);
        attribute volumeArea : Real = h#(4)**(2.0/3.0)/h#(5);
        attribute beamLength : Real = h#(2)/h#(1);
        attribute centers : Real = h#(6)/h#(7);
        attribute volumeLength : Real = h#(4)**(1.0/3.0)/h#(1);
        attribute cm : Real = h#(9);
        attribute beamDraft : Real = h#(2)/h#(3);
        attribute ratio : Real = a#(1) + volumeLength * (a#(2)*lcb + a#(3)*cp + a#(4)*volumeArea + a#(5)*beamLength + a#(6)*centers + a#(7)*beamDraft + a#(8)*cm);
        attribute resistance : Real = ratio*density*gravity*h#(4);
        attribute resistance_N : Real = resistance;
        attribute resistance_weight_ratio : Real = ratio;
        attribute froude : Real = fn;
        attribute froude_lower : Real = fn-0.15;
        attribute froude_upper : Real = 0.60-fn;
        attribute lcb_lower : Real = lcb-0.500;
        attribute lcb_upper : Real = 0.582-lcb;
        attribute cp_lower : Real = cp-0.519;
        attribute cp_upper : Real = 0.599-cp;
        attribute volume_area_lower : Real = volumeArea-0.079;
        attribute volume_area_upper : Real = 0.265-volumeArea;
        attribute beam_length_lower : Real = beamLength-0.170;
        attribute beam_length_upper : Real = 0.366-beamLength;
        attribute center_ratio_lower : Real = centers-0.920;
        attribute center_ratio_upper : Real = 1.002-centers;
        attribute volume_length_lower : Real = volumeLength-0.120;
        attribute volume_length_upper : Real = 0.230-volumeLength;
        attribute cm_lower : Real = cm-0.646;
        attribute cm_upper : Real = 0.790-cm;
        attribute beam_draft_lower : Real = beamDraft-2.46;
        attribute beam_draft_upper : Real = 19.38-beamDraft;
        return result : Real [21] ordered nonunique;
        (resistance_N,resistance_weight_ratio,froude,froude_lower,froude_upper,lcb_lower,lcb_upper,cp_lower,cp_upper,volume_area_lower,volume_area_upper,beam_length_lower,beam_length_upper,center_ratio_lower,center_ratio_upper,volume_length_lower,volume_length_upper,cm_lower,cm_upper,beam_draft_lower,beam_draft_upper)
    }
}

package MarineHydrostatics {
    private import ScalarValues::*;
    doc /* Geometry kernel for full-angle static buoyancy. SI metres and cubic
     * metres; points are in world axes with Z up and gravity along -Z.
     * A watertight displacement body is partitioned into nonoverlapping tetrahedra.
     * The external numerical solver supplies pose and solves waterline equilibrium.
     * Flooded voids must be excluded from displacement geometry, not made heavy
     * as well unless retained water is separately trapped. No dynamic recovery claim. */
    calc def Vertex {
        in p : Real [*] ordered nonunique;
        in i : Integer;
        return xyz : Real [3] ordered nonunique;
        if i == 1 ? (p#(1),p#(2),p#(3)) else if i == 2 ? (p#(4),p#(5),p#(6)) else if i == 3 ? (p#(7),p#(8),p#(9)) else (p#(10),p#(11),p#(12))
    }
    calc def Moment {
        in p : Real [12] ordered nonunique;
        attribute ax : Real = p#(4)-p#(1);
        attribute ay : Real = p#(5)-p#(2);
        attribute az : Real = p#(6)-p#(3);
        attribute bx : Real = p#(7)-p#(1);
        attribute byy : Real = p#(8)-p#(2);
        attribute bz : Real = p#(9)-p#(3);
        attribute cx : Real = p#(10)-p#(1);
        attribute cy : Real = p#(11)-p#(2);
        attribute cz : Real = p#(12)-p#(3);
        attribute volume : Real = RealFunctions::abs(ax*(byy*cz-bz*cy)-ay*(bx*cz-bz*cx)+az*(bx*cy-byy*cx))/6;
        return moments : Real [4] ordered nonunique;
        (volume, volume*(p#(1)+p#(4)+p#(7)+p#(10))/4,
            volume*(p#(2)+p#(5)+p#(8)+p#(11))/4,
            volume*(p#(3)+p#(6)+p#(9)+p#(12))/4)
    }
    calc def Intersection {
        in a : Real [3] ordered nonunique;
        in b : Real [3] ordered nonunique;
        in waterline : Real;
        attribute t : Real = (waterline-a#(3))/(b#(3)-a#(3));
        return xyz : Real [3] ordered nonunique;
        (a#(1)+t*(b#(1)-a#(1)), a#(2)+t*(b#(2)-a#(2)), waterline)
    }
    calc def WetMoment {
        in p : Real [12] ordered nonunique;
        in waterline : Real;
        attribute wet : Integer [*] ordered nonunique = (1..4)->ControlFunctions::select { in i : Integer; (Vertex(p,i))#(3) <= waterline };
        attribute dry : Integer [*] ordered nonunique = (1..4)->ControlFunctions::select { in i : Integer; (Vertex(p,i))#(3) > waterline };
        attribute count : Integer = SequenceFunctions::size(wet);
        attribute clipped : Real [4] ordered nonunique = if count == 0 ? (0.0,0.0,0.0,0.0) else
        if count == 4 ? Moment(p) else PartialMoment(p,waterline,(wet,dry),count);
        attribute volume : Real = clipped#(1);
        attribute firstMomentX : Real = clipped#(2);
        attribute firstMomentY : Real = clipped#(3);
        attribute firstMomentZ : Real = clipped#(4);
        return moments : Real [4] ordered nonunique;
        (volume,firstMomentX,firstMomentY,firstMomentZ)
    }
    calc def PartialMoment {
        in p : Real [12] ordered nonunique;
        in waterline : Real;
        in order : Integer [4] ordered nonunique;
        in count : Integer;
        attribute a : Real [3] ordered nonunique = Vertex(p,order#(1));
        attribute b : Real [3] ordered nonunique = Vertex(p,order#(2));
        attribute c : Real [3] ordered nonunique = Vertex(p,order#(3));
        attribute d : Real [3] ordered nonunique = Vertex(p,order#(4));
        return moments : Real [4] ordered nonunique;
        if count == 1 ? Moment((a,Intersection(a,b,waterline),Intersection(a,c,waterline),Intersection(a,d,waterline))) else
        if count == 3 ? Difference(Moment(p),Moment((d,Intersection(d,a,waterline),Intersection(d,b,waterline),Intersection(d,c,waterline)))) else
        TwoWet(a,b,c,d,waterline)
    }
    calc def Difference {
        in a : Real [4] ordered nonunique;
        in b : Real [4] ordered nonunique;
        return values : Real [4] ordered nonunique;
        (a#(1)-b#(1),a#(2)-b#(2),a#(3)-b#(3),a#(4)-b#(4))
    }
    calc def TwoWet {
        in a : Real [3] ordered nonunique;
        in b : Real [3] ordered nonunique;
        in c : Real [3] ordered nonunique;
        in d : Real [3] ordered nonunique;
        in waterline : Real;
        attribute ac : Real [3] ordered nonunique = Intersection(a,c,waterline);
        attribute ad : Real [3] ordered nonunique = Intersection(a,d,waterline);
        attribute bc : Real [3] ordered nonunique = Intersection(b,c,waterline);
        attribute bd : Real [3] ordered nonunique = Intersection(b,d,waterline);
        attribute r1 : Real [4] ordered nonunique = Moment((a,ac,ad,b));
        attribute r2 : Real [4] ordered nonunique = Moment((b,ac,ad,bc));
        attribute r3 : Real [4] ordered nonunique = Moment((b,ad,bc,bd));
        return values : Real [4] ordered nonunique;
        (r1#(1)+r2#(1)+r3#(1),r1#(2)+r2#(2)+r3#(2),r1#(3)+r2#(3)+r3#(3),r1#(4)+r2#(4)+r3#(4))
    }
    calc def MeshMoments {
        in vertices : Real [*] ordered nonunique;
        in waterline : Real;
        in count : Integer;
        attribute rows : Real [*] ordered nonunique = (1..count)->ControlFunctions::collect { in i : Integer;
            WetMoment((1..12)->ControlFunctions::collect { in j : Integer; vertices#(12*(i-1)+j) },waterline) };
        return values : Real [4] ordered nonunique;
        (NumericalFunctions::sum((1..count)->ControlFunctions::collect { in i : Integer; rows#(4*i-3) }),
            NumericalFunctions::sum((1..count)->ControlFunctions::collect { in i : Integer; rows#(4*i-2) }),
            NumericalFunctions::sum((1..count)->ControlFunctions::collect { in i : Integer; rows#(4*i-1) }),
            NumericalFunctions::sum((1..count)->ControlFunctions::collect { in i : Integer; rows#(4*i) }))
    }
    calc def BalanceChecks {
        in massKg : Real;
        in densityKgM3 : Real;
        return positiveMassAndDensity : Real;
        if massKg > 0 and densityKgM3 > 0 ? 1.0 else 0.0
    }
    calc def Balance {
        in moments : Real [4] ordered nonunique;
        in centerOfGravity : Real [3] ordered nonunique;
        in massKg : Real;
        in densityKgM3 : Real;
        attribute g : Real = 9.80665;
        attribute massResidual : Real = densityKgM3*moments#(1)-massKg;
        attribute rollTorque : Real = g*(densityKgM3*moments#(3)-massKg*centerOfGravity#(2));
        attribute pitchTorque : Real = -g*(densityKgM3*moments#(2)-massKg*centerOfGravity#(1));
        return values : Real [3] ordered nonunique;
        (massResidual,rollTorque,pitchTorque)
    }

    calc def BuoyancyMomentSensitivity {
        in displacedVolumeM3 : Real;
        in signedHorizontalLeverM : Real;
        in waterDensityKgM3 : Real;
        return momentNm : Real;
        waterDensityKgM3 * 9.80665 * displacedVolumeM3 * signedHorizontalLeverM
    }
}

package MarinePropulsion {
    private import ScalarValues::*;
    calc def IdealAxialDiskPower {
        doc /* Steady ideal axial actuator disk. Inputs: thrust N, diameter m,
         * fluid density kg/m3 and nonnegative axial inflow m/s. Output W.
         * Excludes swirl/profile losses, installation effects, crossflow,
         * ventilation and cavitation. Callers qualify the operating domain. */
        in thrustN : Real;
        in diameterM : Real;
        in densityKgM3 : Real;
        in axialSpeedMS : Real;
        attribute diskAreaM2 : Real = 3.141592653589793 * diameterM * diameterM / 4;
        attribute inducedSpeed : Real = (-axialSpeedMS + RealFunctions::sqrt(axialSpeedMS * axialSpeedMS + 2 * thrustN / (densityKgM3 * diskAreaM2))) / 2;
        return powerW : Real = thrustN * (axialSpeedMS + inducedSpeed);
    }
}

package MarineRecovery {
    private import ScalarValues::*;
    calc def Segment {
        doc /* SI boundary: distance m, installed through-water speed m/s,
         * along-track current m/s, cross-track current m/s, motor and essential
         * battery withdrawal W, uncertainty multiplier. Output: feasible flag,
         * ground speed m/s, transit s, protected energy Wh.
         * Steady crab-angle compensation, no wave or acceleration model.
         * Speed and power must be valid for the declared casualty state.
         */
        in x : Real [7] ordered nonunique;
        attribute valid : Boolean = x#(1) >= 0 and x#(2) > 0 and x#(5) >= 0 and x#(6) > 0 and x#(7) >= 1;
        attribute authority : Boolean = valid and RealFunctions::abs(x#(4)) < x#(2);
        attribute ground : Real = if authority ? RealFunctions::sqrt(x#(2)*x#(2)-x#(4)*x#(4))+x#(3) else 0;
        attribute feasible : Boolean = authority and ground > 0;
        attribute duration : Real = if feasible ? x#(1)/ground else 0;
        attribute feasibleFlag : Real = if feasible ? 1 else 0;
        attribute protectedEnergy : Real = x#(7)*(x#(5)+x#(6))*duration/3600;
        return result : Real [4] ordered nonunique;
        (feasibleFlag,ground,duration,protectedEnergy)
    }
}

package MarineReliability {
    private import ScalarValues::*;
    calc def ConstantHazardSurvival {
        in ratePerHour : Real;
        in hours : Real;
        return survival : Real = OpenSysMLMathFunctions::exp(-ratePerHour * hours);
    }
    calc def EqualSurvivalRate {
        in survival : Real;
        in hours : Real;
        return ratePerHour : Real = -OpenSysMLMathFunctions::ln(survival) / hours;
    }
    doc /* Constant nonnegative mission-critical hazard, no repair, hours > 0,
     * and 0 < target survival <= 1. NIST Engineering Statistics Handbook,
     * https://itl.nist.gov/div898/handbook/apr/section1/apr161.htm.
     * The calculation does not estimate rates or represent impact/cycle damage. */
}

package MarineSailing {
    private import ScalarValues::*;

    calc def Core {
        in d : Real [29] ordered nonunique;
        in p : Real [41] ordered nonunique;
        in q : Real [*] ordered nonunique;
        in s : Real [9] ordered nonunique;
        in aero : Real [3] ordered nonunique;
        in massData : Real [21] ordered nonunique;
        in hydro : Real [12] ordered nonunique;
        in surface : Real [9] ordered nonunique;
        // enabled, Fx, Fy, air roll moment, signed mast moment, min Va, max |CL|, added resistance, incidence margin
        doc /* s: wind, windward flag, fouling multiplier, speed, wind-from heading,
         * incidence, leeway, rudder angle, heel (angles degrees). hydro:
         * waterline Z, restoring moment, wetted hull area, then nine upright static
         * canoe-body metrics from MarineResistance::Evaluate. aero moment at midchord.
         * Axes and equations preserve the existing body-frame convention. */
        attribute lwl_m : Real = hydro#(4);
        attribute beam_m : Real = d#(2);
        attribute sail_m2 : Real = d#(5);
        attribute sail_AR : Real = d#(6);
        attribute keel_m2 : Real = d#(11);
        attribute keel_span_m : Real = d#(12);
        attribute rudder_m2 : Real = d#(13);
        attribute rudder_span_m : Real = d#(14);
        attribute ballast_kg : Real = d#(16);
        attribute sail_x_fraction : Real = d#(10);
        attribute battery_Wh : Real = d#(17);
        attribute panel_m2 : Real = d#(18);
        attribute rudder_arm_fraction : Real = d#(15);
        attribute g : Real = p#(35);
        attribute rho_air : Real = p#(33);
        attribute rho_water : Real = p#(32);
        attribute rho_ballast : Real = p#(34);
        attribute nu_air : Real = p#(30);
        attribute nu_water : Real = p#(31);
        attribute foil_efficiency : Real = p#(28);
        attribute wing_cd0 : Real = p#(15);
        attribute foil_cd0 : Real = p#(29);
        attribute wing_cl_limit : Real = p#(16);
        attribute foil_cl_limit : Real = p#(27);
        attribute load_factor : Real = p#(36);
        attribute residuary_factor : Real = p#(25);
        attribute viscous_form_factor : Real = p#(26);
        attribute solar_resource_factor : Real = p#(12);
        attribute electronics_W : Real = p#(11);
        attribute foil_alpha_limit_deg : Real = q#(1);
        attribute rudder_inflow_ratio : Real = q#(2);
        attribute hinge_fraction : Real = q#(3);
        attribute friction_Nm : Real = q#(4);
        attribute max_froude : Real = q#(5);
        attribute min_wing_Re : Real = q#(6);
        attribute min_foil_Re : Real = q#(7);
        attribute control_speed_m_s : Real = q#(9);
        attribute control_wind_m_s : Real = q#(10);
        attribute peak_irradiance_W_m2 : Real = q#(11);
        attribute panel_efficiency : Real = q#(12);
        attribute harvest_efficiency : Real = q#(13);
        attribute charge_efficiency : Real = q#(14);
        attribute discharge_efficiency : Real = q#(15);
        attribute usable_fraction : Real = q#(16);
        attribute initial_fraction : Real = q#(17);
        attribute charge_C_rate : Real = q#(18);
        attribute discharge_C_rate : Real = q#(19);
        attribute self_discharge_W : Real = q#(20);
        attribute dark_hours : Real = q#(21);
        attribute solar_hours : Real = q#(22);
        attribute reserve_Wh : Real = q#(23);
        attribute yaw_reserve_Nm : Real = q#(8);
        attribute wind : Real = s#(1);
        attribute upwind : Boolean = s#(2) > 0.5;
        attribute foul : Real = s#(3);
        attribute v : Real = s#(4);
        attribute theta : Real = TrigFunctions::rad(s#(5));
        attribute alpha : Real = TrigFunctions::rad(s#(6));
        attribute beta : Real = TrigFunctions::rad(s#(7));
        attribute delta : Real = TrigFunctions::rad(s#(8));
        attribute heel : Real = TrigFunctions::rad(s#(9));
        attribute cb : Real = TrigFunctions::cos(beta);
        attribute sb : Real = TrigFunctions::sin(beta);
        attribute ch : Real = TrigFunctions::cos(heel);
        attribute wingHeight : Real = RealFunctions::sqrt(sail_m2 * sail_AR);
        attribute wingChord : Real = sail_m2 / wingHeight;
        attribute keelChord : Real = keel_m2 / keel_span_m;
        attribute rudderChord : Real = rudder_m2 / rudder_span_m;
        attribute mass : Real = massData#(1);
        attribute draft : Real = hydro#(1)+d#(3);
        attribute wingZ : Real = d#(4)+wingHeight/2-hydro#(1);
        attribute keelZ : Real = draft+keel_span_m/2;
        attribute rudderZ : Real = draft+rudder_span_m/2;
        attribute righting : Real = hydro#(2);
        attribute awx : Real = wind * TrigFunctions::cos(theta) + v * cb;
        attribute awy : Real = wind * TrigFunctions::sin(theta) - v * sb;
        attribute va : Real = RealFunctions::sqrt(awx * awx + awy * awy);
        attribute qa : Real = 0.5 * rho_air * va * va;
        attribute cl : Real = aero#(1)*p#(17);
        attribute cd : Real = (aero#(2)+p#(15))*p#(18);
        attribute xs : Real = if surface#(1)>0.5 ? surface#(2) else qa * sail_m2 * (cl * ch * awy - cd * awx) / va;
        attribute ys : Real = if surface#(1)>0.5 ? surface#(3) else qa * sail_m2 * (cl * ch * awx + cd * awy) / va;
        attribute drive : Real = xs * cb + ys * sb;
        attribute sideNormal : Real = ys * cb - xs * sb;
        attribute qk : Real = 0.5 * rho_water * v * v;
        attribute qr : Real = qk * rudder_inflow_ratio * rudder_inflow_ratio;
        attribute ark : Real = keel_span_m * keel_span_m / keel_m2;
        attribute arr : Real = rudder_span_m * rudder_span_m / rudder_m2;
        attribute foilAlphaLimit : Real = TrigFunctions::rad(foil_alpha_limit_deg);
        attribute clk : Real = 2 * TrigFunctions::pi / (1 + 2 / (foil_efficiency * ark)) * beta * ch;
        attribute clr : Real = 2 * TrigFunctions::pi / (1 + 2 / (foil_efficiency * arr)) * (beta + delta) * ch;
        attribute lk : Real = qk * keel_m2 * clk * ch;
        attribute lr : Real = qr * rudder_m2 * clr * ch;
        attribute dk : Real = qk * keel_m2 * (foil_cd0 * foul + clk * clk / (TrigFunctions::pi * foil_efficiency * ark));
        attribute dr : Real = qr * rudder_m2 * (foil_cd0 * foul + clr * clr / (TrigFunctions::pi * foil_efficiency * arr));
        attribute fn : Real = v / RealFunctions::sqrt(g * lwl_m);
        attribute hullRe : Real = v * lwl_m / nu_water;
        attribute logRe : Real = OpenSysMLMathFunctions::ln(hullRe) / OpenSysMLMathFunctions::ln(10);
        attribute cf : Real = 0.075 / ((logRe - 2) * (logRe - 2));
        attribute wetted : Real = hydro#(3);
        attribute delft : Real [21] ordered nonunique = MarineResistance::Evaluate((hydro#(4),hydro#(5),hydro#(6),hydro#(7),hydro#(8),hydro#(9),hydro#(10),hydro#(11),hydro#(12)),v,rho_water,g);
        attribute hullDrag : Real = qk * wetted * cf * viscous_form_factor * foul + residuary_factor*delft#(1);
        attribute resistance : Real = hullDrag + dk + dr + surface#(8);
        attribute sailX : Real = sail_x_fraction * d#(1);
        attribute rudderX : Real = -rudder_arm_fraction * d#(1);
        attribute heeling : Real = (if surface#(1)>0.5 ? surface#(4) else ys * wingZ * ch) + ((lk * cb + dk * sb) * keelZ + (lr * cb + dr * sb) * rudderZ + hullDrag * sb * draft / 2) * ch;
        attribute rudderTorque : Real = qr * rudder_m2 * RealFunctions::sqrt(clr * clr + foil_cd0 * foil_cd0) * hinge_fraction * rudderChord + friction_Nm;
        attribute rudderEnvelopeTorque : Real = qr * rudder_m2 * foil_cl_limit * hinge_fraction * rudderChord + friction_Nm;
        attribute waterVMG : Real = (if upwind ? 1 else -1) * v * TrigFunctions::cos(theta + beta);
        attribute wingRe : Real = (if surface#(1)>0.5 ? surface#(6) else va) * wingChord / nu_air;
        attribute keelRe : Real = v * keelChord / nu_water;
        attribute rudderRe : Real = v * rudder_inflow_ratio * rudderChord / nu_water;
        attribute normalCoefficient : Real = cl*TrigFunctions::cos(alpha)+cd*TrigFunctions::sin(alpha);
        attribute mastMomentCoefficient : Real = aero#(3)*q#(24)+((if s#(5)<0 ? 1-d#(9) else d#(9))-0.5)*normalCoefficient;
        attribute wingTorque : Real = if surface#(1)>0.5 ? RealFunctions::abs(surface#(5))+friction_Nm else MarineActuation::MastTorque(rho_air,va,sail_m2,wingChord,mastMomentCoefficient,friction_Nm);
        attribute wingPower : Real [3] ordered nonunique = MarineActuation::DrivePower(wingTorque,p#(19),p#(3),p#(2),p#(4),p#(5),p#(6),p#(7),p#(8));
        attribute rudderPower : Real [3] ordered nonunique = MarineActuation::DrivePower(rudderTorque,p#(20),p#(3),1,1,0.1,p#(9)*rudderTorque,p#(10),1-p#(10));
        attribute averagePower : Real = electronics_W+wingPower#(1)+rudderPower#(1);
        attribute peakPower : Real = electronics_W+wingPower#(2)+rudderPower#(2);
        attribute harvestPower : Real = panel_m2 * peak_irradiance_W_m2 * panel_efficiency * harvest_efficiency * solar_resource_factor;
        attribute nightRate : Real = -averagePower / discharge_efficiency - self_discharge_W;
        attribute dayRate : Real = (if harvestPower >= averagePower ? NumericalFunctions::min((harvestPower - averagePower) * charge_efficiency, charge_C_rate * battery_Wh) else (harvestPower - averagePower) / discharge_efficiency) - self_discharge_W;
        attribute cycleEnergy : Real = dark_hours * nightRate + solar_hours * dayRate;
        attribute reserveMargin : Real = initial_fraction * usable_fraction * battery_Wh + dark_hours * nightRate - reserve_Wh;
        attribute surgeResidual : Real = (drive-resistance)/10;
        attribute swayResidual : Real = (sideNormal-lk-lr)/10;
        attribute yawResidual : Real = (-ys*sailX+(lr*cb+dr*sb)*rudderX-(if surface#(1)>0.5 ? surface#(5) else qa*sail_m2*wingChord*mastMomentCoefficient))/10;
        attribute rollResidual : Real = (righting-heeling)/20;
        attribute wingLiftMargin : Real = if surface#(1)>0.5 ? NumericalFunctions::min(1-surface#(7)/wing_cl_limit,surface#(9)) else 1-RealFunctions::abs(cl)/wing_cl_limit;
        attribute keelLiftMargin : Real = 1-RealFunctions::abs(clk)/foil_cl_limit;
        attribute rudderLiftMargin : Real = 1-RealFunctions::abs(clr)/foil_cl_limit;
        attribute keelAngleMargin : Real = 1-RealFunctions::abs(beta*ch)/foilAlphaLimit;
        attribute rudderAngleMargin : Real = 1-RealFunctions::abs((beta+delta)*ch)/foilAlphaLimit;
        attribute wingDriveMargin : Real = 1-load_factor*wingTorque/d#(19);
        attribute rudderDriveMargin : Real = 1-load_factor*rudderEnvelopeTorque/d#(20);
        attribute froudeMargin : Real = 1-fn/max_froude;
        attribute wingReMargin : Real = wingRe/min_wing_Re-1;
        attribute keelReMargin : Real = keelRe/min_foil_Re-1;
        attribute rudderReMargin : Real = rudderRe/min_foil_Re-1;
        attribute cycleMargin : Real = cycleEnergy/100;
        attribute reserveMarginScaled : Real = reserveMargin/100;
        attribute peakMargin : Real = (discharge_C_rate*battery_Wh-peakPower/discharge_efficiency-self_discharge_W)/100;
        attribute wingResultant : Real = if surface#(1)>0.5 ? RealFunctions::sqrt(xs*xs+ys*ys) else qa*sail_m2*RealFunctions::sqrt(cl*cl+cd*cd);
        attribute keelResultant : Real = RealFunctions::sqrt(lk*lk+dk*dk);
        attribute rudderResultant : Real = RealFunctions::sqrt(lr*lr+dr*dr);
        attribute delftResistanceMargin : Real = delft#(2);
        attribute delftDomain4 : Real = delft#(4);
        attribute delftDomain5 : Real = delft#(5);
        attribute delftDomain6 : Real = delft#(6);
        attribute delftDomain7 : Real = delft#(7);
        attribute delftDomain8 : Real = delft#(8);
        attribute delftDomain9 : Real = delft#(9);
        attribute delftDomain10 : Real = delft#(10);
        attribute delftDomain11 : Real = delft#(11);
        attribute delftDomain12 : Real = delft#(12);
        attribute delftDomain13 : Real = delft#(13);
        attribute delftDomain14 : Real = delft#(14);
        attribute delftDomain15 : Real = delft#(15);
        attribute delftDomain16 : Real = delft#(16);
        attribute delftDomain17 : Real = delft#(17);
        attribute delftDomain18 : Real = delft#(18);
        attribute delftDomain19 : Real = delft#(19);
        attribute delftDomain20 : Real = delft#(20);
        attribute delftDomain21 : Real = delft#(21);
        return result : Real [*] ordered nonunique;
        (surgeResidual, swayResidual, yawResidual, rollResidual, wingLiftMargin, keelLiftMargin, rudderLiftMargin, keelAngleMargin, rudderAngleMargin, wingDriveMargin, rudderDriveMargin, froudeMargin, wingReMargin, keelReMargin, rudderReMargin, cycleMargin, reserveMarginScaled, peakMargin, waterVMG, v, cl, cd, clk, clr, drive, resistance, heeling, righting, wingTorque, rudderTorque, averagePower, peakPower, harvestPower, cycleEnergy, reserveMargin, wingRe, keelRe, rudderRe, ys, lk, lr, hullDrag, dk, dr, wingResultant, keelResultant, rudderResultant, delftResistanceMargin, delftDomain4, delftDomain5, delftDomain6, delftDomain7, delftDomain8, delftDomain9, delftDomain10, delftDomain11, delftDomain12, delftDomain13, delftDomain14, delftDomain15, delftDomain16, delftDomain17, delftDomain18, delftDomain19, delftDomain20, delftDomain21)
    }

    calc def Evaluate {
        in d : Real [29] ordered nonunique;
        in p : Real [41] ordered nonunique;
        in q : Real [*] ordered nonunique;
        in s : Real [9] ordered nonunique;
        in aero : Real [3] ordered nonunique;
        in massData : Real [21] ordered nonunique;
        in hydro : Real [12] ordered nonunique;
        return result : Real [*] ordered nonunique;
        Core(d,p,q,s,aero,massData,hydro,(hydro#(1)*0,hydro#(1)*0,hydro#(1)*0,hydro#(1)*0,hydro#(1)*0,hydro#(1)*0,hydro#(1)*0,hydro#(1)*0,hydro#(1)*0))
    }
    calc def InputChecks {
        doc /* Executable numerical preconditions shared by scalar and batch
         * operating evaluation. Each output is one for valid, zero otherwise. */
        in p : Real [41] ordered nonunique;
        in s : Real [9] ordered nonunique;
        in hydro : Real [12] ordered nonunique;
        attribute driveEfficiencies : Real = if p#(2) > 0 and p#(2) <= 1 and p#(3) > 0 and p#(3) <= 1 ? 1.0 else 0.0;
        attribute wingDuty : Real = if p#(7) >= 0 and p#(8) >= 0 and p#(7)+p#(8) <= 1.000000000001 ? 1.0 else 0.0;
        attribute rudderDuty : Real = if p#(10) >= 0 and p#(10) <= 1 ? 1.0 else 0.0;
        attribute positiveSpeed : Real = if s#(4) > 0 ? 1.0 else 0.0;
        attribute positiveWettedArea : Real = if hydro#(3) > 0 ? 1.0 else 0.0;
        return result : Real [5] ordered nonunique;
        (driveEfficiencies,wingDuty,rudderDuty,positiveSpeed,positiveWettedArea)
    }
}

package MarineSurface {
    private import ScalarValues::*;
    doc /* SI magnitudes. Neutral log profile and strip quadrature are a first
     * surface-layer screen, not a stability-corrected wave boundary-layer model.
     * Wave resistance is an explicitly uncalibrated sensitivity coefficient.
     * Deep-water wave/current action transport assumes slow spatial variation;
     * a uniform river current is not itself a shoaling transition. */
    calc def WindSample {
        in x : Real [9] ordered nonunique;
        // reference wind, reference height, roughness, sample height, heading,
        // vessel speed, leeway (radians), shear enabled, minimum valid height.
        attribute height : Real = NumericalFunctions::max(x#(4),x#(9));
        attribute ratio : Real = if x#(8)>0.5 ? OpenSysMLMathFunctions::ln(height/x#(3))/OpenSysMLMathFunctions::ln(x#(2)/x#(3)) else 1;
        attribute ax : Real = x#(1)*ratio*TrigFunctions::cos(x#(5))+x#(6)*TrigFunctions::cos(x#(7));
        attribute ay : Real = x#(1)*ratio*TrigFunctions::sin(x#(5))-x#(6)*TrigFunctions::sin(x#(7));
        attribute speed : Real = RealFunctions::sqrt(ax*ax+ay*ay);
        attribute heightMargin : Real = x#(4)/x#(9)-1;
        return result : Real [5] ordered nonunique;
        (ratio,ax,ay,speed,heightMargin)
    }
    calc def StripLoad {
        in x : Real [10] ordered nonunique;
        // rho, strip area, apparent x/y, heel rad, height above mean water,
        // CL, CD, chord, signed mast moment coefficient.
        attribute va : Real = RealFunctions::sqrt(x#(3)*x#(3)+x#(4)*x#(4));
        attribute pressureArea : Real = 0.5*x#(1)*va*va*x#(2);
        attribute xs : Real = pressureArea*(x#(7)*TrigFunctions::cos(x#(5))*x#(4)-x#(8)*x#(3))/va;
        attribute ys : Real = pressureArea*(x#(7)*TrigFunctions::cos(x#(5))*x#(3)+x#(8)*x#(4))/va;
        attribute rollMoment : Real = ys*x#(6);
        attribute mastMoment : Real = pressureArea*x#(9)*x#(10);
        return result : Real [4] ordered nonunique;
        (xs,ys,rollMoment,mastMoment)
    }
    calc def FetchSea {
        in x : Real [3] ordered nonunique;
        // reference 10 m wind, effective fetch, gravity; SMB deep-water growth.
        attribute wind : Real = NumericalFunctions::max(x#(1),0.1);
        attribute fetch : Real = x#(3)*x#(2)/(wind*wind);
        attribute hArg : Real = 0.0125*OpenSysMLMathFunctions::exp(0.42*OpenSysMLMathFunctions::ln(fetch));
        attribute tArg : Real = 0.077*OpenSysMLMathFunctions::exp(0.25*OpenSysMLMathFunctions::ln(fetch));
        attribute hTanh : Real = (1-OpenSysMLMathFunctions::exp(-2*hArg))/(1+OpenSysMLMathFunctions::exp(-2*hArg));
        attribute tTanh : Real = (1-OpenSysMLMathFunctions::exp(-2*tArg))/(1+OpenSysMLMathFunctions::exp(-2*tArg));
        attribute height : Real = if x#(1)>0 ? 0.283*wind*wind/x#(3)*hTanh else 0;
        attribute period : Real = NumericalFunctions::max(1,2*TrigFunctions::pi*1.2*wind/x#(3)*tTanh);
        return result : Real [2] ordered nonunique;
        (height,period)
    }
    calc def SpeedRetention {
        in x : Real [2] ordered nonunique;
        // Added resistance and calm-water resistance at the solved state.
        // Local R ~ V^2 and unchanged available thrust: sensitivity, not a VPP.
        attribute ratio : Real = RealFunctions::sqrt(NumericalFunctions::max(0,1-x#(1)/x#(2)));
        return result : Real [1] ordered nonunique;
        (ratio)
    }
    calc def WaveScreen {
        in x : Real [13] ordered nonunique;
        // incident Hs, absolute period, current along propagation, L, B,
        // water-relative speed, cos(wave-to minus heading), resistance coeff,
        // freeboard, wing-root height, appendage-tip immersion, g, rho.
        attribute omega : Real = 2*TrigFunctions::pi/x#(2);
        attribute discriminant : Real = x#(12)+4*x#(3)*omega;
        attribute root : Real = RealFunctions::sqrt(NumericalFunctions::max(discriminant,0.000001));
        attribute sqrtK : Real = 2*omega/(root+RealFunctions::sqrt(x#(12)));
        attribute k : Real = sqrtK*sqrtK;
        attribute sigma : Real = RealFunctions::sqrt(x#(12)*k);
        attribute groupSpeed : Real = 0.5*RealFunctions::sqrt(x#(12)/k);
        attribute absoluteGroup : Real = groupSpeed+x#(3);
        attribute incidentGroup : Real = x#(12)/(2*omega);
        attribute height : Real = x#(1)*RealFunctions::sqrt(sigma*incidentGroup/(omega*NumericalFunctions::max(absoluteGroup,0.000001)));
        attribute wavelength : Real = 2*TrigFunctions::pi/k;
        attribute encounter : Real = RealFunctions::abs(sigma-k*x#(6)*x#(7));
        attribute coupling : Real = NumericalFunctions::min(1,k*k*x#(4)*x#(4));
        attribute resistance : Real = x#(8)*x#(13)*x#(12)*x#(5)*height*height/16*coupling*(0.25+0.375*(1-x#(7)));
        attribute blockingMargin : Real = discriminant/x#(12);
        attribute steepnessMargin : Real = 0.1-height/wavelength;
        attribute hullClearance : Real = x#(9)-height;
        attribute wingClearance : Real = x#(10)-height;
        attribute appendageImmersion : Real = x#(11)-height;
        return result : Real [9] ordered nonunique;
        (height,wavelength,encounter,resistance,blockingMargin,steepnessMargin,hullClearance,wingClearance,appendageImmersion)
    }
    calc def HarmonicResponse {
        in x : Real [7] ordered nonunique;
        // Wave amplitude, wavenumber, signed encounter frequency, phase,
        // relative propagation heading, heave gain, slope gain. Wave phase
        // increases as k*x - omega*t; pitch is rotation about body +y.
        attribute a : Real = x#(1);
        attribute phase : Real = x#(4);
        attribute slope : Real = -a*x#(2)*TrigFunctions::sin(phase)*x#(7);
        attribute slopeRate : Real = a*x#(2)*x#(3)*TrigFunctions::cos(phase)*x#(7);
        attribute heave : Real = a*TrigFunctions::cos(phase)*x#(6);
        attribute pitch : Real = -slope*TrigFunctions::cos(x#(5));
        attribute roll : Real = slope*TrigFunctions::sin(x#(5));
        attribute heaveRate : Real = a*x#(3)*TrigFunctions::sin(phase)*x#(6);
        attribute pitchRate : Real = -slopeRate*TrigFunctions::cos(x#(5));
        attribute rollRate : Real = slopeRate*TrigFunctions::sin(x#(5));
        return result : Real [6] ordered nonunique;
        (heave,pitch,roll,heaveRate,pitchRate,rollRate)
    }
}

package MarineWavePerformance {
    private import ScalarValues::*;
    calc def OrbitalVelocity {
        in x : Real [7] ordered nonunique;
        // amplitude, k, intrinsic omega, depth z<=0, phase, direction, gravity.
        attribute decay : Real = OpenSysMLMathFunctions::exp(x#(2)*NumericalFunctions::min(x#(4),0));
        attribute scale : Real = x#(1)*x#(3)*decay;
        attribute vx : Real = scale*TrigFunctions::cos(x#(5))*TrigFunctions::cos(x#(6));
        attribute vy : Real = scale*TrigFunctions::cos(x#(5))*TrigFunctions::sin(x#(6));
        attribute vz : Real = scale*TrigFunctions::sin(x#(5));
        return result : Real [3] ordered nonunique;
        (vx,vy,vz)
    }
    calc def FoilLoad {
        in x : Real [12] ordered nonunique;
        // rho, area, span, relative speed, incidence rad, heel rad,
        // efficiency, profile Cd, fouling, CL limit, alpha limit rad, wet fraction.
        attribute ar : Real = x#(3)*x#(3)/x#(2);
        attribute cl : Real = 2*TrigFunctions::pi/(1+2/(x#(7)*ar))*x#(5)*TrigFunctions::cos(x#(6));
        attribute pressure : Real = 0.5*x#(1)*x#(4)*x#(4)*x#(2)*x#(12);
        attribute lift : Real = pressure*cl*TrigFunctions::cos(x#(6));
        attribute drag : Real = pressure*(x#(8)*x#(9)+cl*cl/(TrigFunctions::pi*x#(7)*ar));
        attribute liftMargin : Real = 1-RealFunctions::abs(cl)/x#(10);
        attribute angleMargin : Real = 1-RealFunctions::abs(x#(5)*TrigFunctions::cos(x#(6)))/x#(11);
        return result : Real [4] ordered nonunique;
        (lift,drag,liftMargin,angleMargin)
    }
    calc def ImpedanceTerm {
        in x : Real [6] ordered nonunique;
        // encounter omega, rigid mass, added mass, stiffness, radiation damping, extra damping.
        attribute realPart : Real = x#(4)-x#(1)*x#(1)*(x#(2)+x#(3));
        attribute imaginaryPart : Real = -x#(1)*(x#(5)+x#(6));
        return result : Real [2] ordered nonunique;
        (realPart,imaginaryPart)
    }
    calc def BalanceCorrection {
        in x : Real [12] ordered nonunique;
        // baseline four normalized residuals; old/new total appendage drag,
        // old/new total lift; old/new water yaw moment; old/new water roll moment.
        attribute surgeResidual : Real = x#(1)+(x#(5)-x#(6))/10;
        attribute swayResidual : Real = x#(2)+(x#(7)-x#(8))/10;
        attribute yawResidual : Real = x#(3)+(x#(10)-x#(9))/10;
        attribute rollResidual : Real = x#(4)+(x#(11)-x#(12))/20;
        return result : Real [4] ordered nonunique;
        (surgeResidual,swayResidual,yawResidual,rollResidual)
    }
    calc def Actuation {
        in p : Real [41] ordered nonunique;
        in q : Real [*] ordered nonunique;
        in x : Real [3] ordered nonunique;
        // Wing torque, rudder torque, battery Wh; same duty model as Core.
        attribute wing : Real [3] ordered nonunique = MarineActuation::DrivePower(x#(1),p#(19),p#(3),p#(2),p#(4),p#(5),p#(6),p#(7),p#(8));
        attribute rudder : Real [3] ordered nonunique = MarineActuation::DrivePower(x#(2),p#(20),p#(3),1,1,0.1,p#(9)*x#(2),p#(10),1-p#(10));
        attribute peak : Real = p#(11)+wing#(2)+rudder#(2);
        attribute averagePower : Real = p#(11)+wing#(1)+rudder#(1);
        attribute peakMargin : Real = (q#(19)*x#(3)-peak/q#(15)-q#(20))/100;
        return result : Real [3] ordered nonunique;
        (averagePower,peak,peakMargin)
    }
}

package MarineWeather {
    private import ScalarValues::*;
    calc def TwoRegimeCoverage {
        in eastProbability : Real;
        in westPass : Boolean;
        in eastPass : Boolean;
        return coverage : Real;
        (1-eastProbability)*(if westPass ? 1 else 0) + eastProbability*(if eastPass ? 1 else 0)
    }
    calc def ConditionalPassageHours {
        in eastProbability : Real;
        in westPass : Boolean;
        in eastPass : Boolean;
        in westHours : Real;
        in eastHours : Real;
        attribute coverage : Real = TwoRegimeCoverage(eastProbability,westPass,eastPass);
        return hours : Real;
        if coverage > 0 ? ((1-eastProbability)*(if westPass ? westHours else 0) + eastProbability*(if eastPass ? eastHours else 0))/coverage else 0
    }
    doc /* Arithmetic for two mutually exclusive full-passage regime hypotheses.
     * Caller must validate 0<=p<=1, finite nonnegative times for passing cases,
     * and report coverage=0 as no conditional time (not a zero-hour passage).
     * Station hourly direction fractions are not full-passage probabilities.
     * Coverage is a route-screen sensitivity, not system reliability. */
}

package InlandExtended {
    doc /* Reusable U.S. Inland Rules interpretation. Supplied facts and candidate checks are conditional assessments, not established legal compliance. The mission navigation adapter consumes the pair assessment; equipment and other obligations remain separately assessed.*/
    private import ScalarValues::*;
    enum def Truth { yes; no; unknown; }
    enum def Mode { sail; power; rowing; towingAstern; pushing; towed; pushed; trawling; fishing; nuc; ram; dredging; diving; mineClearance; pilot; seaplane; wig; airCushion; mooredBarge; }
    enum def Side { portSide; starboardSide; ahead; aft; unresolved; }
    part context;
    analysis def General {
        doc /* Rules 1-8. Candidate-action and evidence checks, not a sensor estimator or safe-speed optimizer. Judgment inputs require external evidence; no universal CPA/time/turn threshold is invented. Rule 4 applies general duties in all visibility. Rule 3 definitions are externally classified facts. Rule 2 departure requires assessed necessity, never a blanket emergency exemption.*/
        subject encounter;
        in attribute factsKnown : Boolean;
        in attribute inlandWaters : Boolean;
        in attribute jurisdictionReviewed : Boolean;
        in attribute localProvisionsSatisfied : Boolean;
        in attribute visualLookout : Boolean;
        in attribute hearingLookout : Boolean;
        in attribute appropriateMeansUsed : Boolean;
        in attribute radarOperational : Boolean;
        in attribute radarLongRangeUsed : Boolean;
        in attribute radarPlottingUsed : Boolean;
        in attribute visibilityReviewed : Boolean;
        in attribute trafficDensityReviewed : Boolean;
        in attribute maneuverabilityReviewed : Boolean;
        in attribute backgroundLightsReviewed : Boolean;
        in attribute weatherCurrentReviewed : Boolean;
        in attribute draftDepthReviewed : Boolean;
        in attribute radarLimitsReviewed : Boolean;
        in attribute positiveAction : Boolean;
        in attribute earlyAction : Boolean;
        in attribute substantialAction : Boolean;
        in attribute noNewCloseQuarters : Boolean;
        in attribute safePassingDistance : Boolean;
        in attribute effectivenessMonitored : Boolean;
        in attribute finallyClear : Boolean;
        in attribute speedReductionNecessary : Boolean;
        in attribute speedReduced : Boolean;
        in attribute immediateDanger : Boolean;
        in attribute departureNecessary : Boolean;
        in attribute departureLimitedToNecessity : Boolean;
        in attribute specialCircumstancesReviewed : Boolean;
        in attribute riskAssessment : InlandExtended::Truth;
        in attribute approaching : Boolean;
        in attribute bearingSteady : Boolean;
        in attribute largeTowOrCloseRange : Boolean;
        in attribute otherRiskEvidence : Boolean;
        out attribute rule1Applicable : Boolean = inlandWaters;
        out attribute rule2DepartureAssessmentSupported : Boolean = factsKnown and immediateDanger and departureNecessary and departureLimitedToNecessity and specialCircumstancesReviewed;
        out attribute rule5Supported : Boolean = factsKnown and visualLookout and hearingLookout and appropriateMeansUsed;
        out attribute rule6Supported : Boolean = factsKnown and visibilityReviewed and trafficDensityReviewed and maneuverabilityReviewed and backgroundLightsReviewed and weatherCurrentReviewed and draftDepthReviewed and (not radarOperational or radarLimitsReviewed);
        out attribute rule7RiskPresent : Boolean = riskAssessment != Truth::no or (approaching and bearingSteady) or otherRiskEvidence;
        out attribute rule7FurtherAppraisalRequired : Boolean = not factsKnown or (largeTowOrCloseRange and approaching) or (radarOperational and (not radarLongRangeUsed or not radarPlottingUsed));
        out attribute rule8MonitorRequired : Boolean = not finallyClear;
        out attribute rule8CandidateSupported : Boolean = factsKnown and positiveAction and earlyAction and substantialAction and noNewCloseQuarters and safePassingDistance and (finallyClear or effectivenessMonitored) and (not speedReductionNecessary or speedReduced);
        out attribute assessmentSupported : Boolean = inlandWaters and jurisdictionReviewed and localProvisionsSatisfied and rule5Supported and rule6Supported and not rule7FurtherAppraisalRequired and rule8CandidateSupported;
        out attribute completeComplianceEstablished : Boolean = false;
    }
    analysis def ChannelsAndTSS {
        doc /* Rules 8(f), 9 and 10. River encounter priority is in Assess; signal exchanges are in Signals. A necessary maintenance/cable exemption is a supplied, clause-limited determination: tssSupported is not overall compliance, and exemptionScopeReviewRequired remains true. Facts about legally designated schemes and geography require authoritative review.*/
        subject encounter;
        in attribute factsKnown : Boolean;
        in attribute channel : Boolean;
        in attribute ownSailing : Boolean;
        in attribute ownFishing : Boolean;
        in attribute otherConfined : Boolean;
        in attribute otherNavigatingChannel : Boolean;
        in attribute crossingChannel : Boolean;
        in attribute crossingImpede : Boolean;
        in attribute followingChannel : Boolean;
        in attribute safePracticableStarboardEdge : Boolean;
        in attribute nearObscuredBend : Boolean;
        in attribute caution : Boolean;
        in attribute bendSignal : Boolean;
        in attribute anchors : Boolean;
        in attribute avoidAnchoringPracticable : Boolean;
        in attribute tss : Boolean;
        in attribute usesLane : Boolean;
        in attribute followsFlow : Boolean;
        in attribute clearSeparation : Boolean;
        in attribute joinsLeaves : Boolean;
        in attribute atTermination : Boolean;
        in attribute smallJoinAngle : Boolean;
        in attribute crossesLane : Boolean;
        in attribute crossingAvoidable : Boolean;
        in attribute rightAngleHeading : Boolean;
        in attribute usesInshore : Boolean;
        in attribute canUseLane : Boolean;
        in attribute destinationException : Boolean;
        in attribute immediateDanger : Boolean;
        in attribute entersSeparationZone : Boolean;
        in attribute fishingInZone : Boolean;
        in attribute necessaryMaintenanceExemption : Boolean;
        in attribute necessaryCableExemption : Boolean;
        in attribute nearTermination : Boolean;
        in attribute terminationCaution : Boolean;
        in attribute wideAvoidanceMargin : Boolean;
        in attribute otherFollowingLane : Boolean;
        in attribute otherPower : Boolean;
        in attribute earlySeaRoom : Boolean;
        in attribute providedNonImpediment : Boolean;
        in attribute lengthM : Real;
        out attribute channelNonImpediment : Boolean = channel and (((ownSailing or lengthM < 20) and otherConfined) or (ownFishing and otherNavigatingChannel) or (crossingChannel and otherConfined));
        out attribute channelCrossingProhibited : Boolean = channel and crossingChannel and otherConfined and crossingImpede;
        out attribute channelBendSignalRequired : Boolean = channel and nearObscuredBend;
        out attribute channelAvoidAnchor : Boolean = channel and anchors and avoidAnchoringPracticable;
        out attribute channelSupported : Boolean = factsKnown and lengthM > 0 and not channelCrossingProhibited and not channelAvoidAnchor and (not (channel and followingChannel) or safePracticableStarboardEdge) and (not channelBendSignalRequired or (caution and bendSignal)) and (not channelNonImpediment or (earlySeaRoom and providedNonImpediment));
        out attribute limitedTssExemption : Boolean = necessaryMaintenanceExemption or necessaryCableExemption;
        out attribute inshorePermitted : Boolean = lengthM < 20 or ownSailing or ownFishing or not canUseLane or destinationException or immediateDanger;
        out attribute separationEntryPermitted : Boolean = crossesLane or joinsLeaves or immediateDanger or fishingInZone;
        out attribute tssNonImpediment : Boolean = tss and otherFollowingLane and (ownFishing or ((lengthM < 20 or ownSailing) and otherPower));
        out attribute ordinaryTssGeometrySupported : Boolean = (not usesLane or (followsFlow and clearSeparation and (not joinsLeaves or atTermination or smallJoinAngle))) and (not crossesLane or (not crossingAvoidable and rightAngleHeading)) and (not usesInshore or inshorePermitted) and (not entersSeparationZone or separationEntryPermitted) and (not nearTermination or terminationCaution) and (not anchors or not avoidAnchoringPracticable) and (usesLane or wideAvoidanceMargin);
        out attribute tssSupported : Boolean = factsKnown and lengthM > 0 and (not tss or ((ordinaryTssGeometrySupported or limitedTssExemption) and (not tssNonImpediment or (earlySeaRoom and providedNonImpediment))));
        out attribute exemptionScopeReviewRequired : Boolean = tss and limitedTssExemption;
        out attribute completeComplianceEstablished : Boolean = false;
    }
    analysis def RestrictedVisibility {
        doc /* Rule 19; no stand-on assignment is produced. Candidate restrictions use assessed relative geometry, radar-only acquisition and risk. Port/toward-target avoidance is treated conservatively without an automatic exception; any necessary departure needs separate Rule 2 assessment.*/
        subject encounter;
        in attribute factsKnown : Boolean;
        in attribute inSight : Boolean;
        in attribute inOrNearRestricted : Boolean;
        in attribute radarOnly : Boolean;
        in attribute forwardOfBeam : Boolean;
        in attribute abeamOrAbaft : Boolean;
        in attribute ownOvertaking : Boolean;
        in attribute portTurn : Boolean;
        in attribute towardTargetTurn : Boolean;
        in attribute courseAlteration : Boolean;
        in attribute closeQuarters : Boolean;
        in attribute fogSignalForward : Boolean;
        in attribute cannotAvoidForwardClose : Boolean;
        in attribute minimumSteerageSpeed : Boolean;
        in attribute allWayOffNecessary : Boolean;
        in attribute allWayOff : Boolean;
        in attribute extremeCaution : Boolean;
        in attribute enginePowered : Boolean;
        in attribute enginesReady : Boolean;
        in attribute earlyAvoidance : Boolean;
        in attribute safeSpeedAdapted : Boolean;
        in attribute risk : InlandExtended::Truth;
        out attribute applicable : Boolean = not inSight and inOrNearRestricted;
        out attribute avoidanceRequired : Boolean = applicable and radarOnly and (risk != Truth::no or closeQuarters);
        out attribute avoidPortTurn : Boolean = avoidanceRequired and courseAlteration and forwardOfBeam and not ownOvertaking;
        out attribute avoidTowardTarget : Boolean = avoidanceRequired and courseAlteration and abeamOrAbaft;
        out attribute minimumSpeedRequired : Boolean = applicable and risk != Truth::no and (fogSignalForward or cannotAvoidForwardClose);
        out attribute engineReadinessRequired : Boolean = applicable and enginePowered;
        out attribute candidateSupported : Boolean = factsKnown and (not applicable or (safeSpeedAdapted and (not engineReadinessRequired or enginesReady) and (not avoidanceRequired or earlyAvoidance) and (not avoidPortTurn or not portTurn) and (not avoidTowardTarget or not towardTargetTurn) and (not minimumSpeedRequired or (minimumSteerageSpeed and extremeCaution and (not allWayOffNecessary or allWayOff)))));
        out attribute completeComplianceEstablished : Boolean = false;
    }
    analysis def LightsAndShapes {
        doc /* Rules 20-31. Pattern obligations and size boundaries, not automatic image recognition. Outputs are simultaneous: ordinary/status/anchor/tow supplements must be combined by applicability. Specialized group tow layouts, fishing optional signals and approved alternatives are assessed separately. Rule 28 is reserved in Inland Rules; no constrained-by-draft privilege is invented.*/
        subject encounter;
        in attribute factsKnown : Boolean;
        in attribute night : Boolean;
        in attribute restrictedVisibility : Boolean;
        in attribute lightsCarried : Boolean;
        in attribute lightsDeemedNecessary : Boolean;
        in attribute makingWay : Boolean;
        in attribute underway : Boolean;
        in attribute anchored : Boolean;
        in attribute aground : Boolean;
        in attribute specialAnchorage : Boolean;
        in attribute awayFromNavigation : Boolean;
        in attribute sailAlsoPowered : Boolean;
        in attribute normalSailLightsPracticable : Boolean;
        in attribute chooseSmallSailAlternative : Boolean;
        in attribute chooseSmallPowerAlternative : Boolean;
        in attribute chooseSmallStatusExemption : Boolean;
        in attribute compositeUnit : Boolean;
        in attribute gearBeyond150m : Boolean;
        in attribute divingSmallDisplay : Boolean;
        in attribute obstruction : Boolean;
        in attribute gearRestrictedTowing : Boolean;
        in attribute partiallySubmerged : Boolean;
        in attribute towLightingImpracticable : Boolean;
        in attribute assistanceTow : Boolean;
        in attribute airActivity : Boolean;
        in attribute nonDisplacement : Boolean;
        in attribute mooredProjectsIntoChannel : Boolean;
        in attribute mooredWidthBelow80 : Boolean;
        in attribute groupMoreThanTwoWide : Boolean;
        in attribute groupWidthOver25 : Boolean;
        in attribute mooredParallel : Boolean;
        in attribute shelteredBargeExemption : Boolean;
        in attribute geographicBargeExemption : Boolean;
        in attribute allRequiredDisplaysPresent : Boolean;
        in attribute annexInstallationAccepted : Boolean;
        in attribute otherLightsNonConfusing : Boolean;
        in attribute mode : InlandExtended::Mode;
        in attribute lengthM : Real;
        in attribute towLengthM : Real;
        in attribute towBreadthM : Real;
        in attribute objectLengthM : Real;
        out attribute valid : Boolean = factsKnown and lengthM > 0 and towLengthM >= 0 and towBreadthM >= 0 and objectLengthM >= 0 and not (anchored and aground);
        out attribute displayLights : Boolean = night or (restrictedVisibility and lightsCarried) or lightsDeemedNecessary;
        out attribute displayShapes : Boolean = not night;
        out attribute smallSailAlternative : Boolean = not sailAlsoPowered and (mode == Mode::rowing or (mode == Mode::sail and lengthM < 7 and not normalSailLightsPracticable and chooseSmallSailAlternative));
        out attribute smallPowerAlternative : Boolean = (mode == Mode::power or sailAlsoPowered) and lengthM < 12 and chooseSmallPowerAlternative;
        out attribute smallStatusExemption : Boolean = lengthM < 12 and chooseSmallStatusExemption and mode != Mode::diving;
        out attribute anchorExemption : Boolean = anchored and ((lengthM < 7 and awayFromNavigation) or (lengthM < 20 and specialAnchorage));
        out attribute bargeLightsRequired : Boolean = mode == Mode::mooredBarge and not shelteredBargeExemption and not geographicBargeExemption and not (lengthM < 20 and specialAnchorage) and (mooredProjectsIntoChannel or mooredWidthBelow80 or groupMoreThanTwoWide or groupWidthOver25 or not mooredParallel);
        out attribute ordinaryUnderwayPattern : String = if smallSailAlternative ? "All-round white OR white torch/lantern displayed in time to prevent collision" else if (mode == Mode::sail or mode == Mode::rowing) and not sailAlsoPowered ? "Sidelights and sternlight; under 20 m combined masthead lantern is an option" else if smallPowerAlternative ? "All-round white and sidelights" else if lengthM >= 50 ? "Two masthead lights, sidelights and sternlight" else "Forward masthead, sidelights and sternlight";
        out attribute statusPattern : String = if mode == Mode::trawling ? "Green over white; two cones apexes together; aft higher masthead required at 50 m or more; sidelights/sternlight when making way" else if mode == Mode::fishing ? "Red over white; two cones apexes together; sidelights/sternlight when making way" else if mode == Mode::nuc ? (if smallStatusExemption ? "Rule 27 small-vessel display exemption selected" else "Two red all-round lights; two balls; sidelights/sternlight when making way") else if mode == Mode::ram or mode == Mode::dredging ? (if smallStatusExemption ? "Rule 27 small-vessel display exemption selected" else "Red-white-red all-round; ball-diamond-ball; power underway lights when making way") else if mode == Mode::diving ? (if divingSmallDisplay ? "Red-white-red all-round and rigid code flag A at least 1 m; all-round flag visibility" else "RAM display plus obstruction/passable-side displays when applicable") else if mode == Mode::mineClearance ? (if smallStatusExemption ? "Rule 27 small-vessel display exemption selected" else "Three green all-round lights or three balls in prescribed arrangement; dangerous within 1000 m") else if mode == Mode::pilot ? "White over red; sidelights/sternlight underway; anchor display at anchor" else "No additional status pattern";
        out attribute anchorPattern : String = if mode == Mode::fishing or mode == Mode::trawling ? "Rule 26 fishing display instead of anchor display" else if anchorExemption ? "Anchor display exemption applies" else if anchored or aground ? (if lengthM < 50 ? "One all-round white; anchor ball by day" else "Forward all-round white and lower aft white; anchor ball by day") else "No anchor display";
        out attribute groundingExtraRequired : Boolean = aground and lengthM >= 12;
        out attribute groundingExtraPattern : String = "If practicable: two red all-round lights and three balls";
        out attribute anchorDeckIlluminationRequired : Boolean = anchored and lengthM >= 100;
        out attribute sailMotorConeRequired : Boolean = sailAlsoPowered and lengthM >= 12;
        out attribute outlyingGearDisplayRequired : Boolean = mode == Mode::fishing and gearBeyond150m;
        out attribute outlyingGearPattern : String = "White all-round or cone apex upward toward gear";
        out attribute obstructionDisplayRequired : Boolean = (mode == Mode::dredging or mode == Mode::diving) and obstruction and not smallStatusExemption and not divingSmallDisplay;
        out attribute obstructionPattern : String = "Obstructed side: two red lights/two balls; passable side: two green lights/two diamonds; at anchor use these instead of Rule 30";
        out attribute airSupplement : String = if mode == Mode::airCushion and nonDisplacement ? "All-round flashing yellow" else if mode == Mode::wig and airActivity ? "High-intensity all-round flashing red" else "None";
        out attribute rule31ClosestPossibleRequired : Boolean = (mode == Mode::seaplane or mode == Mode::wig) and not allRequiredDisplaysPresent;
        out attribute rule28Reserved : Boolean = true;
        out attribute mastheadTowStackCount : Integer = if compositeUnit ? 0 else if mode == Mode::towingAstern ? (if towLengthM > 200 ? 3 else 2) else if mode == Mode::pushing ? 2 else 0;
        out attribute longTowDiamondRequired : Boolean = not compositeUnit and towLengthM > 200 and (mode == Mode::towingAstern or mode == Mode::towed);
        out attribute towPattern : String = if compositeUnit ? "Rule 23 power-driven composite unit" else if mode == Mode::towingAstern ? "Vertical masthead stack, sidelights, sternlight, yellow towing light above sternlight; Rule 23 masthead positioning applies" else if mode == Mode::pushing ? "Two masthead lights, sidelights, two towing lights; applicable river alternative requires review" else if mode == Mode::pushed ? "Forward sidelights and special flashing light" else if mode == Mode::towed and partiallySubmerged ? "White all-round outline lights and aft diamond" else if mode == Mode::towed ? "Sidelights and sternlight; alongside/group arrangements require review" else "No tow pattern";
        out attribute partialTowOutlineLightMinimum : Integer = if not partiallySubmerged ? 0 else if towBreadthM < 25 ? 2 else 4;
        out attribute partialTowIntermediateLightsRequired : Boolean = partiallySubmerged and objectLengthM > 100;
        out attribute partialTowMaxLightSpacingM : Real = 100;
        out attribute practicabilityAlternativeReviewRequired : Boolean = towLightingImpracticable or assistanceTow or rule31ClosestPossibleRequired;
        out attribute displayEvidenceSupported : Boolean = valid and allRequiredDisplaysPresent and annexInstallationAccepted and otherLightsNonConfusing and not practicabilityAlternativeReviewRequired;
        out attribute completeComplianceEstablished : Boolean = false;
        out attribute restrictedTowRamDisplayRequired : Boolean = gearRestrictedTowing and not smallStatusExemption;
        out attribute restrictedTowRamPattern : String = "In addition to Rule 24: red-white-red all-round and ball-diamond-ball";
    }
    analysis def Signals {
        doc /* Rules 32-37. Inland signal meanings differ from International maneuver signals. shortToleranceS is an explicit engineering interpretation of about one second. Signals are obligations/due events, not proof they were emitted or heard. Radio agreement removes only applicable passage-whistle duties, not danger/fog signals. Distress selection must be an authorized Annex IV signal; no transmitter is actuated.*/
        subject encounter;
        in attribute factsKnown : Boolean;
        in attribute inSight : Boolean;
        in attribute approaching : Boolean;
        in attribute powerPair : Boolean;
        in attribute underway : Boolean;
        in attribute meetingCrossing : Boolean;
        in attribute withinHalfMile : Boolean;
        in attribute overtaking : Boolean;
        in attribute intendLeaveOnPort : Boolean;
        in attribute intendOvertakeStarboard : Boolean;
        in attribute asternPropulsion : Boolean;
        in attribute passingAgreementReached : Boolean;
        in attribute otherProposalHeard : Boolean;
        in attribute proposalAccepted : Boolean;
        in attribute doubt : Boolean;
        in attribute bendOrObstruction : Boolean;
        in attribute heardBendSignal : Boolean;
        in attribute leavingBerth : Boolean;
        in attribute restrictedVisibility : Boolean;
        in attribute makingWay : Boolean;
        in attribute anchored : Boolean;
        in attribute aground : Boolean;
        in attribute mannedLastTow : Boolean;
        in attribute compositeUnit : Boolean;
        in attribute chooseSmallEfficientAlternative : Boolean;
        in attribute efficientSoundAvailable : Boolean;
        in attribute specialAnchorage : Boolean;
        in attribute pilotDuty : Boolean;
        in attribute distress : Boolean;
        in attribute assistanceRequired : Boolean;
        in attribute distressSignalChosen : Boolean;
        in attribute attentionNeeded : Boolean;
        in attribute attentionSignalNonConfusing : Boolean;
        in attribute attentionDoesNotDazzle : Boolean;
        in attribute signalEquipmentAccepted : Boolean;
        in attribute mode : InlandExtended::Mode;
        in attribute lengthM : Real;
        in attribute elapsedFogSignalS : Real;
        in attribute shortBlastS : Real;
        in attribute shortToleranceS : Real;
        in attribute prolongedBlastS : Real;
        out attribute whistleRequired : Boolean = lengthM >= 12;
        out attribute bellRequired : Boolean = lengthM >= 20;
        out attribute gongRequired : Boolean = lengthM >= 100;
        out attribute efficientSoundRequired : Boolean = lengthM < 12;
        out attribute blastDurationsSupported : Boolean = shortToleranceS >= 0 and shortBlastS >= 1-shortToleranceS and shortBlastS <= 1+shortToleranceS and prolongedBlastS >= 4 and prolongedBlastS <= 6;
        out attribute dangerSignalRequired : Boolean = inSight and approaching and doubt;
        out attribute dangerMinimumShortBlasts : Integer = if dangerSignalRequired ? 5 else 0;
        out attribute maneuverSignalRequired : Boolean = inSight and powerPair and underway and ((meetingCrossing and withinHalfMile) or overtaking) and not passingAgreementReached;
        out attribute maneuverShortBlasts : Integer = if not maneuverSignalRequired ? 0 else if asternPropulsion ? 3 else if overtaking ? (if intendOvertakeStarboard ? 1 else 2) else if intendLeaveOnPort ? 1 else 2;
        out attribute answerSameSignalRequired : Boolean = inSight and powerPair and otherProposalHeard and proposalAccepted and not passingAgreementReached;
        out attribute precautionUntilAgreementRequired : Boolean = inSight and powerPair and otherProposalHeard and not proposalAccepted;
        out attribute prolongedBendSignalRequired : Boolean = bendOrObstruction or heardBendSignal;
        out attribute prolongedDepartureSignalRequired : Boolean = leavingBerth and mode == Mode::power;
        out attribute smallFogAlternative : Boolean = chooseSmallEfficientAlternative and (lengthM < 12 or (lengthM < 20 and (anchored or aground)));
        out attribute fogAnchorExemption : Boolean = anchored and not aground and specialAnchorage and lengthM < 20 and mode != Mode::fishing and mode != Mode::trawling and not legallyRam;
        out attribute fogPattern : String = if not restrictedVisibility ? "None" else if fogAnchorExemption ? "Special anchorage exemption" else if smallFogAlternative ? "Other efficient sound" else if legallyRam or mode == Mode::fishing or mode == Mode::trawling ? "One prolonged then two short" else if aground ? "Anchor bell pattern plus three distinct strokes before and after; gong at 100 m" else if anchored ? "Rapid bell about 5 s; gong about 5 s after bell at 100 m" else if compositeUnit or mode == Mode::power or mode == Mode::pilot or mode == Mode::seaplane or mode == Mode::wig or mode == Mode::airCushion ? (if makingWay ? "One prolonged" else "Two prolonged separated by about 2 s") else if mode == Mode::towed and mannedLastTow ? "One prolonged then three short, after tug when practicable" else if mode == Mode::towed ? "No manned-tow signal duty" else "One prolonged then two short";
        out attribute fogSignalIntervalMaxS : Real = if not restrictedVisibility or fogAnchorExemption or (mode == Mode::towed and not mannedLastTow) ? 0 else if not smallFogAlternative and (anchored or aground) and not legallyRam and mode != Mode::fishing and mode != Mode::trawling ? 60 else 120;
        out attribute fogSignalDue : Boolean = fogSignalIntervalMaxS > 0 and elapsedFogSignalS >= fogSignalIntervalMaxS;
        out attribute pilotIdentityOptionalBlasts : Integer = if pilotDuty ? 4 else 0;
        out attribute distressSignalRequired : Boolean = distress and assistanceRequired;
        out attribute distressSignalMisuse : Boolean = distressSignalChosen and not distressSignalRequired;
        out attribute attentionSignalPermitted : Boolean = attentionNeeded and attentionSignalNonConfusing and attentionDoesNotDazzle;
        out attribute candidateSupported : Boolean = factsKnown and lengthM > 0 and elapsedFogSignalS >= 0 and blastDurationsSupported and signalEquipmentAccepted and (not efficientSoundRequired or efficientSoundAvailable) and (not smallFogAlternative or efficientSoundAvailable) and not distressSignalMisuse and (not distressSignalRequired or distressSignalChosen) and (not attentionNeeded or attentionSignalPermitted);
        out attribute completeComplianceEstablished : Boolean = false;
        out attribute legallyRam : Boolean = mode == Mode::ram or mode == Mode::dredging or mode == Mode::diving;
    }
    enum def LightKind {
        enum masthead;
        enum portSide;
        enum starboardSide;
        enum stern;
        enum towing;
        enum allRoundWhite;
        enum allRoundRed;
        enum allRoundGreen;
        enum specialFlashing;
        enum flashingYellow;
        enum flashingRed;
    }
    enum def Color {
        enum white;
        enum red;
        enum green;
        enum yellow;
    }
    analysis def LightFixture {
        doc /* Rules 21/22 and selected Annex I numerical demands. Color region checks are screening only; optical certification/evidence remains required. Red corner coordinates are ordered around their convex boundary, not read as a self-crossing polygon in table-column order. White uses the stated boundary order. This interpretation requires review against the incorporated CIE standard. Units: m, degrees, nautical miles, candela, flashes/minute.*/
        subject encounter;
        in attribute kind : InlandExtended::LightKind;
        in attribute lengthM : Real;
        in attribute nominalArcDeg : Real;
        in attribute measuredRangeNm : Real;
        in attribute minimumMeasuredIntensityCd : Real;
        in attribute colorX : Real;
        in attribute colorY : Real;
        in attribute flashesPerMinute : Real;
        in attribute factsKnown : Boolean;
        in attribute submergedTow : Boolean;
        in attribute unmannedBarge : Boolean;
        in attribute sailingUnderway : Boolean;
        in attribute horizontalSectorEvidenceAccepted : Boolean;
        in attribute verticalSectorEvidenceAccepted : Boolean;
        in attribute installationPositionEvidenceAccepted : Boolean;
        in attribute screensEvidenceAccepted : Boolean;
        out attribute requiredRangeNm : Real = if submergedTow ? 3 else if kind == LightKind::specialFlashing ? 2 else if kind == LightKind::masthead ? (if lengthM >= 50 ? 6 else if lengthM >= 20 ? 5 else if lengthM >= 12 ? 3 else 2) else if kind == LightKind::portSide or kind == LightKind::starboardSide ? (if lengthM >= 50 ? 3 else if lengthM >= 12 ? 2 else 1) else if lengthM >= 50 ? 3 else 2;
        out attribute requiredArcMinDeg : Real = if kind == LightKind::masthead ? 225 else if kind == LightKind::portSide or kind == LightKind::starboardSide ? 112.5 else if kind == LightKind::stern or kind == LightKind::towing ? 135 else if kind == LightKind::specialFlashing ? 180 else 360;
        out attribute requiredArcMaxDeg : Real = if kind == LightKind::specialFlashing ? 225 else requiredArcMinDeg;
        out attribute requiredColor : InlandExtended::Color = if kind == LightKind::portSide or kind == LightKind::allRoundRed or kind == LightKind::flashingRed ? Color::red else if kind == LightKind::starboardSide or kind == LightKind::allRoundGreen ? Color::green else if kind == LightKind::towing or kind == LightKind::specialFlashing or kind == LightKind::flashingYellow ? Color::yellow else Color::white;
        out attribute minimumIntensityCd : Real = if requiredRangeNm == 1 ? 0.686/0.8 else if requiredRangeNm == 2 ? 0.686*4/(0.8*0.8) else if requiredRangeNm == 3 ? 0.686*9/(0.8*0.8*0.8) else if requiredRangeNm == 5 ? 0.686*25/(0.8*0.8*0.8*0.8*0.8) else 0.686*36/(0.8*0.8*0.8*0.8*0.8*0.8);
        out attribute requiredVerticalOuterDeg : Real = if unmannedBarge ? 0 else if sailingUnderway ? 25 else 7.5;
        out attribute requiredOuterIntensityFraction : Real = if unmannedBarge ? 1 else if sailingUnderway ? 0.5 else 0.6;
        out attribute flashSupported : Boolean = if kind == LightKind::specialFlashing ? flashesPerMinute >= 50 and flashesPerMinute <= 70 else if kind == LightKind::flashingRed or kind == LightKind::flashingYellow ? flashesPerMinute >= 120 else true;
        out attribute whiteChromaticity : Boolean = (((((((0.382 > colorY) != (0.44 > colorY)) and colorX < (0.000000000)*(colorY-0.382)/(0.058000000)+0.525) != (((0.44 > colorY) != (0.348 > colorY)) and colorX < (-0.142000000)*(colorY-0.44)/(-0.092000000)+0.452)) != (((0.348 > colorY) != (0.283 > colorY)) and colorX < (0.000000000)*(colorY-0.348)/(-0.065000000)+0.31)) != (((0.283 > colorY) != (0.382 > colorY)) and colorX < (0.133000000)*(colorY-0.283)/(0.099000000)+0.31))) or (((0.000000000)*(colorY-0.382)-(0.058000000)*(colorX-0.525)) == 0 and colorX >= 0.525 and colorX <= 0.525 and colorY >= 0.382 and colorY <= 0.44) or (((-0.073000000)*(colorY-0.44)-(0.000000000)*(colorX-0.525)) == 0 and colorX >= 0.452 and colorX <= 0.525 and colorY >= 0.44 and colorY <= 0.44) or (((-0.142000000)*(colorY-0.44)-(-0.092000000)*(colorX-0.452)) == 0 and colorX >= 0.31 and colorX <= 0.452 and colorY >= 0.348 and colorY <= 0.44) or (((0.000000000)*(colorY-0.348)-(-0.065000000)*(colorX-0.31)) == 0 and colorX >= 0.31 and colorX <= 0.31 and colorY >= 0.283 and colorY <= 0.348) or (((0.133000000)*(colorY-0.283)-(0.099000000)*(colorX-0.31)) == 0 and colorX >= 0.31 and colorX <= 0.443 and colorY >= 0.283 and colorY <= 0.382) or (((0.082000000)*(colorY-0.382)-(0.000000000)*(colorX-0.443)) == 0 and colorX >= 0.443 and colorX <= 0.525 and colorY >= 0.382 and colorY <= 0.382);
        out attribute greenChromaticity : Boolean = (((((((0.385 > colorY) != (0.723 > colorY)) and colorX < (-0.019000000)*(colorY-0.385)/(0.338000000)+0.028) != (((0.723 > colorY) != (0.511 > colorY)) and colorX < (0.291000000)*(colorY-0.723)/(-0.212000000)+0.009)) != (((0.511 > colorY) != (0.356 > colorY)) and colorX < (-0.097000000)*(colorY-0.511)/(-0.155000000)+0.3)) != (((0.356 > colorY) != (0.385 > colorY)) and colorX < (-0.175000000)*(colorY-0.356)/(0.029000000)+0.203))) or (((-0.019000000)*(colorY-0.385)-(0.338000000)*(colorX-0.028)) == 0 and colorX >= 0.009 and colorX <= 0.028 and colorY >= 0.385 and colorY <= 0.723) or (((0.291000000)*(colorY-0.723)-(-0.212000000)*(colorX-0.009)) == 0 and colorX >= 0.009 and colorX <= 0.3 and colorY >= 0.511 and colorY <= 0.723) or (((-0.097000000)*(colorY-0.511)-(-0.155000000)*(colorX-0.3)) == 0 and colorX >= 0.203 and colorX <= 0.3 and colorY >= 0.356 and colorY <= 0.511) or (((-0.175000000)*(colorY-0.356)-(0.029000000)*(colorX-0.203)) == 0 and colorX >= 0.028 and colorX <= 0.203 and colorY >= 0.356 and colorY <= 0.385);
        out attribute redChromaticity : Boolean = ((-0.020000000)*(colorY-0.32)-(0.000000000)*(colorX-0.68)) >= 0 and ((0.061000000)*(colorY-0.32)-(-0.061000000)*(colorX-0.66)) >= 0 and ((0.014000000)*(colorY-0.259)-(0.006000000)*(colorX-0.721)) >= 0 and ((-0.055000000)*(colorY-0.265)-(0.055000000)*(colorX-0.735)) >= 0;
        out attribute yellowChromaticity : Boolean = ((((((0.382 > colorY) != (0.425 > colorY)) and colorX < (-0.043000000)*(colorY-0.382)/(0.043000000)+0.618) != (((0.425 > colorY) != (0.406 > colorY)) and colorX < (0.000000000)*(colorY-0.425)/(-0.019000000)+0.575)) != (((0.406 > colorY) != (0.382 > colorY)) and colorX < (0.037000000)*(colorY-0.406)/(-0.024000000)+0.575))) or (((0.006000000)*(colorY-0.382)-(0.000000000)*(colorX-0.612)) == 0 and colorX >= 0.612 and colorX <= 0.618 and colorY >= 0.382 and colorY <= 0.382) or (((-0.043000000)*(colorY-0.382)-(0.043000000)*(colorX-0.618)) == 0 and colorX >= 0.575 and colorX <= 0.618 and colorY >= 0.382 and colorY <= 0.425) or (((0.000000000)*(colorY-0.425)-(-0.019000000)*(colorX-0.575)) == 0 and colorX >= 0.575 and colorX <= 0.575 and colorY >= 0.406 and colorY <= 0.425) or (((0.037000000)*(colorY-0.406)-(-0.024000000)*(colorX-0.575)) == 0 and colorX >= 0.575 and colorX <= 0.612 and colorY >= 0.382 and colorY <= 0.406);
        out attribute chromaticitySupported : Boolean = if requiredColor == Color::white ? whiteChromaticity else if requiredColor == Color::red ? redChromaticity else if requiredColor == Color::green ? greenChromaticity else yellowChromaticity;
        out attribute fixtureSupported : Boolean = factsKnown and lengthM > 0 and nominalArcDeg >= requiredArcMinDeg and nominalArcDeg <= requiredArcMaxDeg and measuredRangeNm >= requiredRangeNm and minimumMeasuredIntensityCd >= minimumIntensityCd and chromaticitySupported and chromaticityEvidenceAccepted and flashSupported and horizontalSectorEvidenceAccepted and verticalSectorEvidenceAccepted and installationPositionEvidenceAccepted and screensEvidenceAccepted;
        out attribute completeComplianceEstablished : Boolean = false;
        in attribute chromaticityEvidenceAccepted : Boolean;
    }
    analysis def Installation {
        doc /* Annex I selected installation constraints. Special layouts/high-speed alternatives require reviewed drawings. Small commensurate shape sizes are externally assessed. Applicable hull/gunwale datum must be used. Does not certify every Annex I clause.*/
        subject encounter;
        in attribute lengthM : Real;
        in attribute breadthM : Real;
        in attribute mastheadHeightM : Real;
        in attribute mastheadAboveSidelightsM : Real;
        in attribute aftAboveForwardM : Real;
        in attribute verticalStackSpacingM : Real;
        in attribute lowestStackHeightM : Real;
        in attribute shapeDiameterM : Real;
        in attribute shapeHeightM : Real;
        in attribute shapeSpacingM : Real;
        in attribute forwardSectorCutoffDeg : Real;
        in attribute aftSectorCutoffDeg : Real;
        in attribute allRoundObscuredDeg : Real;
        in attribute factsKnown : Boolean;
        in attribute powered : Boolean;
        in attribute hasTwoMastheads : Boolean;
        in attribute hasVerticalStack : Boolean;
        in attribute towingStack : Boolean;
        in attribute threeLightsEquallySpaced : Boolean;
        in attribute smallShapeReductionAccepted : Boolean;
        in attribute shapeBlack : Boolean;
        in attribute coneOrDiamond : Boolean;
        in attribute anchorLight : Boolean;
        in attribute highSpeedAlternativeClaimed : Boolean;
        in attribute highSpeedAlternativeEvidenceAccepted : Boolean;
        in attribute horizontalPlacementAccepted : Boolean;
        in attribute trimVisibilityAccepted : Boolean;
        out attribute mastheadMinimumHeightM : Real = if lengthM >= 20 ? (if breadthM > 8 ? 8 else if breadthM > 5 ? breadthM else 5) else if lengthM >= 12 ? 2.5 else 0;
        out attribute mastheadHeightSupported : Boolean = not powered or ((not highSpeedAlternativeClaimed and mastheadHeightM >= mastheadMinimumHeightM) or (highSpeedAlternativeClaimed and highSpeedAlternativeEvidenceAccepted));
        out attribute sidelightSeparationSupported : Boolean = not powered or mastheadAboveSidelightsM >= 1;
        out attribute stackSupported : Boolean = not hasVerticalStack or (verticalStackSpacingM >= 1 and threeLightsEquallySpaced and (towingStack or lowestStackHeightM >= (if lengthM >= 20 ? 4 else 2)));
        out attribute shapeSupported : Boolean = shapeBlack and ((lengthM < 20 and smallShapeReductionAccepted) or (shapeDiameterM >= 0.6 and (not coneOrDiamond or shapeHeightM == shapeDiameterM) and shapeSpacingM >= 1.5));
        out attribute sectorCutoffSupported : Boolean = forwardSectorCutoffDeg >= 1 and forwardSectorCutoffDeg <= 3 and aftSectorCutoffDeg <= 5 and aftSectorCutoffDeg >= 0 and (anchorLight or allRoundObscuredDeg <= 6);
        out attribute installationSupported : Boolean = factsKnown and lengthM > 0 and breadthM > 0 and mastheadHeightSupported and sidelightSeparationSupported and stackSupported and shapeSupported and sectorCutoffSupported and (not hasTwoMastheads or aftAboveForwardM >= 2) and horizontalPlacementAccepted and trimVisibilityAccepted;
        out attribute completeComplianceEstablished : Boolean = false;
    }
    analysis def SoundAppliance {
        doc /* Annex III checks for a fitted whistle/bell. Small efficient alternatives are in Signals. Higher sound level is conservatively used at overlapping 450/800 Hz boundaries. Audibility range is not a detection guarantee; gong level needs separate measurement.*/
        subject encounter;
        in attribute lengthM : Real;
        in attribute fundamentalHz : Real;
        in attribute bandHz : Real;
        in attribute measuredBandDb : Real;
        in attribute forward45Db : Real;
        in attribute otherDirectionsDb : Real;
        in attribute listeningPostDb : Real;
        in attribute bellDb : Real;
        in attribute bellDiameterMm : Real;
        in attribute strikerMassFraction : Real;
        in attribute whistleSpacingM : Real;
        in attribute minimumFrequencyDifferenceHz : Real;
        in attribute conformingWhistleFraction : Real;
        in attribute factsKnown : Boolean;
        in attribute directional : Boolean;
        in attribute forwardAligned : Boolean;
        in attribute positioningReviewed : Boolean;
        in attribute combined : Boolean;
        in attribute twoWhistles : Boolean;
        in attribute higherFrequencyConforms : Boolean;
        in attribute simultaneous : Boolean;
        in attribute manualBell : Boolean;
        in attribute corrosionResistant : Boolean;
        in attribute clearTone : Boolean;
        in attribute bellFitted : Boolean;
        in attribute gongFitted : Boolean;
        in attribute gongDistinct : Boolean;
        out attribute minimumFundamentalHz : Real = if lengthM >= 200 ? 70 else if lengthM >= 75 ? 130 else 250;
        out attribute maximumFundamentalHz : Real = if lengthM >= 200 ? 200 else if lengthM >= 75 ? 350 else 700;
        out attribute minimumBandDb : Real = if lengthM >= 200 ? 143 else if lengthM >= 75 ? 138 else if lengthM >= 20 ? 130 else if bandHz <= 450 ? 120 else if bandHz <= 800 ? 115 else 111;
        out attribute bandValid : Boolean = bandHz >= 180*0.99 and bandHz <= (if lengthM >= 20 ? 700*1.01 else 2100*1.01);
        out attribute combinedSupported : Boolean = if combined ? whistleSpacingM <= 100 and simultaneous and minimumFrequencyDifferenceHz >= 10 and (if twoWhistles ? higherFrequencyConforms else conformingWhistleFraction >= 2.0/3.0) else whistleSpacingM <= 100 or not simultaneous;
        out attribute whistleSupported : Boolean = factsKnown and lengthM > 0 and fundamentalHz >= minimumFundamentalHz and fundamentalHz <= maximumFundamentalHz and bandValid and measuredBandDb >= minimumBandDb and forward45Db >= minimumBandDb-4 and otherDirectionsDb >= minimumBandDb-10 and listeningPostDb <= 110 and (not directional or forwardAligned) and positioningReviewed and combinedSupported;
        out attribute bellSupported : Boolean = not bellFitted or (bellDb >= 110 and (lengthM < 20 or bellDiameterMm >= 300) and strikerMassFraction >= 0.03 and manualBell and corrosionResistant and clearTone);
        out attribute lowerExposurePreferred : Boolean = listeningPostDb <= 100;
        out attribute equipmentSupported : Boolean = whistleSupported and bellSupported and (lengthM < 20 or bellFitted) and (lengthM < 100 or (gongFitted and gongDistinct));
        out attribute completeComplianceEstablished : Boolean = false;
    }
    analysis def ExemptionsAndSpecialCases {
        doc /* Rule 38, Rule 18(e/f), Annex IV/V, Parts 89/90. No new-build grandfathering or self-issued certificate. Geography is externally sourced. No supplemental light grants priority. Annex II/Part 85 and Inland Rule 28 are reserved.*/
        subject encounter;
        in attribute factsKnown : Boolean;
        in attribute constructedBefore19801224 : Boolean;
        in attribute legacyRulesSatisfied : Boolean;
        in attribute metricRepositionOnly : Boolean;
        in attribute certificateClaimed : Boolean;
        in attribute certificateIssued : Boolean;
        in attribute certificateStillApplicable : Boolean;
        in attribute certificateOnboard : Boolean;
        in attribute lawEnforcement : Boolean;
        in attribute publicSafetyAuthorized : Boolean;
        in attribute blueLightChosen : Boolean;
        in attribute redYellowChosen : Boolean;
        in attribute supplementalNonInterfering : Boolean;
        in attribute actualMechanicalRigidConnection : Boolean;
        in attribute movesAsOneVessel : Boolean;
        in attribute mooringBuoyFast : Boolean;
        in attribute specialRiverGeographyReviewed : Boolean;
        in attribute greatLakes : Boolean;
        in attribute westernRivers : Boolean;
        in attribute listed8925Water : Boolean;
        in attribute seaplaneOnWater : Boolean;
        in attribute wigFlight : Boolean;
        in attribute wigOnWater : Boolean;
        in attribute collisionRisk : Boolean;
        in attribute distress : Boolean;
        in attribute assistanceRequired : Boolean;
        in attribute authorizedAnnexIVSignal : Boolean;
        in attribute lengthM : Real;
        out attribute rule38Eligible : Boolean = constructedBefore19801224 and legacyRulesSatisfied;
        out attribute rule38RangeColorExemption : Boolean = rule38Eligible and lengthM < 20;
        out attribute rule38MetricRepositionExemption : Boolean = rule38Eligible and metricRepositionOnly;
        out attribute rule38HorizontalMastheadExemption : Boolean = rule38Eligible and lengthM < 150;
        out attribute rule38PowerLightAlternative : Boolean = rule38Eligible and lengthM >= 12 and lengthM < 20;
        out attribute alternativeCertificateSupported : Boolean = certificateClaimed and certificateIssued and certificateStillApplicable and certificateOnboard;
        out attribute blueLightPermitted : Boolean = lawEnforcement and supplementalNonInterfering;
        out attribute redYellowPermitted : Boolean = publicSafetyAuthorized and supplementalNonInterfering;
        out attribute supplementalPriorityGranted : Boolean = false;
        out attribute compositeUnit : Boolean = actualMechanicalRigidConnection and movesAsOneVessel;
        out attribute anchorRulesApplyToMooring : Boolean = mooringBuoyFast;
        out attribute specialRiverRulesApply : Boolean = specialRiverGeographyReviewed and (greatLakes or westernRivers or listed8925Water);
        out attribute seaplaneGeneralKeepClear : Boolean = seaplaneOnWater;
        out attribute wigFlightKeepClear : Boolean = wigFlight;
        out attribute wigSurfacePowerRules : Boolean = wigOnWater;
        out attribute seaplaneEncounterRulesAlsoApply : Boolean = seaplaneOnWater and collisionRisk;
        out attribute distressUseSupported : Boolean = not authorizedAnnexIVSignal or (distress and assistanceRequired);
        out attribute assessmentSupported : Boolean = factsKnown and lengthM > 0 and (not certificateClaimed or alternativeCertificateSupported) and (not blueLightChosen or blueLightPermitted) and (not redYellowChosen or redYellowPermitted) and distressUseSupported;
        out attribute completeComplianceEstablished : Boolean = false;
    }
    analysis def CandidateAssessment {
        doc /* Combines independently evaluated domains for one consistent candidate and observation. Caller supplies native outputs, not manually invented pass flags. No complete compliance verdict. Nonvisual clear-weather contacts remain unsupported for automatic role selection. Multiple fixture/installations must be checked externally; inputs here are their aggregate evidence results.*/
        subject encounter;
        in attribute factsConsistent : Boolean;
        in attribute inSight : Boolean;
        in attribute inOrNearRestricted : Boolean;
        in attribute generalSupported : Boolean;
        in attribute pairwiseSupported : Boolean;
        in attribute restrictedVisibilitySupported : Boolean;
        in attribute channelSupported : Boolean;
        in attribute tssSupported : Boolean;
        in attribute signalsSupported : Boolean;
        in attribute displaySupported : Boolean;
        in attribute fixturesSupported : Boolean;
        in attribute installationSupported : Boolean;
        in attribute soundSupported : Boolean;
        in attribute specialCasesSupported : Boolean;
        in attribute additionalApplicableClausesReviewed : Boolean;
        out attribute candidateSupported : Boolean = factsConsistent and generalSupported and (if inSight ? pairwiseSupported else inOrNearRestricted and restrictedVisibilitySupported) and channelSupported and tssSupported and signalsSupported and displaySupported and fixturesSupported and installationSupported and soundSupported and specialCasesSupported and specialDisplaysSupported and passageProtocolSupported and distressCatalogSupported and additionalApplicableClausesReviewed;
        out attribute completeComplianceEstablished : Boolean = false;
        in attribute specialDisplaysSupported : Boolean;
        in attribute passageProtocolSupported : Boolean;
        in attribute distressCatalogSupported : Boolean;
    }
    analysis def SnapshotConsistency {
        doc /* Reject inconsistent shared facts across independently evaluated domains. This checks representation consistency, not truth or sufficient sensor evidence. All frames must identify the same vessel, encounter, time and candidate externally.*/
        subject encounter;
        in attribute coreLengthM : Real;
        in attribute channelLengthM : Real;
        in attribute lightLengthM : Real;
        in attribute fixtureLengthM : Real;
        in attribute installationLengthM : Real;
        in attribute soundLengthM : Real;
        in attribute signalLengthM : Real;
        in attribute specialLengthM : Real;
        in attribute coreSight : InlandExtended::Truth;
        in attribute coreRisk : InlandExtended::Truth;
        in attribute generalRisk : InlandExtended::Truth;
        in attribute visibilityRisk : InlandExtended::Truth;
        in attribute coreChannel : InlandExtended::Truth;
        in attribute coreConfined : InlandExtended::Truth;
        in attribute coreCrossing : InlandExtended::Truth;
        in attribute coreNavigatingChannel : InlandExtended::Truth;
        in attribute visibilitySight : Boolean;
        in attribute signalSight : Boolean;
        in attribute channel : Boolean;
        in attribute confined : Boolean;
        in attribute crossing : Boolean;
        in attribute navigatingChannel : Boolean;
        in attribute sailAlsoPowered : Boolean;
        in attribute coreKind : String;
        in attribute lightMode : String;
        in attribute signalMode : String;
        out attribute lengthsAgree : Boolean = coreLengthM > 0 and coreLengthM == channelLengthM and coreLengthM == lightLengthM and coreLengthM == fixtureLengthM and coreLengthM == installationLengthM and coreLengthM == soundLengthM and coreLengthM == signalLengthM and coreLengthM == specialLengthM;
        out attribute sightAgrees : Boolean = coreSight != Truth::unknown and (coreSight == Truth::yes) == visibilitySight and visibilitySight == signalSight;
        out attribute channelAgrees : Boolean = coreChannel != Truth::unknown and (coreChannel == Truth::yes) == channel and coreConfined != Truth::unknown and (coreConfined == Truth::yes) == confined and coreCrossing != Truth::unknown and (coreCrossing == Truth::yes) == crossing and coreNavigatingChannel != Truth::unknown and (coreNavigatingChannel == Truth::yes) == navigatingChannel;
        out attribute modeAgrees : Boolean = (if lightMode == "sail" and sailAlsoPowered ? signalMode == "power" else lightMode == signalMode) and ((coreKind == "sailing" and lightMode == "sail" and not sailAlsoPowered) or (coreKind == "power" and (lightMode == "power" or (lightMode == "sail" and sailAlsoPowered))) or (coreKind == "fishing" and (lightMode == "fishing" or lightMode == "trawling")) or (coreKind == "notUnderCommand" and lightMode == "nuc") or (coreKind == "restrictedManeuverability" and (lightMode == "ram" or lightMode == "dredging" or lightMode == "diving")));
        out attribute consistent : Boolean = lengthsAgree and sightAgrees and channelAgrees and modeAgrees and passageAgrees and coreRisk == generalRisk and coreRisk == visibilityRisk and (not generalRiskPresent or coreRisk != Truth::no) and coreRestricted != Truth::unknown and (coreRestricted == Truth::yes) == lightRestricted and lightRestricted == signalRestricted and signalRestricted == visibilityRestricted;
        out attribute completeComplianceEstablished : Boolean = false;
        in attribute generalRiskPresent : Boolean;
        in attribute lightRestricted : Boolean;
        in attribute signalRestricted : Boolean;
        in attribute visibilityRestricted : Boolean;
        in attribute coreRestricted : InlandExtended::Truth;
        in attribute signalExchangeRequired : Boolean;
        in attribute protocolExchangeRequired : Boolean;
        in attribute signalAgreement : Boolean;
        in attribute protocolAgreement : Boolean;
        in attribute coreAgreement : String;
        out attribute passageAgrees : Boolean = (not signalExchangeRequired or protocolExchangeRequired) and signalAgreement == protocolAgreement and (not (coreAgreement == "portToPort" or coreAgreement == "starboardToStarboard") or protocolAgreement);
    }
    analysis def SpecialDisplays {
        doc /* Conditional alternatives/supplements in Rules20,23-27,30-31. Optional fishing lights must be lower and less visible than principal fishing lights. Dimensions, exact geographic applicability and practicability are externally assessed. Outputs are simultaneous applicable pattern supplements, not automatic hardware commands.*/
        subject encounter;
        in attribute factsKnown : Boolean;
        in attribute greatLakes : Boolean;
        in attribute useGreatLakesPowerAlternative : Boolean;
        in attribute regionalPushAlternativeApplicable : Boolean;
        in attribute chooseRegionalPushAlternative : Boolean;
        in attribute combinedSailingLantern : Boolean;
        in attribute optionalRedOverGreen : Boolean;
        in attribute fishingCloseProximity : Boolean;
        in attribute shootingNets : Boolean;
        in attribute haulingNets : Boolean;
        in attribute netFast : Boolean;
        in attribute pairTrawling : Boolean;
        in attribute purseSeine : Boolean;
        in attribute hamperedByGear : Boolean;
        in attribute pushedAhead : Boolean;
        in attribute towedAlongside : Boolean;
        in attribute alongsideBothSides : Boolean;
        in attribute groupTow : Boolean;
        in attribute towImpracticable : Boolean;
        in attribute assistanceTow : Boolean;
        in attribute unableToTowDisplay : Boolean;
        in attribute allPossibleTowIndication : Boolean;
        in attribute bridgePassageLoweringNecessary : Boolean;
        in attribute anchorCornerAlternative : Boolean;
        in attribute mooredBothSides : Boolean;
        in attribute projectingBarge : Boolean;
        in attribute specialBargeExemptionReviewed : Boolean;
        in attribute specialBargeExemption : Boolean;
        in attribute seaplaneFullDisplayImpossible : Boolean;
        in attribute closestPossibleArrangementReviewed : Boolean;
        in attribute optionalFishingSpacingAccepted : Boolean;
        in attribute mode : InlandExtended::Mode;
        in attribute lengthM : Real;
        out attribute greatLakesAlternativeAvailable : Boolean = greatLakes and mode == Mode::power;
        out attribute greatLakesAlternativePattern : String = "All-round white at second masthead position replaces second masthead and sternlight; same minimum range";
        out attribute regionalPushPattern : String = "Sidelights and two towing lights; no masthead lights under applicable regional provision";
        out attribute sailingOptionalPatternPermitted : Boolean = mode == Mode::sail and not combinedSailingLantern;
        out attribute fishingOptionalPattern : String = if not fishingCloseProximity ? "None" else if purseSeine and hamperedByGear ? "Two yellow lights alternate each second, equal light/dark duration" else if mode == Mode::trawling and shootingNets ? "Two white all-round lights vertically" else if mode == Mode::trawling and haulingNets ? "White over red all-round" else if mode == Mode::trawling and netFast ? "Two red all-round lights vertically" else "None";
        out attribute pairTrawlSearchlightOptional : Boolean = fishingCloseProximity and pairTrawling and mode == Mode::trawling;
        out attribute optionalFishingRangeNm : Real = 1;
        out attribute optionalFishingMinSpacingM : Real = 0.9;
        out attribute groupTowPattern : String = if alongsideBothSides ? "Each outboard stern light; one set of forward/outboard sidelights; one special flashing light" else if towedAlongside ? "Sternlight plus forward sidelights and special flashing light" else if pushedAhead ? "Forward sidelights and special flashing light" else if groupTow ? "Treat group as one vessel except both-side alongside arrangement" else "None";
        out attribute bargeCornerPattern : String = if not anchorCornerAlternative ? "Ordinary Rule30 pattern" else if projectingBarge ? "Mark projecting outboard corners" else if mooredBothSides ? "Mark single/group corner extremities" else "Arrangement applicability review";
        out attribute bargeAlternativeRangeNm : Real = 1;
        out attribute bridgeLoweringPermitted : Boolean = bridgePassageLoweringNecessary;
        out attribute displayAlternativeSupported : Boolean = factsKnown and lengthM > 0 and (not useGreatLakesPowerAlternative or greatLakesAlternativeAvailable) and (not chooseRegionalPushAlternative or (regionalPushAlternativeApplicable and mode == Mode::pushing)) and (not optionalRedOverGreen or sailingOptionalPatternPermitted) and (not (towImpracticable or (assistanceTow and unableToTowDisplay)) or allPossibleTowIndication) and (not seaplaneFullDisplayImpossible or closestPossibleArrangementReviewed) and (not specialBargeExemption or specialBargeExemptionReviewed) and (not fishingCloseProximity or optionalFishingSpacingAccepted);
        out attribute completeComplianceEstablished : Boolean = false;
    }
    analysis def PassageProtocol {
        doc /* Rule34 and special river proposal/holding duties. priorAgreement belongs to this same pair and proposed maneuver; expiry/change must clear it. Planned passage protocol does not veto necessary emergency action. Whistle/radio emission and reception are measured inputs.*/
        subject encounter;
        in attribute factsKnown : Boolean;
        in attribute requiredExchange : Boolean;
        in attribute proposalSent : Boolean;
        in attribute proposalReceived : Boolean;
        in attribute ownAgreement : Boolean;
        in attribute otherAgreement : Boolean;
        in attribute doubt : Boolean;
        in attribute maneuverStarted : Boolean;
        in attribute radioAgreement : Boolean;
        in attribute lawfulAlternative : Boolean;
        in attribute riskResolved : Boolean;
        in attribute downboundWithCurrent : Boolean;
        in attribute specialRiverPriority : Boolean;
        in attribute upboundOpposite : Boolean;
        in attribute holdingForPassage : Boolean;
        in attribute mannerAndPlaceProposed : Boolean;
        in attribute signalInitiated : Boolean;
        in attribute bridgePassageComplete : Boolean;
        in attribute loweredLightsRestored : Boolean;
        in attribute priorAgreement : InlandExtended::Truth;
        out attribute currentAgreement : Boolean = factsKnown and not doubt and (radioAgreement or (ownAgreement and otherAgreement and proposalSent and proposalReceived) or priorAgreement == Truth::yes);
        out attribute dangerSignalRequired : Boolean = doubt;
        out attribute precautionRequired : Boolean = requiredExchange and not currentAgreement;
        out attribute proposalRequired : Boolean = specialRiverPriority and downboundWithCurrent;
        out attribute holdRequired : Boolean = specialRiverPriority and upboundOpposite;
        out attribute protocolSupported : Boolean = factsKnown and (not (maneuverStarted and requiredExchange) or currentAgreement or riskResolved) and (not lawfulAlternative or currentAgreement) and (not proposalRequired or (mannerAndPlaceProposed and signalInitiated)) and (not holdRequired or holdingForPassage) and (not bridgePassageComplete or loweredLightsRestored);
        out attribute agreementRetained : Boolean = currentAgreement and not riskResolved;
        out attribute completeComplianceEstablished : Boolean = false;
    }
    analysis def DistressCatalog {
        doc /* Rule37 / Annex IV catalog. No transmitter or pyrotechnic is actuated. Supplemental canvas/dye cannot replace a required recognized distress signal. Detailed radio coding/channel and emission characteristics require protocol evidence.*/
        subject encounter;
        in attribute signalName : String;
        in attribute factsKnown : Boolean;
        in attribute distress : Boolean;
        in attribute assistanceRequired : Boolean;
        in attribute chosen : Boolean;
        in attribute authorizedRadioEquipment : Boolean;
        in attribute supplementalOnly : Boolean;
        in attribute whiteFlashesPerMinute : Real;
        out attribute listedAnnexIVSignal : Boolean = signalName == "minuteExplosive" or signalName == "continuousFog" or signalName == "redStars" or signalName == "SOS" or signalName == "Mayday" or signalName == "NC" or signalName == "squareFlagBall" or signalName == "flames" or signalName == "redFlare" or signalName == "orangeSmoke" or signalName == "raisedArms" or signalName == "DSC" or signalName == "satelliteDistress" or signalName == "EPIRB" or signalName == "survivalRadio" or (signalName == "highIntensityWhite" and whiteFlashesPerMinute >= 50 and whiteFlashesPerMinute <= 70);
        out attribute radioSignal : Boolean = signalName == "Mayday" or signalName == "DSC" or signalName == "satelliteDistress" or signalName == "EPIRB" or signalName == "survivalRadio";
        out attribute supplementalAid : Boolean = signalName == "orangeCanvas" or signalName == "dyeMarker";
        out attribute useSupported : Boolean = factsKnown and (not chosen or (distress and assistanceRequired and ((listedAnnexIVSignal and (not radioSignal or authorizedRadioEquipment)) or (supplementalOnly and supplementalAid))));
        out attribute completeComplianceEstablished : Boolean = false;
    }
}

package InlandNavigationExperiment {
    doc /* Reusable U.S. Inland Rules interpretation. Supplied facts and candidate checks are conditional assessments, not established legal compliance. The mission navigation adapter consumes the pair assessment; equipment and other obligations remain separately assessed.*/
    private import ScalarValues::*;
    enum def Truth { yes; no; unknown; }
    enum def VesselKind { sailing; power; unclassified;
        enum fishing;
        enum notUnderCommand;
        enum restrictedManeuverability;
    }
    enum def Tack { portTack; starboardTack; unresolved; }
    enum def Windward { ownWindward; otherWindward; unresolved; }
    enum def OvertakingMemory { clear; ownDuty; otherDuty; conflicting; }
    enum def EncounterRole { giveWay; standOn; noPairRole; unsupported;
        enum mutualAvoidance;
    }
    enum def Response { monitor; keepClear; holdCourseSpeed; mayAct; shallAct; unresolved; }
    part context;
    analysis def Assess {
        doc /* One stable pair identity at one observation. Call repeatedly with nextMemory from the preceding result; preserve memory on uncertain clearance. Changing vessel identity requires explicit caller reset. Rule 13 memory, Rule 12 roles, Rule 17 escalation and Rule 9 obligations remain distinct. No turn command, CPA threshold, safe-speed calculation or observation classifier is implemented.*/
        subject encounter;
        in attribute inlandProfile : Truth;
        in attribute inSight : Truth {
            doc /* Rule 3(k) visual observability assessed externally. AIS/radar acquisition alone is not sufficient.*/
        }
        in attribute restrictedVisibility : Truth;
        in attribute riskOfCollision : Truth {
            doc /* Rule 7 risk appraisal supplied externally; unknown is treated as risk, not a CPA-based clearance claim.*/
        }
        in attribute ownKind : VesselKind;
        in attribute otherKind : VesselKind;
        in attribute ownExceptionalStatus : Truth {
            doc /* Unresolved or additional status not represented by VesselKind; known fishing, NUC and RAM are now typed VesselKind values. Do not infer status from size or automation.*/
        }
        in attribute otherExceptionalStatus : Truth;
        in attribute unmodeledSpecialCircumstances : Truth {
            doc /* Includes traffic separation, special inland river priority, agreed passages, multi-vessel interactions and Rule 2 circumstances requiring interpretation outside this subset.*/
        }
        in attribute observationsAdequate : Truth;
        in attribute lookoutAdequate : Truth;
        in attribute safeSpeedSupported : Truth;
        in attribute ownTack : Tack;
        in attribute otherTack : Tack;
        in attribute windward : Windward;
        in attribute ownComingUp : Truth;
        in attribute otherComingUp : Truth;
        in attribute ownBearingLowDeg : Real {
            doc /* Lower folded absolute bearing of ownship as seen from the OTHER vessel, measured from its bow, 0..180 degrees; not ownship bearing to target.*/
        }
        in attribute ownBearingHighDeg : Real;
        in attribute otherBearingLowDeg : Real {
            doc /* Lower folded absolute bearing of target as seen from OWNSHIP bow, 0..180 degrees.*/
        }
        in attribute otherBearingHighDeg : Real;
        in attribute declaredOwnOvertakingDoubt : Truth {
            doc /* Independent doubt about being the overtaker. Unknown is treated as unresolved doubt for this experiment; distinguish from known not-overtaking.*/
        }
        in attribute previousMemory : OvertakingMemory {
            doc /* State supplied by caller for this same pair. Native outputs compute the transition; Python only transports it.*/
        }
        in attribute pastAndClear : Truth {
            doc /* Positive evidence that this encounter is finally past and clear; unknown cannot release an overtaking duty.*/
        }
        in attribute otherActionAppropriate : Truth {
            doc /* No means it has become apparent that the give-way vessel is not taking appropriate action; no timer is invented.*/
        }
        in attribute giveWayAloneSufficient : Truth {
            doc /* No means collision cannot be avoided by give-way action alone (Rule 17(b)); unknown does not establish that threshold.*/
        }
        in attribute ownAvoidanceFeasible : Truth;
        in attribute immediateDanger : Truth;
        in attribute channelContext : Truth {
            doc /* Includes approach/crossing of an applicable narrow channel, not only ownship physically inside it.*/
        }
        in attribute otherConfinedToChannel : Truth;
        in attribute ownLengthM : Real;
        in attribute crossingChannel : Truth;
        in attribute crossingWouldImpede : Truth;
        in attribute proceedingAlongChannel : Truth;
        in attribute channelPlanSupported : Truth {
            doc /* External review of practicable starboard-edge navigation, sufficient sea room, signaling and nonimpediment. Not implied by pair role.*/
        }
        out attribute inputBoundsValid : Boolean = ownLengthM > 0 and ownBearingLowDeg >= 0 and ownBearingHighDeg <= 180 and ownBearingLowDeg <= ownBearingHighDeg and otherBearingLowDeg >= 0 and otherBearingHighDeg <= 180 and otherBearingLowDeg <= otherBearingHighDeg {
            doc /* Engineering input contract, not a legal threshold.*/
        }
        out attribute clearanceConflict : Boolean = pastAndClear == Truth::yes and (riskOfCollision != Truth::no or clearanceEvidenceAdequate != Truth::yes) {
            doc /* Engineering consistency check: positive clearance requires adequate independent clearance evidence and a no-risk appraisal before releasing memory.*/
        }
        out attribute riskDeemedPresent : Boolean = riskOfCollision != Truth::no {
            doc /* Rule 7(a): doubt does not establish absence of collision risk.*/
        }
        out attribute ownOvertakingConfirmed : Boolean = inputBoundsValid and ownComingUp == Truth::yes and ownBearingLowDeg > 112.5 {
            doc /* Rule 13(b): 22.5 degrees abaft beam equals 112.5 from bow; strict greater-than.*/
        }
        out attribute ownOvertakingPresumed : Boolean = inputBoundsValid and not ownOvertakingConfirmed and (declaredOwnOvertakingDoubt != Truth::no or (ownComingUp != Truth::no and ownBearingHighDeg > 112.5)) {
            doc /* Rule 13(c) plus engineering interval interpretation: possible overtaking triggers own-duty presumption.*/
        }
        out attribute otherOvertakingConfirmed : Boolean = inputBoundsValid and otherComingUp == Truth::yes and otherBearingLowDeg > 112.5 {
            doc /* Confirmed other-overtaker geometry; uncertainty alone never awards stand-on status.*/
        }
        out attribute otherOvertakingUncertain : Boolean = inputBoundsValid and not otherOvertakingConfirmed and otherComingUp != Truth::no and otherBearingHighDeg > 112.5;
        out attribute ownDutyCandidate : Boolean = previousMemory == OvertakingMemory::ownDuty or ownOvertakingConfirmed or ownOvertakingPresumed;
        out attribute otherDutyCandidate : Boolean = previousMemory == OvertakingMemory::otherDuty or otherOvertakingConfirmed;
        out attribute pairwiseScopeSupported : Boolean = inputBoundsValid and not clearanceConflict and inlandProfile == Truth::yes and inSight == Truth::yes and observationsAdequate == Truth::yes and ownKind != VesselKind::unclassified and otherKind != VesselKind::unclassified and ownExceptionalStatus == Truth::no and otherExceptionalStatus == Truth::no and unmodeledSpecialCircumstances == Truth::no {
            doc /* Conservative experiment scope. Unsupported is not permission to ignore obligations.*/
        }
        out attribute nextMemory : OvertakingMemory = if not inputBoundsValid or clearanceConflict ? previousMemory else if pastAndClear == Truth::yes ? OvertakingMemory::clear else if not pairwiseScopeSupported ? previousMemory else if previousMemory == OvertakingMemory::conflicting or (ownDutyCandidate and otherDutyCandidate) ? OvertakingMemory::conflicting else if ownDutyCandidate ? OvertakingMemory::ownDuty else if otherDutyCandidate ? OvertakingMemory::otherDuty else OvertakingMemory::clear {
            doc /* Rule 13(d). Preserve established duty on lost sight/unknown status; do not acquire new memory from inadequate observations. Conflicting identity/geometry remains unresolved until clearance/reset.*/
        }
        out attribute sailingRole : EncounterRole = if ownKind != VesselKind::sailing or otherKind != VesselKind::sailing ? EncounterRole::unsupported else if ownTack == Tack::portTack and otherTack == Tack::starboardTack ? EncounterRole::giveWay else if ownTack == Tack::starboardTack and otherTack == Tack::portTack ? EncounterRole::standOn else if ownTack == Tack::portTack and otherTack == Tack::unresolved and windward == Windward::otherWindward ? EncounterRole::giveWay else if ownTack != Tack::unresolved and ownTack == otherTack and windward == Windward::ownWindward ? EncounterRole::giveWay else if ownTack != Tack::unresolved and ownTack == otherTack and windward == Windward::otherWindward ? EncounterRole::standOn else EncounterRole::unsupported {
            doc /* Rule 12. Tack and windward side are supplied legal interpretations, not deduced from a kite or symmetric wing.*/
        }
        out attribute role : EncounterRole = if not pairwiseScopeSupported ? EncounterRole::unsupported else if pastAndClear == Truth::yes ? EncounterRole::noPairRole else if nextMemory == OvertakingMemory::conflicting ? EncounterRole::unsupported else if nextMemory == OvertakingMemory::ownDuty ? EncounterRole::giveWay else if nextMemory == OvertakingMemory::otherDuty ? EncounterRole::standOn else if otherOvertakingUncertain ? EncounterRole::unsupported else if not riskDeemedPresent ? EncounterRole::noPairRole else ordinaryRole {
            doc /* Rule 13 takes priority over sailing role. Low current collision risk does not erase active overtaking duty.*/
        }
        out attribute ruleBasis : String = if not pairwiseScopeSupported ? "Insufficient assessed facts or special circumstances" else if nextMemory == OvertakingMemory::ownDuty or nextMemory == OvertakingMemory::otherDuty ? "Rule 13 persistent overtaking" else if not riskDeemedPresent ? "No pair risk reported; general duties remain" else if riverRole != EncounterRole::noPairRole ? "Rules 9/14/15 special inland river provisions" else if ownRule18GiveWay or otherRule18GiveWay ? "Rule 18; channel/TSS obligations independently apply" else if headOnPresumed ? "Rule 14 head-on" else if powerPair and powerEncounter == PowerEncounter::crossing ? "Rule 15 crossing" else "Rule 12 or unresolved encounter";
        out attribute response : Response = if role == EncounterRole::unsupported ? Response::unresolved else if role == EncounterRole::giveWay or role == EncounterRole::mutualAvoidance ? Response::keepClear else if role == EncounterRole::noPairRole ? Response::monitor else if giveWayAloneSufficient == Truth::no ? Response::shallAct else if otherActionAppropriate == Truth::no ? Response::mayAct else if giveWayAloneSufficient == Truth::unknown or otherActionAppropriate == Truth::unknown ? Response::unresolved else Response::holdCourseSpeed {
            doc /* Rules 16/17: optional action and mandatory action are distinct. Emergency review reports need for broader Rule 2 judgment, not permission for arbitrary departure.*/
        }
        out attribute nonImpedimentDuty : Truth = if inlandProfile != Truth::yes or not inputBoundsValid or ownExceptionalStatus != Truth::no or unmodeledSpecialCircumstances != Truth::no ? Truth::unknown else if channelContext == Truth::no ? Truth::no else if channelContext == Truth::unknown ? Truth::unknown else if ownKind == VesselKind::fishing and otherNavigatingChannel == Truth::yes ? Truth::yes else if ownKind == VesselKind::fishing and otherNavigatingChannel == Truth::unknown ? Truth::unknown else if otherConfinedToChannel == Truth::no ? Truth::no else if otherConfinedToChannel == Truth::unknown ? Truth::unknown else if ownLengthM < 20 or ownKind == VesselKind::sailing or crossingChannel == Truth::yes ? Truth::yes else if ownKind == VesselKind::unclassified or crossingChannel == Truth::unknown ? Truth::unknown else Truth::no {
            doc /* Rules 9(b/c/d), independent of pairwise role and instantaneous collision risk. Typed fishing status carries duty toward any vessel navigating the channel, not only channel-confined vessels.*/
        }
        out attribute crossingProhibited : Truth = if inlandProfile != Truth::yes or not inputBoundsValid ? Truth::unknown else if channelContext == Truth::no or crossingChannel == Truth::no or otherConfinedToChannel == Truth::no or crossingWouldImpede == Truth::no ? Truth::no else if channelContext == Truth::yes and crossingChannel == Truth::yes and otherConfinedToChannel == Truth::yes and crossingWouldImpede == Truth::yes ? Truth::yes else Truth::unknown {
            doc /* Rule 9(d); prohibited only when the assessed crossing impedes confined passage. Unknown is not permission to cross.*/
        }
        out attribute starboardEdgeDuty : Truth = if inlandProfile != Truth::yes or unmodeledSpecialCircumstances != Truth::no ? Truth::unknown else if channelContext == Truth::no or proceedingAlongChannel == Truth::no ? Truth::no else if channelContext == Truth::yes and proceedingAlongChannel == Truth::yes ? Truth::yes else Truth::unknown {
            doc /* Rule 9(a)(i): as near as safe and practicable. No geometric edge offset is invented.*/
        }
        out attribute channelObligationsSupported : Boolean = nonImpedimentDuty != Truth::unknown and crossingProhibited == Truth::no and starboardEdgeDuty != Truth::unknown and ((nonImpedimentDuty == Truth::no and starboardEdgeDuty == Truth::no) or channelPlanSupported == Truth::yes) {
            doc /* Engineering readiness check; nonimpediment remains separate and is not erased by stand-on status.*/
        }
        out attribute rule19AssessmentNeeded : Boolean = inSight != Truth::yes and restrictedVisibility != Truth::no {
            doc /* No Rule 19 maneuver logic is implemented; no use of Rule 12/17 role logic for nonvisual encounters.*/
        }
        out attribute selectionSupported : Boolean = pairwiseScopeSupported and candidateDirectionSupported and escalationAssessmentComplete and role != EncounterRole::unsupported and response != Response::unresolved and immediateDanger == Truth::no and lookoutAdequate == Truth::yes and safeSpeedSupported == Truth::yes and channelObligationsSupported and ((response == Response::monitor or response == Response::holdCourseSpeed) or ownAvoidanceFeasible == Truth::yes) {
            doc /* Support for this pairwise assessment only. CandidateAssessment composes other independently evaluated obligations; this flag alone never approves a trajectory or overall compliance.*/
        }
        out attribute emergencyReviewRequired : Boolean = immediateDanger != Truth::no {
            doc /* Rule 2 assessment remains separate from specific duties; no automatic permission to depart from a rule.*/
        }
        out attribute escalationAssessmentComplete : Boolean = role != EncounterRole::standOn or giveWayAloneSufficient != Truth::unknown {
            doc /* Engineering completeness check: a known permission to act does not establish whether action is already mandatory.*/
        }
        out attribute completeComplianceEstablished : Boolean = false {
            doc /* Rules 2, 5-8 require broader assessment; numeric motion, sound/light signals, Rule 18, Rule 19 and special cases are not fully implemented.*/
        }
        in attribute clearanceEvidenceAdequate : InlandNavigationExperiment::Truth {
            doc /* Independent assessment supporting finally-past-and-clear. May be established despite loss of visual contact; it must not default from a vanished or unreliable track.*/
        }
        in attribute powerEncounter : InlandNavigationExperiment::PowerEncounter;
        in attribute targetSide : InlandNavigationExperiment::TargetSide;
        in attribute headOnDoubt : InlandNavigationExperiment::Truth;
        in attribute passageAgreement : InlandNavigationExperiment::PassageAgreement;
        in attribute specialRiverRulesApply : InlandNavigationExperiment::Truth;
        in attribute ownRiverMotion : InlandNavigationExperiment::RiverMotion;
        in attribute otherRiverMotion : InlandNavigationExperiment::RiverMotion;
        in attribute downboundFollowingCurrent : InlandNavigationExperiment::Truth;
        in attribute ownUnderway : InlandNavigationExperiment::Truth;
        in attribute otherUnderway : InlandNavigationExperiment::Truth;
        in attribute portTurnProposed : InlandNavigationExperiment::Truth;
        in attribute crossAheadProposed : InlandNavigationExperiment::Truth;
        in attribute circumstancesAdmit : InlandNavigationExperiment::Truth;
        out attribute powerPair : Boolean = ownKind == VesselKind::power and otherKind == VesselKind::power;
        out attribute headOnPresumed : Boolean = powerPair and (powerEncounter == PowerEncounter::headOn or headOnDoubt != Truth::no);
        out attribute riverRole : InlandNavigationExperiment::EncounterRole = if not powerPair or specialRiverRulesApply == Truth::no ? EncounterRole::noPairRole else if specialRiverRulesApply == Truth::unknown ? EncounterRole::unsupported else if ownRiverMotion == RiverMotion::crossing and (otherRiverMotion == RiverMotion::upbound or otherRiverMotion == RiverMotion::downbound) ? EncounterRole::giveWay else if otherRiverMotion == RiverMotion::crossing and (ownRiverMotion == RiverMotion::upbound or ownRiverMotion == RiverMotion::downbound) ? EncounterRole::standOn else if ownRiverMotion == RiverMotion::upbound and otherRiverMotion == RiverMotion::downbound and downboundFollowingCurrent == Truth::yes ? EncounterRole::giveWay else if ownRiverMotion == RiverMotion::downbound and otherRiverMotion == RiverMotion::upbound and downboundFollowingCurrent == Truth::yes ? EncounterRole::standOn else if ownRiverMotion == RiverMotion::unresolved or otherRiverMotion == RiverMotion::unresolved or downboundFollowingCurrent == Truth::unknown ? EncounterRole::unsupported else EncounterRole::noPairRole;
        out attribute ownRule18GiveWay : Boolean = ((ownKind == VesselKind::power or ownKind == VesselKind::sailing or ownKind == VesselKind::fishing) and (otherKind == VesselKind::notUnderCommand or otherKind == VesselKind::restrictedManeuverability)) or ((ownKind == VesselKind::power or ownKind == VesselKind::sailing) and otherKind == VesselKind::fishing) or (ownKind == VesselKind::power and otherKind == VesselKind::sailing);
        out attribute otherRule18GiveWay : Boolean = ((otherKind == VesselKind::power or otherKind == VesselKind::sailing or otherKind == VesselKind::fishing) and (ownKind == VesselKind::notUnderCommand or ownKind == VesselKind::restrictedManeuverability)) or ((otherKind == VesselKind::power or otherKind == VesselKind::sailing) and ownKind == VesselKind::fishing) or (otherKind == VesselKind::power and ownKind == VesselKind::sailing);
        out attribute ordinaryRole : InlandNavigationExperiment::EncounterRole = if ownUnderway != Truth::yes or otherUnderway != Truth::yes ? EncounterRole::unsupported else if riverRole != EncounterRole::noPairRole ? riverRole else if ownRule18GiveWay ? EncounterRole::giveWay else if otherRule18GiveWay ? EncounterRole::standOn else if powerPair and headOnPresumed ? EncounterRole::mutualAvoidance else if powerPair and powerEncounter == PowerEncounter::crossing and targetSide == TargetSide::starboardSide ? EncounterRole::giveWay else if powerPair and powerEncounter == PowerEncounter::crossing and targetSide == TargetSide::portSide ? EncounterRole::standOn else sailingRole;
        out attribute headOnStarboardRequired : Boolean = role == EncounterRole::mutualAvoidance and (passageAgreement == PassageAgreement::none or passageAgreement == PassageAgreement::portToPort);
        out attribute agreedStarboardPassage : Boolean = role == EncounterRole::mutualAvoidance and passageAgreement == PassageAgreement::starboardToStarboard;
        out attribute rule17PortTurnRestricted : Boolean = powerPair and powerEncounter == PowerEncounter::crossing and role == EncounterRole::standOn and response == Response::mayAct and targetSide == TargetSide::portSide and circumstancesAdmit != Truth::no;
        out attribute crossAheadRestricted : Boolean = powerPair and powerEncounter == PowerEncounter::crossing and role == EncounterRole::giveWay and circumstancesAdmit != Truth::no;
        out attribute candidateDirectionSupported : Boolean = (not headOnStarboardRequired or (portTurnProposed == Truth::no and starboardTurnProposed == Truth::yes)) and (not rule17PortTurnRestricted or portTurnProposed == Truth::no) and (not crossAheadRestricted or crossAheadProposed == Truth::no) and passageAgreement != PassageAgreement::unresolved;
        in attribute otherNavigatingChannel : InlandNavigationExperiment::Truth;
        in attribute starboardTurnProposed : InlandNavigationExperiment::Truth;
    }
    enum def PowerEncounter {
        enum headOn;
        enum crossing;
        enum none;
        enum uncertain;
    }
    enum def TargetSide {
        enum portSide;
        enum starboardSide;
        enum ahead;
        enum astern;
        enum unresolved;
    }
    enum def RiverMotion {
        enum upbound;
        enum downbound;
        enum crossing;
        enum other;
        enum unresolved;
    }
    enum def PassageAgreement {
        enum none;
        enum portToPort;
        enum starboardToStarboard;
        enum unresolved;
    }
}
package MarineMass {
    private import ScalarValues::*;

    calc def MassProperties {
        in d : Real [29] ordered nonunique;
        in p : Real [41] ordered nonunique;
        in m : Real [10] ordered nonunique;
        in geometry : Real [51] ordered nonunique;
        doc /* Four bodies: hull, wing, keel, rudder. Each geometry block is
         * skin area; skin centroid XYZ; enclosed volume; volume centroid XYZ;
         * minimum thin-wall inertia/thickness; worst bending modulus/thickness;
         * root enclosed area; root perimeter. Last three inputs: ballast centroid XYZ. Geometry units are SI.
         * Foil ribs are unperforated transverse diaphragms. Hull ribs follow
         * a surface-density allocation. Neither earns FDM bending credit. */
        attribute seamKgM2 : Real = 2*m#(1)/m#(2)*m#(3)*(1+p#(1));
        attribute hullSkinKg : Real = geometry#(1)*(m#(4)*m#(5)+d#(21)*(1+p#(1))+m#(6)+seamKgM2);
        attribute hullRibVolume : Real = geometry#(1)*2*m#(5)*m#(7)/d#(25);
        attribute hullRibKg : Real = m#(4)*hullRibVolume;
        attribute hullMass : Real = hullSkinKg+hullRibKg;
        attribute hullMaterialVolume : Real = geometry#(1)*(m#(5)+d#(21)/m#(8)+d#(21)*p#(1)/m#(9))+hullRibVolume;
        attribute wingSkinKg : Real = geometry#(13)*(m#(4)*m#(10)+d#(22)*(1+p#(1))+m#(6)+seamKgM2);
        attribute wingRibVolume : Real = geometry#(17)*m#(5)/d#(26);
        attribute wingRibKg : Real = m#(4)*wingRibVolume;
        attribute wingMass : Real = wingSkinKg+wingRibKg;
        attribute wingMaterialVolume : Real = geometry#(13)*(m#(10)+d#(22)/m#(8)+d#(22)*p#(1)/m#(9))+wingRibVolume;
        attribute keelSkinKg : Real = geometry#(25)*(m#(4)*m#(10)+d#(23)*(1+p#(1))+m#(6)+seamKgM2);
        attribute keelRibVolume : Real = geometry#(29)*m#(5)/d#(26);
        attribute keelRibKg : Real = m#(4)*keelRibVolume;
        attribute keelMass : Real = keelSkinKg+keelRibKg;
        attribute keelMaterialVolume : Real = geometry#(25)*(m#(10)+d#(23)/m#(8)+d#(23)*p#(1)/m#(9))+keelRibVolume;
        attribute rudderSkinKg : Real = geometry#(37)*(m#(4)*m#(10)+d#(24)*(1+p#(1))+m#(6)+seamKgM2);
        attribute rudderRibVolume : Real = geometry#(41)*m#(5)/d#(26);
        attribute rudderRibKg : Real = m#(4)*rudderRibVolume;
        attribute rudderMass : Real = rudderSkinKg+rudderRibKg;
        attribute rudderMaterialVolume : Real = geometry#(37)*(m#(10)+d#(24)/m#(8)+d#(24)*p#(1)/m#(9))+rudderRibVolume;
        attribute batteryMass : Real = d#(17)/p#(13);
        attribute panelMass : Real = 2*d#(18);
        attribute wingDriveMass : Real = p#(22)+p#(21)*d#(19);
        attribute rudderDriveMass : Real = 0.08+p#(21)*d#(20);
        attribute equipmentMass : Real = p#(23)+p#(24)+p#(39);
        attribute totalMass : Real = hullMass+wingMass+keelMass+rudderMass+d#(16)+batteryMass+panelMass+wingDriveMass+rudderDriveMass+equipmentMass;
        attribute moment0 : Real = hullSkinKg*geometry#(2)+hullRibKg*geometry#(2)+wingSkinKg*geometry#(14)+wingRibKg*geometry#(18)+keelSkinKg*geometry#(26)+keelRibKg*geometry#(30)+rudderSkinKg*geometry#(38)+rudderRibKg*geometry#(42)+batteryMass*d#(27)*d#(1)+wingDriveMass*d#(10)*d#(1)+-rudderDriveMass*d#(15)*d#(1)+d#(16)*geometry#(49)+p#(39)*p#(40)*d#(1);
        attribute moment1 : Real = hullSkinKg*geometry#(3)+hullRibKg*geometry#(3)+wingSkinKg*geometry#(15)+wingRibKg*geometry#(19)+keelSkinKg*geometry#(27)+keelRibKg*geometry#(31)+rudderSkinKg*geometry#(39)+rudderRibKg*geometry#(43)+d#(16)*geometry#(50);
        attribute moment2 : Real = hullSkinKg*geometry#(4)+hullRibKg*geometry#(4)+wingSkinKg*geometry#(16)+wingRibKg*geometry#(20)+keelSkinKg*geometry#(28)+keelRibKg*geometry#(32)+rudderSkinKg*geometry#(40)+rudderRibKg*geometry#(44)+d#(16)*geometry#(51)+batteryMass*(-d#(3)+(d#(3)+d#(4))*d#(28))+panelMass*d#(4)+-(wingDriveMass+rudderDriveMass+equipmentMass-p#(39))*d#(3)/2+p#(39)*(d#(4)+p#(41));
        attribute cgX : Real = moment0/totalMass;
        attribute cgY : Real = moment1/totalMass;
        attribute cgZ : Real = moment2/totalMass;
        attribute hullLaminateThickness : Real = d#(21)/m#(8)+d#(21)*p#(1)/m#(9);
        attribute wingLaminateThickness : Real = d#(22)/m#(8)+d#(22)*p#(1)/m#(9);
        attribute keelLaminateThickness : Real = d#(23)/m#(8)+d#(23)*p#(1)/m#(9);
        attribute rudderLaminateThickness : Real = d#(24)/m#(8)+d#(24)*p#(1)/m#(9);
        return result : Real [*] ordered nonunique;
        (totalMass, hullMass, wingMass, keelMass, rudderMass, batteryMass, panelMass, wingDriveMass, rudderDriveMass, equipmentMass,
            cgX,cgY,cgZ,hullMaterialVolume,wingMaterialVolume,keelMaterialVolume,rudderMaterialVolume,
            hullLaminateThickness,wingLaminateThickness,keelLaminateThickness,rudderLaminateThickness)
    }

    calc def InputChecks {
        doc /* Executable preconditions for MassProperties. One denotes a valid
         * input group, zero an invalid one. These preserve the numerical adapter's
         * physical domain; they are not vessel acceptance requirements. */
        in d : Real [29] ordered nonunique;
        in p : Real [41] ordered nonunique;
        attribute positiveDimensions : Real = if d#(1) > 0 and d#(2) > 0 and d#(3) > 0 and d#(4) > 0 and d#(5) > 0 and d#(6) > 0 and d#(8) > 0 and d#(11) > 0 and d#(12) > 0 and d#(13) > 0 and d#(14) > 0 and d#(15) > 0 and d#(17) > 0 and d#(18) > 0 and d#(19) > 0 and d#(20) > 0 and d#(21) > 0 and d#(22) > 0 and d#(23) > 0 and d#(24) > 0 and d#(25) > 0 and d#(26) > 0 ? 1.0 else 0.0;
        attribute nonnegativeBallast : Real = if d#(16) >= 0 ? 1.0 else 0.0;
        attribute positiveBatterySpecificEnergy : Real = if p#(13) > 0 ? 1.0 else 0.0;
        attribute nonnegativeResinRatio : Real = if p#(1) >= 0 ? 1.0 else 0.0;
        return result : Real [4] ordered nonunique;
        (positiveDimensions,nonnegativeBallast,positiveBatterySpecificEnergy,nonnegativeResinRatio)
    }
}

package MarineStructures {
    private import ScalarValues::*;
    calc def DesignMargins {
        in d : Real [29] ordered nonunique;
        in p : Real [41] ordered nonunique;
        in m : Real [21] ordered nonunique;
        in g : Real [60] ordered nonunique;
        in r : Real [12] ordered nonunique;
        in loads : Real [3] ordered nonunique;
        in waterline : Real;
        doc /* g extends the mass geometry vector with deck area at 52 and finite-laminate
         * I/Z pairs for hull, wing, keel and rudder at 53 through 60.
         * Inward polygon offsets define the laminate cross section; no thin-wall
         * stiffness extrapolation is used. Global bending uses worst-direction section modulus.
         * Proof-tip, ballast lateral inertia and operating loads are separate maxima.
         * No FDM bending credit; no buckling, fatigue, impact or joint qualification. */
        attribute modulus : Real = r#(1)*p#(14);
        attribute allowable : Real = r#(2)*p#(14);
        attribute hullI : Real = g#(53);
        attribute wingI : Real = g#(55);
        attribute keelI : Real = g#(57);
        attribute rudderI : Real = g#(59);
        attribute wingSpan : Real = RealFunctions::sqrt(d#(5)*d#(6));
        attribute wingForce : Real = loads#(1)*p#(36);
        attribute keelForce : Real = loads#(2)*p#(36);
        attribute rudderForce : Real = loads#(3)*p#(36);
        attribute hullMoment : Real = m#(1)*p#(35)*d#(1)/4;
        attribute wingMoment : Real = NumericalFunctions::max(wingForce/2,r#(4))*wingSpan;
        attribute keelTipForce : Real = NumericalFunctions::max(r#(4),d#(16)*p#(35)*p#(36));
        attribute keelMoment : Real = NumericalFunctions::max(keelForce/2,keelTipForce)*d#(12);
        attribute rudderMoment : Real = NumericalFunctions::max(rudderForce/2,r#(4))*d#(14);
        attribute hullStressMargin : Real = 1-hullMoment/(g#(54)*allowable);
        attribute wingStressMargin : Real = 1-wingMoment/(g#(56)*allowable);
        attribute keelStressMargin : Real = 1-keelMoment/(g#(58)*allowable);
        attribute rudderStressMargin : Real = 1-rudderMoment/(g#(60)*allowable);
        attribute hullDeflectionMargin : Real = 1-5*2*m#(1)*p#(35)*d#(1)*d#(1)/(384*modulus*hullI*r#(9));
        attribute wingDeflectionMargin : Real = 1-NumericalFunctions::max(wingForce/8,r#(4)/3)*wingSpan*wingSpan/(modulus*wingI*r#(8));
        attribute keelDeflectionMargin : Real = 1-NumericalFunctions::max(keelForce/8,keelTipForce/3)*d#(12)*d#(12)/(modulus*keelI*r#(8));
        attribute rudderDeflectionMargin : Real = 1-NumericalFunctions::max(rudderForce/8,r#(4)/3)*d#(14)*d#(14)/(modulus*rudderI*r#(8));
        attribute panelStressMargin : Real = 1-0.75*r#(3)*d#(25)*d#(25)/(m#(18)*m#(18)*allowable);
        attribute panelDeflectionMargin : Real = 1-5*r#(3)*d#(25)*d#(25)*d#(25)/(32*modulus*m#(18)*m#(18)*m#(18)*r#(10));
        attribute bodyAssembly : Real = m#(2)+m#(5)+m#(7)+m#(8)+m#(9)+m#(10);
        attribute bodyHandlingMargin : Real = 1-bodyAssembly/p#(37);
        attribute wingHandlingMargin : Real = 1-m#(3)/p#(37);
        attribute keelHandlingMargin : Real = 1-(m#(4)+d#(16))/p#(37);
        attribute batteryHandlingMargin : Real = 1-m#(6)/p#(37);
        attribute freeboardMargin : Real = (d#(4)-waterline)/r#(5)-1;
        attribute reserveVolumeMargin : Real = p#(32)*g#(5)/((1+r#(6))*m#(1))-1;
        attribute launchDepthMargin : Real = (r#(7)-(waterline-(2*g#(51)+d#(3)+d#(12))))/r#(7);
        attribute panelAreaMargin : Real = p#(38)*g#(52)/d#(18)-1;
        attribute hullPackingMargin : Real = 1-m#(14)/g#(5);
        attribute wingPackingMargin : Real = 1-m#(15)/g#(17);
        attribute keelPackingMargin : Real = 1-m#(16)/g#(29);
        attribute rudderPackingMargin : Real = 1-m#(17)/g#(41);
        attribute appendages : Real [5] ordered nonunique = MarineAppendages::GeometryMargins(d,r#(11),r#(12));
        attribute keelAspectMargin : Real = appendages#(1);
        attribute rudderAspectMargin : Real = appendages#(2);
        attribute keelRootMargin : Real = appendages#(3);
        attribute rudderStockMargin : Real = appendages#(4);
        attribute sweptSeparationMargin : Real = appendages#(5);
        return result : Real [*] ordered nonunique;
        (hullStressMargin,wingStressMargin,keelStressMargin,rudderStressMargin,hullDeflectionMargin,wingDeflectionMargin,keelDeflectionMargin,rudderDeflectionMargin,panelStressMargin,panelDeflectionMargin,bodyHandlingMargin,wingHandlingMargin,keelHandlingMargin,batteryHandlingMargin,freeboardMargin,reserveVolumeMargin,launchDepthMargin,panelAreaMargin,hullPackingMargin,wingPackingMargin,keelPackingMargin,rudderPackingMargin,keelAspectMargin,rudderAspectMargin,keelRootMargin,rudderStockMargin,sweptSeparationMargin)
    }
}

package TransGorgeCourse {
    private import ScalarValues::*;

    part def MarkerGate {
        attribute markerName : String;
        attribute lightListNumber : Integer;
        attribute longitudeDeg : Real;
        attribute latitudeDeg : Real;
        attribute bearingFromMarkerDeg : Real;
        attribute nearOffsetM : Real;
        attribute farOffsetM : Real;
        attribute sourceCell : String;
        attribute sourceEditionUpdate : String;
    }

    part west : MarkerGate {
        attribute :>> markerName = "Bonneville Pool Lighted Buoy 16";
        attribute :>> lightListNumber = 11835;
        attribute :>> longitudeDeg = -121.8676486;
        attribute :>> latitudeDeg = 45.6918586;
        attribute :>> bearingFromMarkerDeg = 0;
        attribute :>> nearOffsetM = 80;
        attribute :>> farOffsetM = 220;
        attribute :>> sourceCell = "US5WA3DK";
        attribute :>> sourceEditionUpdate = "2.0";
        metadata rationale : ModelingMetadata::Rationale { text = "Western rounding mark near Stevenson: NOAA ENC US5WA3DK and USCG LLNR 11835 identify red Lighted Buoy 16. Round to port through north, west and south offset checkpoints in that order. Use the nominal charted position, never contact or attach to the aid. The 80 m exclusion and 220 m checkpoint extent are project allocations, not statutory stand-offs."; }
    }

    part east : MarkerGate {
        attribute :>> markerName = "Bonneville Pool Lighted Buoy 39";
        attribute :>> lightListNumber = 11985;
        attribute :>> longitudeDeg = -121.461773;
        attribute :>> latitudeDeg = 45.7035806;
        attribute :>> bearingFromMarkerDeg = 180;
        attribute :>> nearOffsetM = 80;
        attribute :>> farOffsetM = 220;
        attribute :>> sourceCell = "US5WA3DP";
        attribute :>> sourceEditionUpdate = "2.0";
        metadata rationale : ModelingMetadata::Rationale { text = "Bingen start/finish reference downstream of Bingen Point boat ramp: green Lighted Buoy 39, NOAA ENC US5WA3DP and USCG LLNR 11985. The virtual gate extends south from the nominal charted buoy position. Launch and retrieval at Bingen Point are outside the scored circuit. Confirm the actual buoy and current notices before launch."; }
    }

    part temporaryWorks {
        attribute longitudeDeg : Real = -121.5225;
        attribute latitudeDeg : Real = 45.7283333333;
        attribute screeningRadiusM : Real = 250;
        metadata rationale : ModelingMetadata::Rationale { text = "2026-10-07 Northwest LNM week 40 page 2 locates railroad bridge work at White Salmon confluence, RM 168.2, through 2026-12-31. The derrick barge stays on station outside work hours. Source: https://www.navcen.uscg.gov/sites/default/files/pdf/lnms/lnm13402026.pdf . Exclude a 250 m analysis buffer around the published point for this snapshot."; }
        metadata issue : ModelingMetadata::Issue { text = "The radius is a conservative scenario allocation, not a surveyed work footprint or statutory stand-off. Replace with confirmed work extent and current notices before release; do not silently expire this exclusion using the computer clock."; }
    }
    part bridgePassage {
        attribute spanIdentifier : String = "0226241BDFAB1596";
        attribute closedClearanceM : Real = 20.4;
        attribute horizontalClearanceM : Real = 74.9;
        attribute pierAllowanceM : Real = 10;
        attribute verticalAllowanceM : Real = 2;
        attribute referenceApproachM : Real = 150;
        attribute source : String = "https://www.portofhoodriver.com/bridge-lift-request";
        metadata rationale : ModelingMetadata::Rationale { text = "Select the charted Hood River lifting span, closed, for both legs. ENC US5WA3DP LNAM 0226241BDFAB1596 supplies the polygon and conservative 20.4 m closed clearance; the Port reports 20.42 m at its stated average river height. Adjacent spans without clearance evidence are excluded. No bridge opening is part of the mission. Vertical acceptance subtracts measured pool rise, vessel air draft including motion, and a 2 m project uncertainty allowance from chart clearance. PDR must verify the local stage datum; launch must check current works and pool stage. The 10 m pier allowance is a planning allocation, not a legal stand-off."; }
    }
    part policy {
        attribute coordinateDatum : String = "WGS84 longitude/latitude degrees; bearings clockwise from true north; offsets in meters";
        attribute chartEvidence : String = "evidence/course/2026-10-11/chart-features.geojson";
        attribute sourceCatalog : String = "https://www.charts.noaa.gov/ENCs/ENCProdCat_19115.xml";
        attribute sourceLightList : String = "https://www.navcen.uscg.gov/sites/default/files/pdf/lightLists/weeklyUpdates/v6WeeklyChanges.pdf";
        attribute chartCatalogDate : String = "2026-10-10";
        attribute lightListDate : String = "2026-10-07";
        attribute gatesAcceptedForLaunch : Boolean = false;
        attribute damTransitPermitted : Boolean = false;
        attribute lockApproachTransitPermitted : Boolean = false;
        attribute hasCompletionDeadline : Boolean = false;
        attribute minimumChartDepthM : Real = 2;
        attribute shoreClearanceM : Real = 30;
        attribute restrictionClearanceM : Real = 50;
        attribute obstacleClearanceM : Real = 30;
        attribute routingGridM : Real = 40;
        attribute referenceLegLengthM : Real = 32994.546297358545;
        metadata referenceLengthBasis : ModelingMetadata::Rationale { text = "Half the complete chart-domain reference circuit including the buoy rounding generated from this gate and clearance configuration by tools.boat_analysis.environment.routing. This equivalent leg length preserves full circuit distance in the symmetric sizing calculation; the mission simulation uses the distinct legs. This is a nominal sizing-analysis distance, not a prescribed sailing track; tacks and avoidance increase traveled distance. Regeneration checks this value against the chart-derived route."; }
        metadata routingRationale : ModelingMetadata::Rationale { text = "Initial routing allocations for the small-vessel analysis: chart depth at least 2 m, 30 m from charted land/obstructions and 50 m from excluded charted areas. These are project planning margins, not legal stand-off distances. Actual draft, pool stage, maneuvering, uncertainty and bridge clearances require separate assessment. Grid resolution is a numerical setting, not a vessel requirement."; }
        attribute gateNames : String [5] ordered nonunique = ("eastGate", "westGate", "turnGate", "returnGate", "eastGate");
        attribute gateDirections : Integer [5] ordered nonunique = (-1,1,1,1,1);
        attribute crossingSequence : String = "Cross Bingen gate downstream; pass north, west and south of buoy 16 in order, keeping the buoy to port; cross Bingen gate upstream to finish. Maintain the modeled marker exclusion throughout. Launch and retrieval are outside the scored course.";
        metadata rationale : ModelingMetadata::Rationale { text = "The route stays in Bonneville Pool. Gate segments are defined relative to existing aids, with 80 m minimum nominal marker offset. Chart-derived polygons, water depth and local notices constrain route planning; neither the marker-to-marker chord nor the commercial fairway is the whole permitted sailing corridor. Completion has no elapsed-time deadline. A computational horizon reports censoring rather than failure."; }
        metadata issue : ModelingMetadata::Issue { text = "Gate proposal for mission analysis, not a launch release. Verify complete segment clearance and maneuvering/drift margins, current MSI notices, current pool stage, bridge passage and autonomous traffic avoidance. A route through charted water does not establish safe operation. No universal vessel stand-off distance is inferred from navigation rules."; }
    }
    dependency courseBasis from policy to GorgeChallenge::courseCompletion;

    analysis GateGeometry {
        out attribute bridgeSpanIdentifier : String = bridgePassage.spanIdentifier;
        out attribute bridgePierAllowanceM : Real = bridgePassage.pierAllowanceM;
        out attribute bridgeApproachM : Real = bridgePassage.referenceApproachM;
        out attribute referenceLegLengthM : Real = policy.referenceLegLengthM;
        out attribute temporaryWorks : Real [3] ordered nonunique = (TransGorgeCourse::temporaryWorks.longitudeDeg, TransGorgeCourse::temporaryWorks.latitudeDeg, TransGorgeCourse::temporaryWorks.screeningRadiusM);
        out attribute westGate : Real [5] ordered nonunique = (west.longitudeDeg, west.latitudeDeg, west.bearingFromMarkerDeg, west.nearOffsetM, west.farOffsetM);
        out attribute turnGate : Real [5] ordered nonunique = (west.longitudeDeg, west.latitudeDeg, 270, west.nearOffsetM, west.farOffsetM);
        out attribute returnGate : Real [5] ordered nonunique = (west.longitudeDeg, west.latitudeDeg, 180, west.nearOffsetM, west.farOffsetM);
        out attribute eastGate : Real [5] ordered nonunique = (east.longitudeDeg, east.latitudeDeg, east.bearingFromMarkerDeg, east.nearOffsetM, east.farOffsetM);
        out attribute routing : Real [5] ordered nonunique = (policy.minimumChartDepthM, policy.shoreClearanceM, policy.restrictionClearanceM, policy.obstacleClearanceM, policy.routingGridM);
    }
}

package BlueDogMissionScope {
    private import ScalarValues::*;
    enum def MissionKind { gorge; futureOcean; futureEndurance; }
    metadata def Applicability {
        attribute mission : MissionKind;
    }
    metadata applicability : Applicability about GorgeChallenge::RepeatedOperation {
        mission = MissionKind::futureEndurance;
    }
    part current {
        attribute designObjective : String = "Maximize probability of completing one unassisted sail-only Gorge round trip within a selected weather window";
        attribute requiresOceanQualification : Boolean = false;
        attribute requiresIndefiniteOperation : Boolean = false;
        attribute requiresRepeatableEnergyBalance : Boolean = false;
        attribute hasCompletionDeadline : Boolean = false;
        metadata rationale : ModelingMetadata::Rationale { text = "Owner decision: focus on the finite Gorge challenge. Retain finite battery accounting and reserve protection; no fixed-duration campaign constrains acceptance; no Hawaii route, saltwater profile or indefinite operation constraint is inherited. Passage time, speed-dependent failure exposure and weather-window completion should be compared together. Safety dispositions remain independent launch gates."; }
        metadata issue : ModelingMetadata::Issue { text = "Archived studies retain their original daily-balance screens. Active Gorge sizing uses instantaneous peak-power checks; chronological mission execution must establish finite energy feasibility. Speed/load-dependent failure evidence and a valid planing model remain necessary for comparing hull regimes."; }
    }
    part future {
        attribute designObjective : String = "Define a separate Hawaii mission and persistent-operation capability";
        attribute acceptanceAllocated : Boolean = false;
        metadata rationale : ModelingMetadata::Rationale { text = "Hawaii remains a future mission with independently allocated route, weather, endurance, communications, maintenance and recovery constraints. Existing ocean limits and repeating-energy cases are candidate future studies; they do not constrain Gorge acceptance."; }
    }
    dependency currentMission from current to GorgeChallenge::transGorgeChallenge;
    dependency futureMission from future to BlueDog::Goals::hawaiiVoyage;
}

package GorgeChallenge {
    doc /* Independent trans-gorge autonomous sailing challenge.
     * Inspired by the structure of the Microtransat rules:
     * https://microtransat.org/content.php?p=rules&top=rules
     * This is a separate project challenge, not a Microtransat entry or endorsement.
     * Vessel architecture and communications technology are unrestricted; overall length is limited to 1.2 m.
     * The Gorge is the proving ground for a longer-term voyage toward Hawaii.
     * Marker-referenced virtual gates are defined in TransGorgeCourse.
     * There is no completion deadline. The vehicle defines candidate environmental qualification profiles; no dam passage is permitted.
     */
    private import RequirementDerivation::*;
    private import ISQ::*;
    private import SI::*;
    attribute maximumOverallLength : LengthValue = 1.2 [m];
    requirement def <'C-000'> TransGorgeChallenge {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall complete the Trans-Gorge challenge under C-001, C-003 through C-010 and C-012 through C-027.*/
        metadata rationale : ModelingMetadata::Rationale { text = "One Bingen–Stevenson–Bingen circuit defines the finite challenge. Repeated circuits are a separate future endurance objective."; }
    }
    requirement transGorgeChallenge : TransGorgeChallenge;
    requirement def <'C-001'> CourseCompletion {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall cross the configured Bingen departure, buoy 16 rounding checkpoints and Bingen finish gates in order during one attempt. */
        comment conditions /* TransGorgeCourse defines nominal marker references and directed finite gate segments. Completion has no elapsed-time deadline. Position history must demonstrate crossings; touching a gate line alone does not count. */
        metadata issue : ModelingMetadata::Issue { text = "The marker-based gate proposal remains subject to the course safety review before launch; route corridor and current notice exclusions must accompany the accepted configuration."; }
    }
    requirement def <'C-002'> RepeatedOperation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* After its first circuit, the vessel should repeat Bingen–Stevenson–Bingen autonomously for as long as practical. */
        comment notes /* Future endurance objective, excluded from finite challenge acceptance. */
        metadata issue : ModelingMetadata::Issue { text = "No fixed objective endurance duration has been selected."; }
    }
    requirement def <'C-003'> UnassistedAttempt {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* A qualifying attempt shall complete the round trip without operator intervention. */
        comment conditions /* Passive live monitoring and autonomous polling of weather services are permitted. Any operator-supplied update, remote emergency abort or manual control ends qualification. Weather data must be obtained by the system without manual operator submission. */
        comment restartConditions /* After intervention, a new qualifying attempt begins only with a new downstream crossing of the departure gate. Previous partial progress does not transfer. */
    }
    requirement def <'C-004'> SailingPropulsion {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* A qualifying attempt shall use sailing propulsion without auxiliary motor propulsion. */
        comment conditions /* An auxiliary motor may remain installed. Motor use is permitted during separate development tests and vessel recovery; use during an attempt ends its qualification. */
        comment notes /* The restriction concerns propulsion, not onboard electrical power. */
    }
    requirement def <'C-005'> LiveObservation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall deliver position, operating mode and health updates at intervals no greater than 30 seconds while the monitoring link is available. */
        comment conditions /* C-020 governs autonomous continuation, retention and telemetry replay during monitoring-link outages. */
        metadata issue : ModelingMetadata::Issue { text = "LTE-M-class throughput is a provisional vehicle design assumption, not a mandated challenge technology. End-to-end delivery qualification and stale-data presentation are allocated to the vehicle."; }
    }
    requirement def <'C-006'> EmergencyIntervention {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall permit remote emergency abort or manual control when a command link is available. */
        comment conditions /* Use disqualifies the attempt as unassisted. */
        metadata issue : ModelingMetadata::Issue { text = "Owner-approved policy: autonomous safety abort does not wait for operator contact. Recovery may use motor propulsion; operator-directed relocation or motor-sailing after abort never restores qualification."; }
    }
    requirement courseCompletion : CourseCompletion;
    requirement repeatedOperation : RepeatedOperation;
    requirement unassistedAttempt : UnassistedAttempt;
    requirement sailingPropulsion : SailingPropulsion;
    requirement liveObservation : LiveObservation;
    requirement emergencyIntervention : EmergencyIntervention;
    requirement def <'C-007'> NavigationRules {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall comply with the U.S. Inland Navigation Rules (33 CFR parts 83 through 90) and applicable local navigation provisions throughout the attempt on the approved Gorge course.*/
        comment conditions /* Evaluate the actual encounter and visibility conditions, including lookout, collision-risk assessment, avoidance action, safe speed, overtaking, sailing encounters and narrow-channel obligations. A safety action takes precedence over preserving attempt qualification. */
        metadata rationale : ModelingMetadata::Rationale { text = "USCG Navigation Rules: https://www.navcen.uscg.gov/navigation-rules-amalgamated . Detailed encounter cases and quantitative acceptance allocations belong to the vehicle analysis, not the independent challenge. Small size and sail propulsion do not exempt the vessel from collision avoidance or channel non-impediment."; }
        comment processResponsibilities /* C-028 identifies entrant applicability review; C-029 controls the organizer rule and notice baseline; C-030 governs entry evidence; C-031 identifies operator safety intervention; C-032 governs adjudication. These preserve the C-007 entry and qualification policy. */
        comment complianceSources /* Governing source: https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E . Applicability: https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-A/section-83.01 . Source-linked verification cases in GorgeChallengeVerification cover applicability, lookout/avoidance, encounter conduct, channel/visibility and signals. Their verdicts remain inconclusive pending accepted evidence; traceability is not a compliance finding.*/
    }
    requirement def <'C-008'> RestrictedWaters {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall remain outside waters prohibited to the attempt configuration. */
        comment conditions /* Include dam restricted areas, lock approaches excluded by the challenge, and applicable temporary safety/security zones or closures. Use the chart and notice set applicable to the attempt. */
        metadata rationale : ModelingMetadata::Rationale { text = "33 CFR 207.718 defines site-specific dam restrictions and lock-approach authority: https://www.ecfr.gov/current/title-33/chapter-II/part-207/section-207.718 . The course stays between the dams and requires no lock passage. Do not replace mapped restrictions with an invented universal stand-off radius."; }
    }
    requirement def <'C-009'> TrafficCoexistence {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall complete the course without collision with other waterway users. */
        comment conditions /* The operating context includes commercial tows, passenger vessels, fishing craft, recreational powerboats, sailing vessels and people in the water. Channel non-impediment and encounter conduct remain independently required by C-007. The vehicle analysis defines representative and adverse traffic scenarios and assesses maneuver feasibility. */
        metadata rationale : ModelingMetadata::Rationale { text = "The course is shared water, not a closed test range. Typical traffic and uncertainty in other users' behavior are part of mission validation; AIS absence is not evidence of clear water. Numeric separation allocations must be justified by encounter geometry and vessel performance."; }
    }
    requirement navigationRules : NavigationRules;
    requirement restrictedWaters : RestrictedWaters;
    requirement trafficCoexistence : TrafficCoexistence;
    #derivation connection challengeNavigationRules {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata rationale : ModelingMetadata::Rationale { text = "C-000 includes this obligation independently of course progress or elapsed time."; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> navigationRules;
    }
    #derivation connection challengeRestrictedWaters {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata rationale : ModelingMetadata::Rationale { text = "C-000 includes this obligation independently of course progress or elapsed time."; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> restrictedWaters;
    }
    #derivation connection challengeTrafficCoexistence {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata rationale : ModelingMetadata::Rationale { text = "C-000 includes this obligation independently of course progress or elapsed time."; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> trafficCoexistence;
    }
    #derivation connection challengeRuleCourseCompletion {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> courseCompletion;
    }
    dependency futureEnduranceBasis from repeatedOperation to courseCompletion {
        metadata rationale : ModelingMetadata::Rationale { text = "Future repeated operation uses the same ordered course geometry. This design dependency does not impose repeating endurance on the current finite qualification mission."; }
    }
    #derivation connection challengeRuleUnassistedAttempt {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> unassistedAttempt;
    }
    #derivation connection challengeRuleSailingPropulsion {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> sailingPropulsion;
    }
    #derivation connection challengeRuleLiveObservation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> liveObservation;
    }
    #derivation connection challengeRuleEmergencyIntervention {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> emergencyIntervention;
    }
    requirement def <'C-010'> OverallLength {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel overall length shall not exceed 1.2 m. */
        attribute measuredOverallLength : LengthValue;
        require constraint lengthLimit { measuredOverallLength > 0 [m] and measuredOverallLength <= maximumOverallLength }
        comment conditions /* Measure maximum fore-and-aft extent, including rudders, rig projections, antennas and other equipment, across normal operating configurations. Hull arrangement is unrestricted. */
        metadata rationale : ModelingMetadata::Rationale { text = "Half the Microtransat 2.4 m overall-length entry limit; owner-selected challenge constraint."; }
    }
    requirement overallLength : OverallLength;
    #derivation connection deriveOverallLength {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> overallLength;
    }
    requirement def <'C-012'> SafetyCapabilityAbort {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall autonomously terminate qualification when a required safety capability is lost. */
        comment conditions /* A demonstrated backup preserving the function permits continuation. Darkness alone is not a fault. Fog triggers this rule when it compromises required capability. */
        metadata rationale : ModelingMetadata::Rationale { text = "Abort is based on capability, not individual component failure."; }
    }
    requirement safetyCapabilityAbort : SafetyCapabilityAbort;
    #derivation connection deriveSafetyCapabilityAbort {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> safetyCapabilityAbort;
    }
    requirement def <'C-013'> AutonomousShoreRecovery {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* Following a safety abort, the vessel shall autonomously initiate recovery toward a suitable shore-accessible retrieval location. */
        comment conditions /* Do not wait for operator intervention or communications. Select a viable route based on remaining capabilities. Intentional grounding at a suitable accessible shore is permitted. */
        metadata rationale : ModelingMetadata::Rationale { text = "Owner-selected recovery policy; residual risk of movement after traffic-sensing failure requires explicit analysis and review, not assumed acceptance."; }
    }
    requirement autonomousShoreRecovery : AutonomousShoreRecovery;
    #derivation connection deriveAutonomousShoreRecovery {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> autonomousShoreRecovery;
    }
    requirement def <'C-014'> AbortAlert {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall attempt immediate transmission of an abort alert when an abort is declared. */
        comment conditions /* Queue the alert while communications are unavailable and transmit when contact returns. */
        metadata rationale : ModelingMetadata::Rationale { text = "Operator awareness supports shore retrieval without being a prerequisite for recovery."; }
    }
    requirement abortAlert : AbortAlert;
    #derivation connection deriveAbortAlert {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> abortAlert;
    }
    requirement def <'C-015'> NoLittering {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall support recovery without abandonment of the vessel or its major components in the waterway. */
        comment conditions /* Apply flotation, retention and post-capsize recovery obligations C-016 through C-018. */
        metadata rationale : ModelingMetadata::Rationale { text = "Owner intent: no littering. This is a recoverability obligation, not a guarantee against every conceivable casualty."; }
    }
    requirement noLittering : NoLittering;
    #derivation connection deriveNoLittering {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> noLittering;
    }
    requirement def <'C-016'> CasualtyFlotation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall remain afloat following capsize or hull flooding. */
        comment conditions /* Demonstrate in the declared casualty qualification conditions for the interval needed to execute shore recovery. */
        metadata rationale : ModelingMetadata::Rationale { text = "Derived from recoverability; casualty definition and exposure allocations require SRR review."; }
    }
    requirement casualtyFlotation : CasualtyFlotation;
    #derivation connection deriveCasualtyFlotation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> noLittering;
        end #derive target ::> casualtyFlotation;
    }
    requirement def <'C-017'> MajorComponentRetention {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall retain its rig, ballast and battery following capsize or hull flooding. */
        comment conditions /* Use the same casualty qualification conditions as C-016. */
        metadata rationale : ModelingMetadata::Rationale { text = "Retained major components prevent debris and support retrieval."; }
    }
    requirement majorComponentRetention : MajorComponentRetention;
    #derivation connection deriveMajorComponentRetention {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> noLittering;
        end #derive target ::> majorComponentRetention;
    }
    requirement def <'C-018'> CapsizeRecovery {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall demonstrate autonomous travel to a suitable shore retrieval location following capsize without communications. */
        comment conditions /* Self-righting is not prescribed; inverted recovery is permitted. Auxiliary propulsion ends qualification. Demonstrate against declared course recovery conditions. */
        metadata rationale : ModelingMetadata::Rationale { text = "Limp recovery is the required outcome; hull architecture remains open."; }
    }
    requirement capsizeRecovery : CapsizeRecovery;
    #derivation connection deriveCapsizeRecovery {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> noLittering;
        end #derive target ::> capsizeRecovery;
    }
    requirement def <'C-019'> UnattachedPassage {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* A qualifying attempt shall remain afloat and unattached throughout the scored passage. */
        comment conditions /* Grounding, anchoring, attaching to shore or entering designated refuge ends qualification. Safe waiting under sail is permitted and counts toward elapsed exposure. */
        metadata rationale : ModelingMetadata::Rationale { text = "Refuge does not preserve partial qualifying progress."; }
    }
    requirement unattachedPassage : UnattachedPassage;
    #derivation connection deriveUnattachedPassage {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> unattachedPassage;
    }
    requirement def <'C-020'> OutageAutonomy {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* Loss of communications alone shall not terminate an otherwise safe qualifying attempt. */
        comment conditions /* Continue navigation and retain telemetry onboard; replay retained data after reconnection. */
        metadata rationale : ModelingMetadata::Rationale { text = "Onboard safety and recovery do not depend on contact."; }
    }
    requirement communicationOutageAutonomy : OutageAutonomy;
    #derivation connection deriveOutageAutonomy {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> communicationOutageAutonomy;
    }
    requirement def <'C-021'> ForecastAdmission {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* Launch authorization shall require a forecast window assessed to support the complete round trip with waiting and recovery margins. */
        comment conditions /* Use the declared mission configuration and forecast-conditioned scenarios. No fixed completion deadline applies. */
        metadata rationale : ModelingMetadata::Rationale { text = "Whole-mission assessment replaces an arbitrary sailing-speed floor."; }
    }
    requirement forecastAdmission : ForecastAdmission;
    #derivation connection deriveForecastAdmission {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> forecastAdmission;
    }
    requirement def <'C-022'> WeatherOutageContinuation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall permit continued qualification during weather-service outage only while the last forecast remains applicable and required safety capabilities remain available. */
        comment conditions /* Forecast applicability must cover remaining passage and recovery options; assess against observations. */
        metadata rationale : ModelingMetadata::Rationale { text = "Loss of data access alone is not an abort trigger."; }
    }
    requirement weatherOutageContinuation : WeatherOutageContinuation;
    #derivation connection deriveWeatherOutageContinuation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> weatherOutageContinuation;
    }
    requirement def <'C-023'> CourseRecoveryReserve {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall protect sufficient energy to reach a suitable shore retrieval location from its current course position. */
        comment conditions /* Account for adverse current, essential onboard loads and uncertainty along the recovery route. No fixed motor-runtime reserve is substituted for route analysis. */
        metadata rationale : ModelingMetadata::Rationale { text = "Reserve follows the course and available recovery destinations."; }
    }
    requirement courseRecoveryReserve : CourseRecoveryReserve;
    #derivation connection deriveCourseRecoveryReserve {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> courseRecoveryReserve;
    }
    requirement def <'C-024'> ReserveAbort {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall initiate autonomous recovery before further mission continuation would compromise the course-dependent recovery reserve. */
        comment conditions /* Include the decision and maneuver margin needed to enter recovery. */
        metadata rationale : ModelingMetadata::Rationale { text = "Protecting reserve requires timely action, not only energy monitoring."; }
    }
    requirement reserveAbort : ReserveAbort;
    #derivation connection deriveReserveAbort {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> reserveAbort;
    }
    requirement def <'C-025'> NightOperation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall support qualifying operation in darkness. */
        comment conditions /* Required navigation, traffic safety and observation functions remain applicable. Nightfall alone does not require refuge. */
        metadata rationale : ModelingMetadata::Rationale { text = "Passage duration is uncertain and may include overnight sailing."; }
    }
    requirement nightOperation : NightOperation;
    #derivation connection deriveNightOperation {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> nightOperation;
    }
    requirement def <'C-026'> AbortPersistence {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* An aborted attempt shall remain disqualified until a new attempt begins at the departure gate. */
        comment conditions /* No autonomous resumption from refuge. Operator-commanded relocation is permitted outside qualification. */
        metadata rationale : ModelingMetadata::Rationale { text = "Recovery cannot silently resume a partial challenge."; }
    }
    requirement abortPersistence : AbortPersistence;
    #derivation connection deriveAbortPersistence {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> abortPersistence;
    }
    requirement def <'C-027'> RecoveryConspicuity {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        doc /* The vessel shall present conspicuous recovery indications during autonomous shore recovery. */
        comment conditions /* Allocate indications consistently with applicable navigation signals; no light or sound configuration is prescribed here. */
        metadata rationale : ModelingMetadata::Rationale { text = "Prompt recovery and operator alerts do not replace visibility to other users."; }
    }
    requirement recoveryConspicuity : RecoveryConspicuity;
    #derivation connection deriveRecoveryConspicuity {
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
        end #original source ::> transGorgeChallenge;
        end #derive target ::> recoveryConspicuity;
    }
    comment trafficCourtesyGuidance /* Entrants are encouraged to choose routes and operating windows that reduce encounters with other waterway users. This is nonbinding guidance, not an entry or adjudication criterion. Another vessel changing course or speed is not by itself a breach. Navigation-rule compliance, applicable nonimpediment duties and collision avoidance remain governed by C-007 and C-009.*/
    requirement def <'C-028'> NavigationRuleApplicability {
        doc /* Before entry approval, the entrant shall submit a configuration-specific navigation-rule applicability assessment. */
        comment conditions /* Before entry approval, the entrant shall submit a rule-applicability assessment for the identified vessel, propulsion modes, course and operating conditions. Identify the governing provisions and current local restrictions, required lights/shapes/sound signals, applicable exceptions and supporting authority. */
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
    }
    requirement navigationRuleApplicability : NavigationRuleApplicability;
    dependency navigationRuleApplicabilityBasis from navigationRuleApplicability to navigationRules;
    requirement def <'C-029'> NavigationRuleBaseline {
        doc /* The organizer shall record and maintain the reviewed rule and notice baseline for the attempt. */
        comment conditions /* The organizer shall record the reviewed rule and notice baseline; later effective changes shall be reviewed before launch. */
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
    }
    requirement navigationRuleBaseline : NavigationRuleBaseline;
    dependency navigationRuleBaselineBasis from navigationRuleBaseline to navigationRules;
    requirement def <'C-030'> NavigationEntryEvidence {
        doc /* The organizer shall approve entry only when the configuration-specific navigation evidence satisfies the entry-evidence conditions. */
        comment conditions /* Entry approval shall require organizer acceptance of configuration-specific evidence covering relevant sailing, overtaking, crossing and constrained-water encounters, uncertain classification, restricted visibility, degraded sensing and safety intervention. Record assumptions, observation and maneuver limits, pass/fail criteria, physical demonstrations, simulation coverage and remaining exclusions. Unsupported conditions shall be excluded from admission; unresolved capability within admitted conditions prevents entry approval. Entrants shall justify detection distances, margins and maneuver capability. Passing a limited software rule subset does not establish compliance with C-007. */
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
    }
    requirement navigationEntryEvidence : NavigationEntryEvidence;
    dependency navigationEntryEvidenceBasis from navigationEntryEvidence to navigationRules;
    requirement def <'C-031'> OperatorSafetyIntervention {
        doc /* The operator shall intervene when necessary if autonomous safety action is insufficient and intervention is available. */
        comment conditions /* Safety action shall not be delayed to preserve qualification. Operator intervention or motor propulsion ends qualification under C-003/C-004 even when it prevents a violation. */
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
    }
    requirement operatorSafetyIntervention : OperatorSafetyIntervention;
    dependency operatorSafetyInterventionBasis from operatorSafetyIntervention to navigationRules;
    requirement def <'C-032'> NavigationAdjudication {
        doc /* The organizer shall record the attempt qualification decision and its supporting reason against the navigation adjudication conditions. */
        comment conditions /* A collision, established navigation-rule breach or unsafe conduct requiring safety intervention disqualifies the attempt. Safety action shall not be delayed to preserve qualification, and the operator shall intervene when necessary if autonomous action is insufficient and intervention is available. Operator intervention or motor propulsion ends qualification under C-003/C-004 even when it prevents a violation. A compliant autonomous avoidance maneuver does not by itself end qualification. The organizer shall adjudicate using retained observations, commands, motion history and independent evidence where available, with a recorded reason. Insufficient evidence leaves qualification unconfirmed; absence of collision alone is not proof of compliance. Entry approval does not waive ongoing obligations. */
        metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
    }
    requirement navigationAdjudication : NavigationAdjudication;
    dependency navigationAdjudicationBasis from navigationAdjudication to navigationRules;

}

package GorgeChallengeVerification {
    doc /* Planned qualification cases, not completed evidence. Virtual regression checks and physical demonstrations are separate evidence streams. */
    verification def OverallLengthVerification {
        metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Inspect and measure the maximum fore-and-aft extent through all normal rig, steering and equipment configurations. Apply the executable lengthLimit constraint with recorded measurement uncertainty; confirm no unmeasured projection extends beyond the reported envelope. */
        objective acceptance { verify GorgeChallenge::overallLength; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def SafetyCapabilityAbortVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* Inject loss of required safety functions, including visibility-driven loss and common-cause faults. Confirm qualification terminates when the function is unavailable; demonstrate continued qualification only when an accepted backup maintains that function. */
        objective acceptance { verify GorgeChallenge::safetyCapabilityAbort; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def AutonomousShoreRecoveryVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* From declared course locations and casualty states, remove communications and trigger safety abort. Record recovery initiation, chosen accessible destination, transit and final approach. Assess impaired-sensing collision exposure and consequences independently; a successful transit alone does not accept that residual risk. */
        objective acceptance { verify GorgeChallenge::autonomousShoreRecovery; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def AbortAlertVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* Trigger abort with available and unavailable links. Observe immediate transmission attempts with a link, durable queueing without a link and delivery after reconnection. Timing implementation tolerance must be declared before qualification. */
        objective acceptance { verify GorgeChallenge::abortAlert; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def NoLitteringVerification {
        metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Review and demonstrate the linked flotation, major-component retention and capsize recovery cases using the same casualty configuration. Account for every major component at retrieval. */
        objective acceptance { verify GorgeChallenge::noLittering; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def CasualtyFlotationVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* Execute the approved flooding and capsize exposure cases with maximum mission load. Observe flotation throughout the course-derived recovery duration. A short static float test cannot substantiate a longer recovery exposure. */
        objective acceptance { verify GorgeChallenge::casualtyFlotation; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def MajorComponentRetentionVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
        doc /* Inspect rig, ballast and battery retention before and after the same flooding and capsize cases used for flotation. Record attachments and any released debris. */
        objective acceptance { verify GorgeChallenge::majorComponentRetention; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def CapsizeRecoveryVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* Release the vessel in the declared capsize orientations with communications disabled and execute shore recovery under the approved current, wind and wave profile. Observe arrival at a retrievable location; remaining inverted is allowed. Motor use must disqualify the attempt. */
        objective acceptance { verify GorgeChallenge::capsizeRecovery; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def UnattachedPassageVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Review timestamped passage records and inject grounding, anchoring, shore attachment and refuge entry. Each ends qualification; safe afloat waiting does not. Missing evidence prevents an affirmative qualification verdict. */
        objective acceptance { verify GorgeChallenge::unattachedPassage; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def OutageAutonomyVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* Interrupt communications during healthy passage and verify continued autonomous operation, retained observations and backlog delivery. Separately inject a safety failure during the outage to ensure loss of contact does not inhibit recovery. */
        objective acceptance { verify GorgeChallenge::communicationOutageAutonomy; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def ForecastAdmissionVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Exercise forecast-conditioned launch scenarios covering full passage, waiting and recovery exposure. Reject missing or insufficient forecast coverage. Evaluate the frozen Monte Carlo ensemble and explicit edge cases without treating sample completion fraction as calibrated real-world probability. */
        objective acceptance { verify GorgeChallenge::forecastAdmission; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def WeatherOutageContinuationVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* Interrupt weather access with applicable and expired forecasts; independently vary onboard safety capability. Confirm continuation requires both applicable forecast information and preserved safety capability. */
        objective acceptance { verify GorgeChallenge::weatherOutageContinuation; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def CourseRecoveryReserveVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Evaluate route-dependent reserve along the course using installed load evidence, adverse currents, route feasibility and uncertainty. An inaccessible shore, infeasible route or missing input cannot establish a protected reserve. */
        objective acceptance { verify GorgeChallenge::courseRecoveryReserve; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def ReserveAbortVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Inject declining energy and increasing recovery demand along the route. Confirm recovery begins with sufficient reserve for the decision delay, transition and transit rather than only after reserve exhaustion. */
        objective acceptance { verify GorgeChallenge::reserveAbort; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def NightOperationVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* Exercise the declared navigation, traffic, communications and recovery scenarios in darkness. Confirm nightfall alone does not terminate qualification. Simulation cannot close optical sensing or navigation-light physical evidence. */
        objective acceptance { verify GorgeChallenge::nightOperation; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def AbortPersistenceVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* After abort, test reboot, contact restoration, refuge departure and operator relocation. Qualification remains ended until the new attempt departure-gate condition is met; partial progress is not carried forward. */
        objective acceptance { verify GorgeChallenge::abortPersistence; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def RecoveryConspicuityVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
        doc /* Inspect and test recovery indications against the deployment-specific navigation-signal matrix in the approved visibility conditions, including the casualty states for which recovery is claimed. */
        objective acceptance { verify GorgeChallenge::recoveryConspicuity; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def WindSportEncounterVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Exercise BlueDogLocationTraffic windsurfCrossing, wingfoilTurn, kiteSweep, fallenRider and groupEncounter across both tacks, overtaking, unknown tack, glare, waves and darkness. Independently record rider/equipment extent, timing, swept-volume clearance and navigation obligations. Include timely, delayed and absent rider avoidance, falls, track swaps and no feasible sailing response. Scripted planar targets or cooperative passes cannot close these cases.*/
        objective acceptance {
            verify GorgeChallenge::trafficCoexistence;
            verify GorgeChallenge::navigationRules;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def LocationTrafficAdmissionVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Exercise BlueDogLocationTraffic windowOverrun and WindowAssessment for surveyed sectors and background reaches on both legs, waiting and recovery. Reject missing traffic evidence, unsupported wind/daylight conditions, incomplete coverage and intervals outside reviewed windows. Compare cumulative exposure, energy, sensing and recovery before departure. Sparse heatmaps and zero observed users cannot establish absence. Reassess delays and unexpected traffic; no accepted window yet.*/
        objective acceptance {
            verify GorgeChallenge::forecastAdmission;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def NavigationRulesEntryAndAdjudicationVerification {
        metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Planned case; no completed compliance evidence. Review entry applicability, current rule/notice baseline, installed observation and maneuver evidence, controlled demonstrations and simulation limitations against predeclared criteria. Reject unsupported admitted conditions. Replay compliant autonomous avoidance, no-contact rule breach, collision, operator intervention, motor-assisted safety action and insufficient evidence; confirm their distinct qualification outcomes. Record configuration, conditions, reviewer, evidence and rationale. Do not stage hazardous encounters with uninvolved users.*/
        objective acceptance {
            verify GorgeChallenge::navigationRules;
            verify GorgeChallenge::navigationRuleApplicability;
            verify GorgeChallenge::navigationRuleBaseline;
            verify GorgeChallenge::navigationEntryEvidence;
            verify GorgeChallenge::operatorSafetyIntervention;
            verify GorgeChallenge::navigationAdjudication;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def InlandApplicabilityVerification {
        metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Planned case; no completed compliance evidence. Sources: Rules 1-3, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-A . Review jurisdiction, vessel classification, sailing/powered/casualty modes, responsibility, local provisions and authority for exceptions. Record applicability dispositions; no blanket small-vessel or autonomous exemption.*/
        objective acceptance {
            verify GorgeChallenge::navigationRules;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def InlandLookoutAndAvoidanceVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Planned case; no completed compliance evidence. Sources: Rules 5-8, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-B . Demonstrate installed lookout, safe speed, risk appraisal and effective avoidance under admitted conditions, including uncertain and missed tracks. Independently observe early/substantial action and effectiveness. No-contact outcome alone is insufficient.*/
        objective acceptance {
            verify GorgeChallenge::navigationRules;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def InlandEncounterConductVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Planned case; no completed compliance evidence. Sources: Rules 11-18, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-B . Review applicability and demonstrate sailing, overtaking, crossing/head-on where relevant, give-way and stand-on escalation, unknown tack and exceptional status. Retain overtaking duty until past and clear. Distinguish permission from mandatory action; a subset does not verify omitted rules.*/
        objective acceptance {
            verify GorgeChallenge::navigationRules;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def InlandChannelAndVisibilityVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Planned case; no completed compliance evidence. Sources: Rules 9, 10 and 19, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-B . Review channel confinement, nonimpediment, crossings, applicable traffic separation and restricted visibility. Exercise simultaneous pairwise/channel duties. Record applicability or justified exclusions, operating limits and response to deteriorating visibility. In-sight logic does not verify nonvisual encounters.*/
        objective acceptance {
            verify GorgeChallenge::navigationRules;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def InlandSignalsVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
        doc /* Planned case; no completed compliance evidence. Sources: Rules 20-37 and applicable annexes, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E . Review lights, shapes and sound signals for sailing, powered recovery and casualty modes. Demonstrate required equipment performance and signal behavior under admitted conditions. Record authority for alternatives; review distress signaling and applicable exemptions separately.*/
        objective acceptance {
            verify GorgeChallenge::navigationRules;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def PassageQualificationVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Review the approved course, configuration and predeclared admission evidence, then independently reconstruct the ordered finite gate crossings and complete attempt history. Exercise skipped/reversed/touched gates, operator updates, motor thrust, grounding and restart. A complete circuit is insufficient when another governing challenge obligation failed or evidence is missing. Safe unassisted righting preserves qualification only with required safety capability; recovery after disqualification cannot transfer partial progress into a new attempt. Accept C-000 only after every applicable C-001, C-003 through C-010 and C-012 through C-027 obligation has its own accepted evidence or justified coverage in the same attempt. */
        objective acceptance {
            verify GorgeChallenge::transGorgeChallenge;
            verify GorgeChallenge::courseCompletion;
            verify GorgeChallenge::unassistedAttempt;
            verify GorgeChallenge::sailingPropulsion;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def ObservationAndInterventionVerification {
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        doc /* Measure acquisition-to-shore delivery under an available link, including current position, operating mode and health. Interrupt and restore the link; inspect durable backlog replay and continued autonomous control. Exercise authenticated emergency abort and manual-control commands with independent observation of the commanded response and persistent disqualification. Passive monitoring must not change mission state. Distinguish an unavailable link from a failed delivery on an available link. The demonstration must cover the installed vessel and shore endpoints; software queue tests alone do not establish communication service. */
        objective acceptance {
            verify GorgeChallenge::liveObservation;
            verify GorgeChallenge::emergencyIntervention;
        }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
    verification def RestrictedWatersVerification {
        metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
        metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
        metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
        doc /* Review the applicable chart, dam and lock exclusions, local restrictions and current notice baseline for the configured course. Independently compare the complete observed vessel envelope and position uncertainty against approved exclusion geometry throughout the attempt. Exercise approach, navigation-loss and no-feasible-maneuver cases in a controlled test or simulation; do not enter prohibited waters to test the response. A route-planner clearance result is supporting analysis, not evidence that actual operation remained outside restrictions. */
        objective acceptance { verify GorgeChallenge::restrictedWaters; }
        return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
    }
}

package BlueDogSatisfaction {
    private import BlueDogRequirements::*;
    private import BlueDog::Architecture::missionContext;
    doc /* Candidate design satisfaction assertions, not verification evidence. Physical
     * implementation, quantitative acceptance, and verification remain open.
     * Regulatory classification is a project process obligation, not assigned
     * to a component as though hardware alone could establish authorization.
     */
