    satisfy BlueDogRequirements::avoidanceCommandDeadline by BlueDogLogicalArchitecture::vessel.collision;
    satisfy BlueDogRequirements::trafficAwarenessFault by BlueDogLogicalArchitecture::vessel.collision;
    satisfy BlueDogRequirements::boundaryEvaluationCadence by BlueDogLogicalArchitecture::vessel.boundary;
    satisfy BlueDogRequirements::boundaryAvoidanceDeadline by BlueDogLogicalArchitecture::vessel.boundary;
    satisfy BlueDogRequirements::boundaryAvoidanceRecording by BlueDogLogicalArchitecture::vessel.recording;
    satisfy BlueDogRequirements::boundaryStartInhibition by BlueDogLogicalArchitecture::vessel.boundary;
